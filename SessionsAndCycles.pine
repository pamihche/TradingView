//@version=6
indicator("Sessions & Cycles", shorttitle="Sessions & Cycles", overlay=true, max_boxes_count = 500, max_lines_count = 500)

// ---------------------------------------- Constants --------------------------------------------------
const string TIMEZONE = "America/New_York"
const string TRADING_DAY_START = "1800-1801"

// --- Session Time Constants ---
const int ASIA_START_HOUR   = 18
const int ASIA_START_MIN    = 0
const string ASIA_SESSION_DEF   = "1800-0230"
const int ASIA_END_HOUR     = 2

const int LONDON_START_HOUR = 2
const int LONDON_START_MIN  = 30
const string LONDON_SESSION_DEF = "0230-0700"
const int LONDON_END_HOUR   = 7

const int NY_AM_START_HOUR  = 7
const int NY_AM_START_MIN   = 0
const string NY_AM_SESSION_DEF  = "0700-1130"
const int NY_AM_END_HOUR    = 11

const int NY_PM_START_HOUR  = 11
const int NY_PM_START_MIN   = 30
const string NY_PM_SESSION_DEF  = "1130-1600"
const int NY_PM_END_HOUR    = 16
const int NY_PM_END_MIN     = 0
const int NY_PM_DAY_OFFSET  = 0
const int ASIA_END_MIN      = 30
const int ASIA_DAY_OFFSET   = 1

const int LONDON_END_MIN    = 0
const int LONDON_DAY_OFFSET = 0

const int NY_AM_END_MIN     = 30
const int NY_AM_DAY_OFFSET  = 0


// ---------------------------------------- Data Structures --------------------------------------------------
// Type to hold the high/low data for a single cycle
type CycleData
    float high = na
    float low = na
    int high_bar_index = na
    int low_bar_index = na
    int start_time = na
    int end_time = na

// Map to store the data for all completed 90m cycles
var map<string, CycleData> g_cycle_data_map = map.new<string, CycleData>()

// Type to hold the high/low data for a single main session
type SessionData
    float high = na
    float low = na
    int start_time = na
    int end_time = na
    int high_bar_index = na
    int low_bar_index = na

// Map to store the data for all completed main sessions
var map<string, SessionData> g_session_data_map = map.new<string, SessionData>()

// Global state for the daily high/low tracking
var g_daily_hl_prices = array.new_float(2, na)
var g_daily_lines = array.new_line(2, na)
var g_daily_labels = array.new_label(2, na)

// State arrays to manage the tracking of the 4 main sessions independently
var g_main_session_high_vals = array.new_float(4, na)
var g_main_session_low_vals = array.new_float(4, na)
var g_main_session_start_time_vals = array.new_int(4, na)
var g_main_session_high_time_vals = array.new_int(4, na)
var g_main_session_low_time_vals = array.new_int(4, na)

// Arrays to hold the IDs of the drawn high/low lines and labels for future deletion
var g_high_lines = array.new_line(4, na)
var g_low_lines = array.new_line(4, na)
var g_high_labels = array.new_label(4, na)
var g_low_labels = array.new_label(4, na)


// Arrays to hold the IDs of the drawn marker boxes for the main sessions
var g_main_session_high_marker_boxes = array.new_box(4, na)
var g_main_session_low_marker_boxes = array.new_box(4, na)
var g_main_session_high_midlines = array.new_line(4, na)
var g_main_session_low_midlines = array.new_line(4, na)


// State arrays to manage the tracking of the 5 Asia sub-cycles independently
var g_high_vals = array.new_float(14, na)
var g_low_vals = array.new_float(14, na)
var g_high_bar_index_vals = array.new_int(14, na)
var g_low_bar_index_vals = array.new_int(14, na)
var g_start_time_vals = array.new_int(14, na)

// Arrays to hold the IDs of the drawn marker boxes for future deletion
var g_high_marker_boxes = array.new_box(14, na)
var g_low_marker_boxes = array.new_box(14, na)
var g_high_midline_ids = array.new_line(14, na)
var g_low_midline_ids = array.new_line(14, na)


// ---------------------------------------- Inputs --------------------------------------------------
var g_SETTINGS      = "Settings"
string tf_limit_str = input.string("15", "Timeframe Limit", options = ["1", "2", "3", "5", "15"], tooltip = "Drawings will not appear on timeframes greater than this.", group = g_SETTINGS)

var g_DAY_LINE      = "Trading Day Start Line"
show_day_line       = input.bool(true, "Show Line at 18:00", group = g_DAY_LINE)
day_line_color      = input.color(color.new(color.blue, 40), "Color", inline = "TDL", group = g_DAY_LINE)
day_line_style      = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], inline = "TDL", group = g_DAY_LINE)
day_line_width      = input.int(2, "Width", minval = 1, maxval = 5, inline = "TDL", group = g_DAY_LINE)

var g_SESSIONS      = "Main Sessions"
show_sessions       = input.bool(true, "Show Main Sessions", group = g_SESSIONS)

// --- Session Headers ---
var g_HEADERS       = "Session Headers"
show_headers        = input.bool(true, "Show Session Name Headers", group = g_HEADERS)
header_offset_ticks = input.int(10, "Header Offset (in Ticks)", minval=0, group = g_HEADERS, tooltip="The gap between the daily high and the bottom of the header boxes.")
header_height_ticks = input.int(20, "Header Height (in Ticks)", minval=1, group = g_HEADERS, tooltip="Controls the height of the session header box, specified in the number of ticks for the current instrument.")
header_text_size_str= input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group = g_HEADERS)
header_bg_color     = input.color(color.new(color.gray, 80), "Background", group = g_HEADERS)
header_border_color = input.color(color.new(color.black, 50), "Border Color", group = g_HEADERS)
header_text_color   = input.color(color.new(color.white, 0), "Text", group = g_HEADERS)

// --- Asia Styling ---
var g_ASIA_STYLE    = "Asia Styling"
use_asia            = input.bool(true, "Show Asia Session", group = g_ASIA_STYLE)
as_box_color        = input.color(color.new(color.purple, 85), "Main Box", inline = "AS1", group = g_ASIA_STYLE)
as_90a_color        = input.color(color.new(color.blue, 90), "90m A", inline = "AS2", group = g_ASIA_STYLE)
as_90b_color        = input.color(color.new(color.green, 90), "90m B", inline = "AS2", group = g_ASIA_STYLE)
as_30_color         = input.color(color.new(color.gray, 92), "30m", inline = "AS2", group = g_ASIA_STYLE)
as_subcycles        = input.string("None", "Sub-Cycles", options = ["None", "90 Minutes", "90 AND 30 minutes"], group = g_ASIA_STYLE)

// --- London Styling ---
var g_LONDON_STYLE  = "London Styling"
use_london          = input.bool(true, "Show London Session", group = g_LONDON_STYLE)
lo_box_color        = input.color(color.new(color.orange, 85), "Main Box", inline = "LS1", group = g_LONDON_STYLE)
lo_90a_color        = input.color(color.new(color.blue, 90), "90m A", inline = "LS2", group = g_LONDON_STYLE)
lo_90b_color        = input.color(color.new(color.green, 90), "90m B", inline = "LS2", group = g_LONDON_STYLE)
lo_30_color         = input.color(color.new(color.gray, 92), "30m", inline = "LS2", group = g_LONDON_STYLE)
lo_subcycles        = input.string("None", "Sub-Cycles", options = ["None", "90 Minutes", "90 AND 30 minutes"], group = g_LONDON_STYLE)

// --- NY AM Styling ---
var g_NY_AM_STYLE   = "NY AM Styling"
use_ny_am           = input.bool(true, "Show NY Morning Session", group = g_NY_AM_STYLE)
na_box_color        = input.color(color.new(color.blue, 85), "Main Box", inline = "NA1", group = g_NY_AM_STYLE)
na_90a_color        = input.color(color.new(color.blue, 90), "90m A", inline = "NA2", group = g_NY_AM_STYLE)
na_90b_color        = input.color(color.new(color.green, 90), "90m B", inline = "NA2", group = g_NY_AM_STYLE)
na_30_color         = input.color(color.new(color.gray, 92), "30m", inline = "NA2", group = g_NY_AM_STYLE)
na_subcycles        = input.string("None", "Sub-Cycles", options = ["None", "90 Minutes", "90 AND 30 minutes"], group = g_NY_AM_STYLE)

// --- NY PM Styling ---
var g_NY_PM_STYLE   = "NY PM Styling"
use_ny_pm           = input.bool(true, "Show NY Afternoon Session", group = g_NY_PM_STYLE)
np_box_color        = input.color(color.new(color.green, 85), "Main Box", inline = "NP1", group = g_NY_PM_STYLE)
np_90a_color        = input.color(color.new(color.blue, 90), "90m A", inline = "NP2", group = g_NY_PM_STYLE)
np_90b_color        = input.color(color.new(color.green, 90), "90m B", inline = "NP2", group = g_NY_PM_STYLE)
np_30_color         = input.color(color.new(color.gray, 92), "30m", inline = "NP2", group = g_NY_PM_STYLE)
np_subcycles        = input.string("None", "Sub-Cycles", options = ["None", "90 Minutes", "90 AND 30 minutes"], group = g_NY_PM_STYLE)


// --- Separator Styling ---
var g_SEPARATORS    = "Separator Styling"
divider_color       = input.color(color.new(color.gray, 50), "Start Line Color", group = g_SEPARATORS)
divider_width       = input.int(1, "Start Line Width", minval = 1, maxval = 5, group = g_SEPARATORS)
sep_line_color      = input.color(color.new(color.gray, 50), "End Line Color", group = g_SEPARATORS)
sep_line_style      = input.string("Dashed", "End Line Style", options = ["Solid", "Dashed", "Dotted"], group = g_SEPARATORS)
sep_line_width      = input.int(1, "End Line Width", minval = 1, maxval = 5, group = g_SEPARATORS)


// --- Cycle Marker Styling ---
var g_MARKER_STYLE      = "Cycle Marker Styling"
// High Box
h_box_bg_color          = input.color(color.new(color.green, 80), "High Box BG", group = g_MARKER_STYLE, inline = "HB1")
h_box_border_color      = input.color(color.new(color.green, 50), "Border", group = g_MARKER_STYLE, inline = "HB1")
h_box_border_width      = input.int(1, "", minval = 0, group = g_MARKER_STYLE, inline = "HB1")
// Low Box
l_box_bg_color          = input.color(color.new(color.red, 80), "Low Box BG", group = g_MARKER_STYLE, inline = "LB1")
l_box_border_color      = input.color(color.new(color.red, 50), "Border", group = g_MARKER_STYLE, inline = "LB1")
l_box_border_width      = input.int(1, "", minval = 0, group = g_MARKER_STYLE, inline = "LB1")
// Middle Line
mid_line_color          = input.color(color.new(color.gray, 0), "Mid Line", group = g_MARKER_STYLE, inline = "ML1")
mid_line_width          = input.int(1, "", minval = 1, maxval = 5, group = g_MARKER_STYLE, inline = "ML1")
mid_line_style          = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = g_MARKER_STYLE, inline = "ML1")


// --- Session High/Low Lines ---
var g_SESSION_HL_LINES = "Session High/Low Lines"
show_session_hl         = input.bool(true, "Show Session High/Low Lines", group = g_SESSION_HL_LINES)
// High Line
shl_high_color          = input.color(color.new(color.green, 50), "High Line", group = g_SESSION_HL_LINES, inline = "SHL_H")
shl_high_width          = input.int(1, "", minval = 1, maxval = 5, group = g_SESSION_HL_LINES, inline = "SHL_H")
shl_high_style          = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = g_SESSION_HL_LINES, inline = "SHL_H")
// Low Line
shl_low_color           = input.color(color.new(color.red, 50), "Low Line", group = g_SESSION_HL_LINES, inline = "SHL_L")
shl_low_width           = input.int(1, "", minval = 1, maxval = 5, group = g_SESSION_HL_LINES, inline = "SHL_L")
shl_low_style           = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = g_SESSION_HL_LINES, inline = "SHL_L")
// Labels
shl_high_label_color    = input.color(color.new(color.blue, 0), "High Label", group = g_SESSION_HL_LINES, inline = "SHL_Labels")
shl_low_label_color     = input.color(color.new(color.red, 0), "Low Label", group = g_SESSION_HL_LINES, inline = "SHL_Labels")


// --- Pre-calculated Boolean Checks for Performance ---
// Asia
bool as_show_30 = as_subcycles == "90 AND 30 minutes"
bool as_show_90 = as_show_30 or (as_subcycles == "90 Minutes")
// London
bool lo_show_30 = lo_subcycles == "90 AND 30 minutes"
bool lo_show_90 = lo_show_30 or (lo_subcycles == "90 Minutes")
// NY AM
bool na_show_30 = na_subcycles == "90 AND 30 minutes"
bool na_show_90 = na_show_30 or (na_subcycles == "90 Minutes")
// NY PM
bool np_show_30 = np_subcycles == "90 AND 30 minutes"
bool np_show_90 = np_show_30 or (np_subcycles == "90 Minutes")


// ---------------------------------------- Time Functions --------------------------------------------------
get_line_style(_style) =>
    result = switch _style
        'Solid' => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed
    result

get_text_size(size_str) =>
    result = switch size_str
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.auto
    result

tf_limit_seconds = switch tf_limit_str
    "1"  => 60
    "2"  => 120
    "3"  => 180
    "5"  => 300
    "15" => 900
    => 900

is_in_session(session_def) =>
    not na(time(timeframe.period, session_def, TIMEZONE))

is_new_bar(session_def) =>
    currently_in = is_in_session(session_def)
    previously_in = is_in_session(session_def)[1]

    // To robustly check if the previous state was `na` (on the first bar),
    // we convert the boolean series to a numeric one (true=1, false=0, na=na)
    // and then use the numeric-safe `na()` function.
    is_na = na(previously_in ? 1 : 0)

    // A new bar is when we are in, and either it's the first bar (is_na) or we were not previously in.
    result = currently_in and (is_na or not previously_in)
    result


// ---------------------------------------- Data Logic --------------------------------------------------
track_and_store_cycle_data(cycle_index, session_def, cycle_id) =>
    in_session = is_in_session(session_def)
    is_first_bar = is_new_bar(session_def)

    // Safe check for the end of a session
    previously_in = is_in_session(session_def)[1]
    is_na = na(previously_in ? 1 : 0)
    is_session_end = not is_na and previously_in and not in_session

    // Get current state from global arrays
    session_high = g_high_vals.get(cycle_index)
    session_low = g_low_vals.get(cycle_index)
    session_high_bar_index = g_high_bar_index_vals.get(cycle_index)
    session_low_bar_index = g_low_bar_index_vals.get(cycle_index)
    session_start_time = g_start_time_vals.get(cycle_index)

    if is_first_bar
        session_high := high
        session_low := low
        session_high_bar_index := bar_index
        session_low_bar_index := bar_index
        session_start_time := time
    else if in_session
        if na(session_high) or high > session_high
            session_high := high
            session_high_bar_index := bar_index
        if na(session_low) or low < session_low
            session_low := low
            session_low_bar_index := bar_index

    if is_session_end
        // On session end, store the final data in the map for future use
        session_end_time = time
        cycle_data = CycleData.new(session_high, session_low, session_high_bar_index, session_low_bar_index, session_start_time, session_end_time)
        g_cycle_data_map.put(cycle_id, cycle_data)

    // Update the global arrays with the new state for the next bar
    g_high_vals.set(cycle_index, session_high)
    g_low_vals.set(cycle_index, session_low)
    g_high_bar_index_vals.set(cycle_index, session_high_bar_index)
    g_low_bar_index_vals.set(cycle_index, session_low_bar_index)
    g_start_time_vals.set(cycle_index, session_start_time)
    0 // Return an int to allow calling as a statement


// Function to retrieve cycle data from the global map
get_cycle_data(cycle_id) =>
    g_cycle_data_map.get(cycle_id)

manage_sessions_and_lines(trading_day_id) =>
    // --- Determine Current Session ---
    in_asia = is_in_session(ASIA_SESSION_DEF)
    in_london = is_in_session(LONDON_SESSION_DEF)
    in_ny_am = is_in_session(NY_AM_SESSION_DEF)
    in_ny_pm = is_in_session(NY_PM_SESSION_DEF)
    in_any_session = in_asia or in_london or in_ny_am or in_ny_pm

    // --- Session High/Low Tracking ---
    var as_high = float(na), var as_low = float(na), var as_high_bar = int(na), var as_low_bar = int(na), var as_start_bar = int(na), var as_start_time = int(na)
    var lo_high = float(na), var lo_low = float(na), var lo_high_bar = int(na), var lo_low_bar = int(na), var lo_start_bar = int(na), var lo_start_time = int(na)
    var na_high = float(na), var na_low = float(na), var na_high_bar = int(na), var na_low_bar = int(na), var na_start_bar = int(na), var na_start_time = int(na)
    var np_high = float(na), var np_low = float(na), var np_high_bar = int(na), var np_low_bar = int(na), var np_start_bar = int(na), var np_start_time = int(na)

    if is_new_bar(TRADING_DAY_START)
        as_high := na, as_low := na, as_high_bar := na, as_low_bar := na, as_start_bar := na, as_start_time := na
        lo_high := na, lo_low := na, lo_high_bar := na, lo_low_bar := na, lo_start_bar := na, lo_start_time := na
        na_high := na, na_low := na, na_high_bar := na, na_low_bar := na, na_start_bar := na, na_start_time := na
        np_high := na, np_low := na, np_high_bar := na, np_low_bar := na, np_start_bar := na, np_start_time := na

    if in_asia
        if na(as_high)
            as_start_bar := bar_index
            as_start_time := time
        as_high_bar := high > as_high or na(as_high) ? bar_index : as_high_bar
        as_low_bar := low < as_low or na(as_low) ? bar_index : as_low_bar
        as_high := na(as_high) ? high : math.max(as_high, high)
        as_low := na(as_low) ? low : math.min(as_low, low)
    else if in_london
        if na(lo_high)
            lo_start_bar := bar_index
            lo_start_time := time
        lo_high_bar := high > lo_high or na(lo_high) ? bar_index : lo_high_bar
        lo_low_bar := low < lo_low or na(lo_low) ? bar_index : lo_low_bar
        lo_high := na(lo_high) ? high : math.max(lo_high, high)
        lo_low := na(lo_low) ? low : math.min(lo_low, low)
    else if in_ny_am
        if na(na_high)
            na_start_bar := bar_index
            na_start_time := time
        na_high_bar := high > na_high or na(na_high) ? bar_index : na_high_bar
        na_low_bar := low < na_low or na(na_low) ? bar_index : na_low_bar
        na_high := na(na_high) ? high : math.max(na_high, high)
        na_low := na(na_low) ? low : math.min(na_low, low)
    else if in_ny_pm
        if na(np_high)
            np_start_bar := bar_index
            np_start_time := time
        np_high_bar := high > np_high or na(np_high) ? bar_index : np_high_bar
        np_low_bar := low < np_low or na(np_low) ? bar_index : np_low_bar
        np_high := na(np_high) ? high : math.max(np_high, high)
        np_low := na(np_low) ? low : math.min(np_low, low)

    // --- Session Data Storage on Completion ---
    is_asia_end = is_in_session(ASIA_SESSION_DEF)[1] and not in_asia
    if is_asia_end
        session_data = SessionData.new(as_high, as_low, as_start_time, time, as_high_bar, as_low_bar)
        g_session_data_map.put("Asia-" + str.tostring(trading_day_id), session_data)

    is_london_end = is_in_session(LONDON_SESSION_DEF)[1] and not in_london
    if is_london_end
        session_data = SessionData.new(lo_high, lo_low, lo_start_time, time, lo_high_bar, lo_low_bar)
        g_session_data_map.put("London-" + str.tostring(trading_day_id), session_data)

    is_ny_am_end = is_in_session(NY_AM_SESSION_DEF)[1] and not in_ny_am
    if is_ny_am_end
        session_data = SessionData.new(na_high, na_low, na_start_time, time, na_high_bar, na_low_bar)
        g_session_data_map.put("NY_AM-" + str.tostring(trading_day_id), session_data)

    is_ny_pm_end = is_in_session(NY_PM_SESSION_DEF)[1] and not in_ny_pm
    if is_ny_pm_end
        session_data = SessionData.new(np_high, np_low, np_start_time, time, np_high_bar, np_low_bar)
        g_session_data_map.put("NY_PM-" + str.tostring(trading_day_id), session_data)


    // --- Real-time Line Management ---
    // Unconditionally extend lines first
    if not na(g_daily_lines.get(0))
        line.set_x2(g_daily_lines.get(0), bar_index)
    if not na(g_daily_lines.get(1))
        line.set_x2(g_daily_lines.get(1), bar_index)

    // Then, only check for new highs/lows if we are in a session
    if in_any_session
        // High Side
        daily_high = g_daily_hl_prices.get(0)
        current_high = in_asia ? as_high : in_london ? lo_high : in_ny_am ? na_high : in_ny_pm ? np_high : na
        is_new_daily_high = not na(current_high) and (na(daily_high) or current_high > daily_high)

        if is_new_daily_high
            line.delete(g_daily_lines.get(0))
            label.delete(g_daily_labels.get(0))

            start_bar = in_asia ? as_high_bar : in_london ? lo_high_bar : in_ny_am ? na_high_bar : np_high_bar
            session_start_bar = in_asia ? as_start_bar : in_london ? lo_start_bar : in_ny_am ? na_start_bar : np_start_bar
            session_name = in_asia ? "Asia" : in_london ? "London" : in_ny_am ? "NY AM" : "NY PM"

            g_daily_lines.set(0, line.new(start_bar, current_high, bar_index, current_high, xloc=xloc.bar_index, color=shl_high_color, style=get_line_style(shl_high_style), width=shl_high_width))
            g_daily_labels.set(0, label.new(session_start_bar, current_high, session_name + " High", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color(na), textcolor=shl_high_label_color, size=size.normal, textalign=text.align_left))
            g_daily_hl_prices.set(0, current_high)

        // Low Side
        daily_low = g_daily_hl_prices.get(1)
        current_low = in_asia ? as_low : in_london ? lo_low : in_ny_am ? na_low : in_ny_pm ? np_low : na
        is_new_daily_low = not na(current_low) and (na(daily_low) or current_low < daily_low)

        if is_new_daily_low
            line.delete(g_daily_lines.get(1))
            label.delete(g_daily_labels.get(1))

            start_bar = in_asia ? as_low_bar : in_london ? lo_low_bar : in_ny_am ? na_low_bar : np_low_bar
            session_start_bar = in_asia ? as_start_bar : in_london ? lo_start_bar : in_ny_am ? na_start_bar : np_start_bar
            session_name = in_asia ? "Asia" : in_london ? "London" : in_ny_am ? "NY AM" : "NY PM"

            g_daily_lines.set(1, line.new(start_bar, current_low, bar_index, current_low, xloc=xloc.bar_index, color=shl_low_color, style=get_line_style(shl_low_style), width=shl_low_width))
            g_daily_labels.set(1, label.new(session_start_bar, current_low, session_name + " Low", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color(na), textcolor=shl_low_label_color, size=size.normal, textalign=text.align_left))
            g_daily_hl_prices.set(1, current_low)
    0

// ---------------------------------------- Marker Drawing Logic --------------------------------------------------
// Function to retrieve main session data from the global map
get_main_session_data(session_id) =>
    g_session_data_map.get(session_id)

draw_main_session_markers(session_def, session_id_prefix, trading_day_id, index) =>
    in_session = is_in_session(session_def)
    previously_in = is_in_session(session_def)[1]
    is_session_end = na(previously_in ? 1 : 0) ? false : previously_in and not in_session

    if is_session_end and timeframe.period == "1"
        session_id = session_id_prefix + "-" + str.tostring(trading_day_id)
        retrieved_data = get_main_session_data(session_id)
        if not na(retrieved_data.start_time)
            // --- High Marker Box ---
            box.delete(g_main_session_high_marker_boxes.get(index))
            line.delete(g_main_session_high_midlines.get(index))

            high_offset = bar_index - retrieved_data.high_bar_index
            high_candle_high = high[high_offset]
            high_candle_low = low[high_offset]

            new_high_box = box.new(left=retrieved_data.start_time, top=high_candle_high, right=retrieved_data.end_time, bottom=high_candle_low, border_color=h_box_border_color, bgcolor=h_box_bg_color, border_width=h_box_border_width, xloc=xloc.bar_time)
            g_main_session_high_marker_boxes.set(index, new_high_box)

            mid_price_high = (high_candle_high + high_candle_low) / 2
            new_high_midline = line.new(x1=retrieved_data.start_time, y1=mid_price_high, x2=retrieved_data.end_time, y2=mid_price_high, xloc=xloc.bar_time, color=mid_line_color, style=get_line_style(mid_line_style), width=mid_line_width)
            g_main_session_high_midlines.set(index, new_high_midline)

            // --- Low Marker Box ---
            box.delete(g_main_session_low_marker_boxes.get(index))
            line.delete(g_main_session_low_midlines.get(index))

            low_offset = bar_index - retrieved_data.low_bar_index
            low_candle_high = high[low_offset]
            low_candle_low = low[low_offset]

            new_low_box = box.new(left=retrieved_data.start_time, top=low_candle_high, right=retrieved_data.end_time, bottom=low_candle_low, border_color=l_box_border_color, bgcolor=l_box_bg_color, border_width=l_box_border_width, xloc=xloc.bar_time)
            g_main_session_low_marker_boxes.set(index, new_low_box)

            mid_price_low = (low_candle_high + low_candle_low) / 2
            new_low_midline = line.new(x1=retrieved_data.start_time, y1=mid_price_low, x2=retrieved_data.end_time, y2=mid_price_low, xloc=xloc.bar_time, color=mid_line_color, style=get_line_style(mid_line_style), width=mid_line_width)
            g_main_session_low_midlines.set(index, new_low_midline)
    0

draw_cycle_markers(session_def, cycle_id, cycle_index) =>
    in_session = is_in_session(session_def)
    previously_in = is_in_session(session_def)[1]
    is_session_end = na(previously_in ? 1 : 0) ? false : previously_in and not in_session

    if is_session_end and timeframe.period == "1"
        retrieved_data = get_cycle_data(cycle_id)
        if not na(retrieved_data.start_time)
            // --- High Marker Box ---
            box.delete(g_high_marker_boxes.get(cycle_index))
            line.delete(g_high_midline_ids.get(cycle_index))

            high_offset = bar_index - retrieved_data.high_bar_index
            high_candle_high = high[high_offset]
            high_candle_low = low[high_offset]

            new_high_box = box.new(left=retrieved_data.start_time, top=high_candle_high, right=retrieved_data.end_time, bottom=high_candle_low, border_color=h_box_border_color, bgcolor=h_box_bg_color, border_width=h_box_border_width, xloc=xloc.bar_time)
            g_high_marker_boxes.set(cycle_index, new_high_box)

            mid_price_high = (high_candle_high + high_candle_low) / 2
            new_high_midline = line.new(x1=retrieved_data.start_time, y1=mid_price_high, x2=retrieved_data.end_time, y2=mid_price_high, xloc=xloc.bar_time, color=mid_line_color, style=get_line_style(mid_line_style), width=mid_line_width)
            g_high_midline_ids.set(cycle_index, new_high_midline)

            // --- Low Marker Box ---
            box.delete(g_low_marker_boxes.get(cycle_index))
            line.delete(g_low_midline_ids.get(cycle_index))

            low_offset = bar_index - retrieved_data.low_bar_index
            low_candle_high = high[low_offset]
            low_candle_low = low[low_offset]

            new_low_box = box.new(left=retrieved_data.start_time, top=low_candle_high, right=retrieved_data.end_time, bottom=low_candle_low, border_color=l_box_border_color, bgcolor=l_box_bg_color, border_width=l_box_border_width, xloc=xloc.bar_time)
            g_low_marker_boxes.set(cycle_index, new_low_box)

            mid_price_low = (low_candle_high + low_candle_low) / 2
            new_low_midline = line.new(x1=retrieved_data.start_time, y1=mid_price_low, x2=retrieved_data.end_time, y2=mid_price_low, xloc=xloc.bar_time, color=mid_line_color, style=get_line_style(mid_line_style), width=mid_line_width)
            g_low_midline_ids.set(cycle_index, new_low_midline)
    0


// ---------------------------------------- Drawing Logic --------------------------------------------------
draw_session_box(session_def, box_color, is_sub_cycle) =>
    in_session = is_in_session(session_def)
    if not na(box_color)
        var box session_box = na
        var line start_line = na
        var float session_high = na
        var float session_low = na
        is_first_bar = is_new_bar(session_def)

        if is_first_bar
            // Cleanup old drawings from the previous day
            if not na(session_box)
                box.delete(session_box)
                line.delete(start_line)

            session_high := high
            session_low := low

            // Create new box
            session_box := box.new(time, high, time, low, xloc=xloc.bar_time, bgcolor=box_color, border_color=box_color)

            // Create new start line with conditional extension
            line_extend_style = is_sub_cycle ? extend.none : extend.both
            start_line := line.new(time, session_low, time, session_high, xloc=xloc.bar_time, extend=line_extend_style, color=divider_color, style=line.style_dotted, width=divider_width)

        else if in_session
            if not na(session_box) // Make sure we have a box to update
                // Extend the box's right edge to the close of the current bar
                box.set_right(session_box, time_close)

                // Update the vertical range of the box and line
                session_high := math.max(session_high, high)
                session_low := math.min(session_low, low)
                box.set_top(session_box, session_high)
                box.set_bottom(session_box, session_low)
                line.set_y1(start_line, session_low)
                line.set_y2(start_line, session_high)
    0 // Return an int to allow calling it as a statement

// ---------------------------------------- Core Logic --------------------------------------------------
can_draw = timeframe.in_seconds(timeframe.period) <= tf_limit_seconds
var line day_separator_line = na

// Standalone Day Separator Line
if can_draw and show_day_line and is_new_bar(TRADING_DAY_START)
    if not na(day_separator_line)
        line.delete(day_separator_line)
    day_separator_line := line.new(bar_index, low, bar_index, high, extend=extend.both, color=day_line_color, style=get_line_style(day_line_style), width=day_line_width)

if can_draw
    // --- Session Drawing Objects ---
    var box asia_header_box = na
    var box london_header_box = na
    var box ny_am_header_box = na
    var box ny_pm_header_box = na
    var line asia_sep_line = na
    var line lon_sep_line = na
    var line ny_am_sep_line = na
    var line ny_pm_sep_line = na
    var separator_style = get_line_style(sep_line_style)

    // --- Daily High Calculation for Header Alignment ---
    var int trading_day_id = 0
    if is_new_bar(TRADING_DAY_START)
        trading_day_id += 1
        // Reset daily high/low tracking variables
        g_daily_hl_prices.fill(na)
        line.delete(g_daily_lines.get(0))
        label.delete(g_daily_labels.get(0))
        line.delete(g_daily_lines.get(1))
        label.delete(g_daily_labels.get(1))

    var float current_trading_day_high = high
    if trading_day_id > trading_day_id[1]
        current_trading_day_high := high
    else
        current_trading_day_high := math.max(current_trading_day_high, high)

    float prev_day_high = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)

    // --- Drawing Execution ---
    // Headers
    if show_headers
        // --- Header Positioning & Sizing ---
        anchor_high = math.max(prev_day_high, current_trading_day_high)
        offset_value = syminfo.mintick * header_offset_ticks
        height_value = syminfo.mintick * header_height_ticks
        header_text_size = get_text_size(header_text_size_str)
        header_bottom_level = anchor_high + offset_value
        header_top_level = header_bottom_level + height_value

        // --- Header Creation ---
        if use_asia and is_new_bar(ASIA_SESSION_DEF)
            box.delete(asia_header_box[1])
            start_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time), ASIA_START_HOUR, ASIA_START_MIN)
            end_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time) + ASIA_DAY_OFFSET, ASIA_END_HOUR, ASIA_END_MIN)
            asia_header_box := box.new(start_ts, header_top_level, end_ts, header_bottom_level, xloc=xloc.bar_time, bgcolor=header_bg_color, border_color=header_border_color, text="Asia", text_color=header_text_color, text_halign=text.align_center, text_valign=text.align_center, text_size=header_text_size)
        if use_london and is_new_bar(LONDON_SESSION_DEF)
            box.delete(london_header_box[1])
            start_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time), LONDON_START_HOUR, LONDON_START_MIN)
            end_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time) + LONDON_DAY_OFFSET, LONDON_END_HOUR, LONDON_END_MIN)
            london_header_box := box.new(start_ts, header_top_level, end_ts, header_bottom_level, xloc=xloc.bar_time, bgcolor=header_bg_color, border_color=header_border_color, text="London", text_color=header_text_color, text_halign=text.align_center, text_valign=text.align_center, text_size=header_text_size)
        if use_ny_am and is_new_bar(NY_AM_SESSION_DEF)
            box.delete(ny_am_header_box[1])
            start_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time), NY_AM_START_HOUR, NY_AM_START_MIN)
            end_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time) + NY_AM_DAY_OFFSET, NY_AM_END_HOUR, NY_AM_END_MIN)
            ny_am_header_box := box.new(start_ts, header_top_level, end_ts, header_bottom_level, xloc=xloc.bar_time, bgcolor=header_bg_color, border_color=header_border_color, text="NY AM", text_color=header_text_color, text_halign=text.align_center, text_valign=text.align_center, text_size=header_text_size)
        if use_ny_pm and is_new_bar(NY_PM_SESSION_DEF)
            box.delete(ny_pm_header_box[1])
            start_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time), NY_PM_START_HOUR, NY_PM_START_MIN)
            end_ts = timestamp(TIMEZONE, year(time), month(time), dayofmonth(time) + NY_PM_DAY_OFFSET, NY_PM_END_HOUR, NY_PM_END_MIN)
            ny_pm_header_box := box.new(start_ts, header_top_level, end_ts, header_bottom_level, xloc=xloc.bar_time, bgcolor=header_bg_color, border_color=header_border_color, text="NY PM", text_color=header_text_color, text_halign=text.align_center, text_valign=text.align_center, text_size=header_text_size)

        // --- Header Repositioning ---
        // This runs on every bar to ensure the headers are always aligned to the current day's highest high.
        if not na(asia_header_box)
            asia_header_box.set_top(header_top_level)
            asia_header_box.set_bottom(header_bottom_level)
        if not na(london_header_box)
            london_header_box.set_top(header_top_level)
            london_header_box.set_bottom(header_bottom_level)
        if not na(ny_am_header_box)
            ny_am_header_box.set_top(header_top_level)
            ny_am_header_box.set_bottom(header_bottom_level)
        if not na(ny_pm_header_box)
            ny_pm_header_box.set_top(header_top_level)
            ny_pm_header_box.set_bottom(header_bottom_level)

    // --- Session Separators ---

    if use_asia and is_new_bar(ASIA_SESSION_DEF)
        line.delete(asia_sep_line)
        future_time = timestamp(TIMEZONE, year(time[1]), month(time[1]), dayofmonth(time[1]) + ASIA_DAY_OFFSET, ASIA_END_HOUR, ASIA_END_MIN)
        asia_sep_line := line.new(future_time, low, future_time, high, xloc=xloc.bar_time, extend=extend.both, color=sep_line_color, style=separator_style, width=sep_line_width)

    if use_london and is_new_bar(LONDON_SESSION_DEF)
        line.delete(lon_sep_line)
        future_time = timestamp(TIMEZONE, year(time[1]), month(time[1]), dayofmonth(time[1]) + LONDON_DAY_OFFSET, LONDON_END_HOUR, LONDON_END_MIN)
        lon_sep_line := line.new(future_time, low, future_time, high, xloc=xloc.bar_time, extend=extend.both, color=sep_line_color, style=separator_style, width=sep_line_width)

    if use_ny_am and is_new_bar(NY_AM_SESSION_DEF)
        line.delete(ny_am_sep_line)
        future_time = timestamp(TIMEZONE, year(time[1]), month(time[1]), dayofmonth(time[1]) + NY_AM_DAY_OFFSET, NY_AM_END_HOUR, NY_AM_END_MIN)
        ny_am_sep_line := line.new(future_time, low, future_time, high, xloc=xloc.bar_time, extend=extend.both, color=sep_line_color, style=separator_style, width=sep_line_width)

    if use_ny_pm and is_new_bar(NY_PM_SESSION_DEF)
        line.delete(ny_pm_sep_line)
        future_time = timestamp(TIMEZONE, year(time[1]), month(time[1]), dayofmonth(time[1]) + NY_PM_DAY_OFFSET, NY_PM_END_HOUR, NY_PM_END_MIN)
        ny_pm_sep_line := line.new(future_time, low, future_time, high, xloc=xloc.bar_time, extend=extend.both, color=sep_line_color, style=separator_style, width=sep_line_width)

    // --- DATA TRACKING LOGIC ---
    // Manage real-time lines and track/store session data
    if show_session_hl or show_sessions
        manage_sessions_and_lines(trading_day_id)

    // Track sub-cycle data
    if timeframe.period == "1"
        if use_asia and as_show_90
            track_and_store_cycle_data(0, "1800-1930", "Asia-1-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(1, "1930-2100", "Asia-2-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(2, "2100-2230", "Asia-3-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(3, "2230-0000", "Asia-4-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(4, "0000-0130", "Asia-5-" + str.tostring(trading_day_id))
        if use_london and lo_show_90
            track_and_store_cycle_data(5, "0230-0400", "London-1-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(6, "0400-0530", "London-2-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(7, "0530-0700", "London-3-" + str.tostring(trading_day_id))
        if use_ny_am and na_show_90
            track_and_store_cycle_data(8, "0700-0830", "NY-AM-1-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(9, "0830-1000", "NY-AM-2-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(10, "1000-1130", "NY-AM-3-" + str.tostring(trading_day_id))
        if use_ny_pm and np_show_90
            track_and_store_cycle_data(11, "1130-1300", "NY-PM-1-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(12, "1300-1430", "NY-PM-2-" + str.tostring(trading_day_id))
            track_and_store_cycle_data(13, "1430-1600", "NY-PM-3-" + str.tostring(trading_day_id))

    // --- DRAWING LOGIC ---
    // 1. Draw Background Session Boxes
    if show_sessions
        // Main Sessions
        if use_asia
            draw_session_box(ASIA_SESSION_DEF, as_box_color, false)
        if use_london
            draw_session_box(LONDON_SESSION_DEF, lo_box_color, false)
        if use_ny_am
            draw_session_box(NY_AM_SESSION_DEF, na_box_color, false)
        if use_ny_pm
            draw_session_box(NY_PM_SESSION_DEF, np_box_color, false)

        // Sub-Cycles
        // Asia
        draw_session_box("1800-1930", use_asia and as_show_90 ? as_90a_color : na, true)
        draw_session_box("1930-2100", use_asia and as_show_90 ? as_90b_color : na, true)
        draw_session_box("2100-2230", use_asia and as_show_90 ? as_90a_color : na, true)
        draw_session_box("2230-0000", use_asia and as_show_90 ? as_90b_color : na, true)
        draw_session_box("0000-0130", use_asia and as_show_90 ? as_90a_color : na, true)
        draw_session_box("1800-1830", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("1830-1900", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("1900-1930", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("1930-2000", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2000-2030", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2030-2100", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2100-2130", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2130-2200", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2200-2230", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2230-2300", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2300-2330", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("2330-0000", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("0000-0030", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("0030-0100", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("0100-0130", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("0130-0200", use_asia and as_show_30 ? as_30_color : na, true)
        draw_session_box("0200-0230", use_asia and as_show_30 ? as_30_color : na, true)
        // London
        draw_session_box("0230-0400", use_london and lo_show_90 ? lo_90a_color : na, true)
        draw_session_box("0400-0530", use_london and lo_show_90 ? lo_90b_color : na, true)
        draw_session_box("0530-0700", use_london and lo_show_90 ? lo_90a_color : na, true)
        draw_session_box("0230-0300", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0300-0330", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0330-0400", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0400-0430", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0430-0500", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0500-0530", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0530-0600", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0600-0630", use_london and lo_show_30 ? lo_30_color : na, true)
        draw_session_box("0630-0700", use_london and lo_show_30 ? lo_30_color : na, true)
        // NY AM
        draw_session_box("0700-0830", use_ny_am and na_show_90 ? na_90a_color : na, true)
        draw_session_box("0830-1000", use_ny_am and na_show_90 ? na_90b_color : na, true)
        draw_session_box("1000-1130", use_ny_am and na_show_90 ? na_90a_color : na, true)
        draw_session_box("0700-0730", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("0730-0800", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("0800-0830", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("0830-0900", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("0900-0930", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("0930-1000", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("1000-1030", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("1030-1100", use_ny_am and na_show_30 ? na_30_color : na, true)
        draw_session_box("1100-1130", use_ny_am and na_show_30 ? na_30_color : na, true)
        // NY PM
        draw_session_box("1130-1300", use_ny_pm and np_show_90 ? np_90a_color : na, true)
        draw_session_box("1300-1430", use_ny_pm and np_show_90 ? np_90b_color : na, true)
        draw_session_box("1430-1600", use_ny_pm and np_show_90 ? np_90a_color : na, true)
        draw_session_box("1130-1200", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1200-1230", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1230-1300", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1300-1330", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1330-1400", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1400-1430", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1430-1500", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1500-1530", use_ny_pm and np_show_30 ? np_30_color : na, true)
        draw_session_box("1530-1600", use_ny_pm and np_show_30 ? np_30_color : na, true)

    // 2. Draw Markers and Midlines
    if show_sessions
        // Main Session Markers
        if use_asia
            draw_main_session_markers(ASIA_SESSION_DEF, "Asia", trading_day_id, 0)
        if use_london
            draw_main_session_markers(LONDON_SESSION_DEF, "London", trading_day_id, 1)
        if use_ny_am
            draw_main_session_markers(NY_AM_SESSION_DEF, "NY_AM", trading_day_id, 2)
        if use_ny_pm
            draw_main_session_markers(NY_PM_SESSION_DEF, "NY_PM", trading_day_id, 3)

    // Sub-Cycle Markers
    if timeframe.period == "1"
        if use_asia and as_show_90
            draw_cycle_markers("1800-1930", "Asia-1-" + str.tostring(trading_day_id), 0)
            draw_cycle_markers("1930-2100", "Asia-2-" + str.tostring(trading_day_id), 1)
            draw_cycle_markers("2100-2230", "Asia-3-" + str.tostring(trading_day_id), 2)
            draw_cycle_markers("2230-0000", "Asia-4-" + str.tostring(trading_day_id), 3)
            draw_cycle_markers("0000-0130", "Asia-5-" + str.tostring(trading_day_id), 4)
        if use_london and lo_show_90
            draw_cycle_markers("0230-0400", "London-1-" + str.tostring(trading_day_id), 5)
            draw_cycle_markers("0400-0530", "London-2-" + str.tostring(trading_day_id), 6)
            draw_cycle_markers("0530-0700", "London-3-" + str.tostring(trading_day_id), 7)
        if use_ny_am and na_show_90
            draw_cycle_markers("0700-0830", "NY-AM-1-" + str.tostring(trading_day_id), 8)
            draw_cycle_markers("0830-1000", "NY-AM-2-" + str.tostring(trading_day_id), 9)
            draw_cycle_markers("1000-1130", "NY-AM-3-" + str.tostring(trading_day_id), 10)
        if use_ny_pm and np_show_90
            draw_cycle_markers("1130-1300", "NY-PM-1-" + str.tostring(trading_day_id), 11)
            draw_cycle_markers("1300-1430", "NY-PM-2-" + str.tostring(trading_day_id), 12)
            draw_cycle_markers("1430-1600", "NY-PM-3-" + str.tostring(trading_day_id), 13)
