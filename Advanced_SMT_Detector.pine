// =============================================================================
// CONSTANTS & GENERAL FUNCTIONS
// =============================================================================
int MAX_DRAWING_OBJECTS = 500
int MAX_HISTORY_SIZE = 500

isWithinAnySession() =>
    anyFilterEnabled = enableTimeFilter1 or enableTimeFilter2 or enableTimeFilter3
    if not anyFilterEnabled
        true
    else
        inSession1 = enableTimeFilter1 and not na(time(timeframe.period, timeSession1, sessionTimezone))
        inSession2 = enableTimeFilter2 and not na(time(timeframe.period, timeSession2, sessionTimezone))
        inSession3 = enableTimeFilter3 and not na(time(timeframe.period, timeSession3, sessionTimezone))
        inSession1 or inSession2 or inSession3

getTicker(string symbolString) =>
    str.contains(symbolString, ":") ? str.substring(symbolString, str.pos(symbolString, ":") + 1, str.length(symbolString)) : symbolString

formatTimeframe(string tf) =>
    var result = tf
    float tf_minutes = str.tonumber(tf)
    if not na(tf_minutes)
        if tf_minutes >= 60 and tf_minutes % 60 == 0
            result := str.tostring(int(tf_minutes / 60)) + 'H'
        else
            result := str.tostring(int(tf_minutes)) + 'M'
    result

checkForPivot(array<float> history, int pivot_idx, int left_strength, int right_strength, bool is_high) =>
    is_pivot = true
    if array.size(history) < left_strength + right_strength + 1 or pivot_idx < left_strength or pivot_idx > array.size(history) - 1 - right_strength
        is_pivot := false
    else
        pivot_price = array.get(history, pivot_idx)
        for i = 0 to left_strength + right_strength
            if i != left_strength
                neighbor_price = array.get(history, pivot_idx - left_strength + i)
                if is_high and neighbor_price >= pivot_price
                    is_pivot := false
                    break
                if not is_high and neighbor_price <= pivot_price
                    is_pivot := false
                    break
    is_pivot

drawPivotCross(array<label> labelsArray, int bar_time, float price, color p_color) =>
    label newLabel = label.new(bar_time, price, xloc=xloc.bar_time, style=label.style_xcross, color=p_color, size=size.tiny)
    array.push(labelsArray, newLabel)
    if array.size(labelsArray) > MAX_DRAWING_OBJECTS
        label.delete(array.shift(labelsArray))

cleanupSmtDrawings(SmtEngine engine) =>
    for l in engine.confirmedLines
        line.delete(l)
    array.clear(engine.confirmedLines)
    for l in engine.confirmedLabels
        label.delete(l)
    array.clear(engine.confirmedLabels)
    label.delete(engine.pivotA_HighLabel), label.delete(engine.visualPivotA_HighLabel)
    label.delete(engine.pivotA_LowLabel), label.delete(engine.visualPivotA_LowLabel)
    line.delete(engine.ltfHighWatchline), label.delete(engine.ltfHighLabel)
    line.delete(engine.ltfLowWatchline), label.delete(engine.ltfLowLabel)

// =============================================================================
// CORE ENGINE FUNCTIONS
// =============================================================================

// Manages the collection of HTF price history for a single SMT engine.
collectHistory(SmtEngine engine) =>
    is_new_htf_bar = nz(ta.change(time(engine.htfTimeframe))) != 0

    // Track the high and low of the current HTF session in real-time.
    if is_new_htf_bar
        engine.sessionHigh := high
        engine.sessionLow := low
        engine.sessionHighTime := time
        engine.sessionLowTime := time
    else
        if high >= engine.sessionHigh
            engine.sessionHigh := high
            engine.sessionHighTime := time
        if low <= engine.sessionLow
            engine.sessionLow := low
            engine.sessionLowTime := time

    // When the HTF bar closes, store its data and check for pivots.
    if is_new_htf_bar
        // Store the main asset's data from the previous bar.
        array.push(engine.historyHighs, engine.sessionHigh[1])
        array.push(engine.historyTimesHigh, engine.sessionHighTime[1])
        array.push(engine.historyLows, engine.sessionLow[1])
        array.push(engine.historyTimesLow, engine.sessionLowTime[1])

        // Request and store the comparison asset's data for the same closed bar.
        float comp_high = request.security(masterComparisonAsset, engine.htfTimeframe, high[1], lookahead=barmerge.lookahead_off)
        float comp_low = request.security(masterComparisonAsset, engine.htfTimeframe, low[1], lookahead=barmerge.lookahead_off)
        array.push(engine.compHistoryHighs, comp_high)
        array.push(engine.compHistoryLows, comp_low)

        // Manage history array sizes to prevent memory overflow.
        if array.size(engine.historyHighs) > MAX_HISTORY_SIZE
            array.shift(engine.historyHighs)
            array.shift(engine.historyTimesHigh)
            array.shift(engine.historyLows)
            array.shift(engine.historyTimesLow)
            array.shift(engine.compHistoryHighs)
            array.shift(engine.compHistoryLows)

        // Check for and draw new pivots if enabled.
        if engine.showPivots
            pivot_check_index = array.size(engine.historyHighs) - 1 - engine.rightStrength
            if pivot_check_index >= 0
                if checkForPivot(engine.historyHighs, pivot_check_index, engine.leftStrength, engine.rightStrength, true)
                    drawPivotCross(engine.pivotLabels, array.get(engine.historyTimesHigh, pivot_check_index), array.get(engine.historyHighs, pivot_check_index), engine.highColor)
                if checkForPivot(engine.historyLows, pivot_check_index, engine.leftStrength, engine.rightStrength, false)
                    drawPivotCross(engine.pivotLabels, array.get(engine.historyTimesLow, pivot_check_index), array.get(engine.historyLows, pivot_check_index), engine.lowColor)
    is_new_htf_bar


// Processes the core SMT logic for a single engine.
processSmtLogic(SmtEngine engine, bool is_new_htf_bar) =>
    bool isWithinTimeSession = isWithinAnySession()
    string shortAssetName = getTicker(masterComparisonAsset)
    float atr = ta.atr(14)
    float y_offset = atr * 0.1

    if is_new_htf_bar
        int pivot_idx = array.size(engine.historyHighs) - 1 - engine.rightStrength
        if pivot_idx >= 0
            // --- Check for Bearish SMT ---
            bool is_main_pivot_high = checkForPivot(engine.historyHighs, pivot_idx, engine.leftStrength, engine.rightStrength, true)
            bool is_comp_pivot_high = checkForPivot(engine.compHistoryHighs, pivot_idx, engine.leftStrength, engine.rightStrength, true)
            if is_main_pivot_high and is_comp_pivot_high
                float mainHtfPivotHigh = array.get(engine.historyHighs, pivot_idx)
                float compHtfPivotHigh = array.get(engine.compHistoryHighs, pivot_idx)
                int smt_main_pivot_time = array.get(engine.historyTimesHigh, pivot_idx)
                if not na(engine.pivotA_HighLabel)
                    if (mainHtfPivotHigh - label.get_y(engine.pivotA_HighLabel)) * (compHtfPivotHigh - str.tonumber(label.get_text(engine.pivotA_HighLabel))) < 0
                        bool wasPivotARun = false
                        for i = pivot_idx - 1 to 0
                            if array.get(engine.historyTimesHigh, i) > label.get_x(engine.pivotA_HighLabel)
                                if array.get(engine.historyHighs, i) > label.get_y(engine.pivotA_HighLabel)
                                    wasPivotARun := true
                                    break
                            else
                                break
                        if not wasPivotARun and isWithinTimeSession
                            string confirmedTextTemplate = "{0} vs {1}\nTimeframe: {2}\nStrength: {3}-{4}"
                            string baseInfoText = str.format(confirmedTextTemplate, syminfo.ticker, shortAssetName, formatTimeframe(engine.htfTimeframe), str.tostring(engine.leftStrength), str.tostring(engine.rightStrength))
                            line newLine = line.new(label.get_x(engine.pivotA_HighLabel), label.get_y(engine.pivotA_HighLabel), smt_main_pivot_time, mainHtfPivotHigh, xloc = xloc.bar_time, color=color.new(engine.highColor, 40), width=2)
                            label newLabel = label.new(smt_main_pivot_time, mainHtfPivotHigh + y_offset, "SMT Bearish\n" + baseInfoText + "\nStatus: Confirmed", xloc = xloc.bar_time, color=color.new(engine.highColor, 75), textcolor=color.white, style=label.style_label_down, size=size.normal, textalign=text.align_left)
                            array.push(engine.confirmedLines, newLine)
                            array.push(engine.confirmedLabels, newLabel)
                            if engine.enableAlerts
                                alert("Confirmed Bearish SMT on SMT TF" + str.tostring(engine.id), alert.freq_once_per_bar)
                
                // Cleanup and set new Pivot A
                line.delete(engine.ltfHighWatchline), engine.ltfHighWatchline := na, label.delete(engine.ltfHighLabel), engine.ltfHighLabel := na, engine.ltfWatchlineHighPrice := na
                label.delete(engine.pivotA_HighLabel), label.delete(engine.visualPivotA_HighLabel)
                engine.pivotA_HighLabel := label.new(smt_main_pivot_time, mainHtfPivotHigh, str.tostring(compHtfPivotHigh), xloc = xloc.bar_time, style=label.style_none, textcolor=color.new(color.white, 100))
                engine.visualPivotA_HighLabel := label.new(smt_main_pivot_time, mainHtfPivotHigh + y_offset, "A", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(engine.highColor, 25), textcolor=color.white, size=size.small, tooltip="Pivot A High")
                engine.ltfMainAssetInvalidatedHigh := false, engine.ltfCompAssetInvalidatedHigh := false

            // --- Check for Bullish SMT ---
            bool is_main_pivot_low = checkForPivot(engine.historyLows, pivot_idx, engine.leftStrength, engine.rightStrength, false)
            bool is_comp_pivot_low = checkForPivot(engine.compHistoryLows, pivot_idx, engine.leftStrength, engine.rightStrength, false)
            if is_main_pivot_low and is_comp_pivot_low
                float mainHtfPivotLow = array.get(engine.historyLows, pivot_idx)
                float compHtfPivotLow = array.get(engine.compHistoryLows, pivot_idx)
                int smt_main_pivot_time = array.get(engine.historyTimesLow, pivot_idx)
                if not na(engine.pivotA_LowLabel)
                    if (mainHtfPivotLow - label.get_y(engine.pivotA_LowLabel)) * (compHtfPivotLow - str.tonumber(label.get_text(engine.pivotA_LowLabel))) < 0
                        bool wasPivotARun = false
                        for i = pivot_idx - 1 to 0
                            if array.get(engine.historyTimesLow, i) > label.get_x(engine.pivotA_LowLabel)
                                if array.get(engine.historyLows, i) < label.get_y(engine.pivotA_LowLabel)
                                    wasPivotARun := true
                                    break
                            else
                                break
                        if not wasPivotARun and isWithinTimeSession
                            string confirmedTextTemplate = "{0} vs {1}\nTimeframe: {2}\nStrength: {3}-{4}"
                            string baseInfoText = str.format(confirmedTextTemplate, syminfo.ticker, shortAssetName, formatTimeframe(engine.htfTimeframe), str.tostring(engine.leftStrength), str.tostring(engine.rightStrength))
                            line newLine = line.new(label.get_x(engine.pivotA_LowLabel), label.get_y(engine.pivotA_LowLabel), smt_main_pivot_time, mainHtfPivotLow, xloc = xloc.bar_time, color=color.new(engine.lowColor, 40), width=2)
                            label newLabel = label.new(smt_main_pivot_time, mainHtfPivotLow - y_offset, "SMT Bullish\n" + baseInfoText + "\nStatus: Confirmed", xloc = xloc.bar_time, color=color.new(engine.lowColor, 75), textcolor=color.white, style=label.style_label_up, size=size.normal, textalign=text.align_left)
                            array.push(engine.confirmedLines, newLine)
                            array.push(engine.confirmedLabels, newLabel)
                            if engine.enableAlerts
                                alert("Confirmed Bullish SMT on SMT TF" + str.tostring(engine.id), alert.freq_once_per_bar)

                // Cleanup and set new Pivot A
                line.delete(engine.ltfLowWatchline), engine.ltfLowWatchline := na, label.delete(engine.ltfLowLabel), engine.ltfLowLabel := na, engine.ltfWatchlineLowPrice := na
                label.delete(engine.pivotA_LowLabel), label.delete(engine.visualPivotA_LowLabel)
                engine.pivotA_LowLabel := label.new(smt_main_pivot_time, mainHtfPivotLow, str.tostring(compHtfPivotLow), xloc = xloc.bar_time, style=label.style_none, textcolor=color.new(color.white, 100))
                engine.visualPivotA_LowLabel := label.new(smt_main_pivot_time, mainHtfPivotLow - y_offset, "A", xloc=xloc.bar_time, style=label.style_label_up, color=color.new(engine.lowColor, 25), textcolor=color.white, size=size.small, tooltip="Pivot A Low")
                engine.ltfMainAssetInvalidatedLow := false, engine.ltfCompAssetInvalidatedLow := false

    // --- Early LTF Detection Logic ---
    if engine.enableLtfDetection and engine.ltfTimeframe != '' and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(engine.ltfTimeframe)
        bool is_new_intraday_bar = ta.change(time(engine.ltfTimeframe)) != 0
        
        var string usedLtfTimeframe = engine.ltfTimeframe
        [intra_comp_high_base, intra_comp_low_base] = request.security(masterComparisonAsset, engine.ltfTimeframe, [high, low], lookahead=barmerge.lookahead_off)
        usedLtfTimeframe := engine.ltfTimeframe
        
        float intra_comp_high = intra_comp_high_base
        float intra_comp_low = intra_comp_low_base

        if na(intra_comp_high)
            [intra_comp_high, intra_comp_low] = request.security(masterComparisonAsset, '15', [high, low], lookahead=barmerge.lookahead_off)
            usedLtfTimeframe := '15'
        if na(intra_comp_high)
            [intra_comp_high, intra_comp_low] = request.security(masterComparisonAsset, '60', [high, low], lookahead=barmerge.lookahead_off)
            usedLtfTimeframe := '60'

        if is_new_intraday_bar
            engine.ltfSessionHigh := high, engine.ltfSessionLow := low, engine.ltfSessionHighTime := time, engine.ltfSessionLowTime := time
            engine.ltfCompSessionHigh := intra_comp_high, engine.ltfCompSessionLow := intra_comp_low
        else
            if high > engine.ltfSessionHigh
                engine.ltfSessionHigh := high, engine.ltfSessionHighTime := time
            if low < engine.ltfSessionLow
                engine.ltfSessionLow := low, engine.ltfSessionLowTime := time
            if intra_comp_high > engine.ltfCompSessionHigh
                engine.ltfCompSessionHigh := intra_comp_high
            if intra_comp_low < engine.ltfCompSessionLow
                engine.ltfCompSessionLow := intra_comp_low
        
        if is_new_intraday_bar
            float ltf_main_high = engine.ltfSessionHigh[1], float ltf_main_low = engine.ltfSessionLow[1]
            float ltf_comp_high = engine.ltfCompSessionHigh[1], float ltf_comp_low = engine.ltfCompSessionLow[1]
            
            if not na(engine.pivotA_HighLabel)
                if not engine.ltfMainAssetInvalidatedHigh and ltf_main_high > label.get_y(engine.pivotA_HighLabel)
                    engine.ltfMainAssetInvalidatedHigh := true
                if not engine.ltfCompAssetInvalidatedHigh and ltf_comp_high > str.tonumber(label.get_text(engine.pivotA_HighLabel))
                    engine.ltfCompAssetInvalidatedHigh := true
                if engine.ltfMainAssetInvalidatedHigh and engine.ltfCompAssetInvalidatedHigh
                    label.delete(engine.pivotA_HighLabel), engine.pivotA_HighLabel := na, label.delete(engine.visualPivotA_HighLabel), engine.visualPivotA_HighLabel := na
                    line.delete(engine.ltfHighWatchline), engine.ltfHighWatchline := na, label.delete(engine.ltfHighLabel), engine.ltfHighLabel := na
            
            if not na(engine.pivotA_LowLabel)
                if not engine.ltfMainAssetInvalidatedLow and ltf_main_low < label.get_y(engine.pivotA_LowLabel)
                    engine.ltfMainAssetInvalidatedLow := true
                if not engine.ltfCompAssetInvalidatedLow and ltf_comp_low < str.tonumber(label.get_text(engine.pivotA_LowLabel))
                    engine.ltfCompAssetInvalidatedLow := true
                if engine.ltfMainAssetInvalidatedLow and engine.ltfCompAssetInvalidatedLow
                    label.delete(engine.pivotA_LowLabel), engine.pivotA_LowLabel := na, label.delete(engine.visualPivotA_LowLabel), engine.visualPivotA_LowLabel := na
                    line.delete(engine.ltfLowWatchline), engine.ltfLowWatchline := na, label.delete(engine.ltfLowLabel), engine.ltfLowLabel := na
            
            int ltf_main_high_time = engine.ltfSessionHighTime[1], int ltf_main_low_time = engine.ltfSessionLowTime[1]
            if not na(engine.pivotA_HighLabel)
                bool alreadyInvalidated = engine.ltfMainAssetInvalidatedHigh and engine.ltfCompAssetInvalidatedHigh
                if not alreadyInvalidated and (ltf_main_high - label.get_y(engine.pivotA_HighLabel)) * (ltf_comp_high - str.tonumber(label.get_text(engine.pivotA_HighLabel))) < 0 and (na(engine.ltfWatchlineHighPrice) or ltf_main_high > engine.ltfWatchlineHighPrice) and isWithinTimeSession
                    string ltfBaseTextTemplate = "{0} vs {1}\nTimeframe: {2}\nStrength: {3}-{4}\nLTF Detection: {5}"
                    string ltfBaseInfoText = str.format(ltfBaseTextTemplate, syminfo.ticker, shortAssetName, formatTimeframe(engine.htfTimeframe), str.tostring(engine.leftStrength), str.tostring(engine.rightStrength), formatTimeframe(usedLtfTimeframe))
                    line.delete(engine.ltfHighWatchline), label.delete(engine.ltfHighLabel)
                    engine.ltfHighWatchline := line.new(label.get_x(engine.pivotA_HighLabel), label.get_y(engine.pivotA_HighLabel), ltf_main_high_time, ltf_main_high, xloc = xloc.bar_time, style=line.style_dashed, color=engine.highColor, width=1)
                    engine.ltfHighLabel := label.new(ltf_main_high_time, ltf_main_high + y_offset, "SMT Bearish\n" + ltfBaseInfoText + "\nStatus: Unconfirmed", xloc = xloc.bar_time, color=color.new(engine.highColor, 75), textcolor=color.white, style=label.style_label_down, textalign=text.align_left)
                    engine.ltfWatchlineHighPrice := ltf_main_high, engine.ltfMainAssetInvalidatedHigh := false, engine.ltfCompAssetInvalidatedHigh := false
                    if engine.enableAlerts
                        alert("Potential Bearish SMT on SMT TF" + str.tostring(engine.id), alert.freq_once_per_bar)

            if not na(engine.pivotA_LowLabel)
                bool alreadyInvalidated = engine.ltfMainAssetInvalidatedLow and engine.ltfCompAssetInvalidatedLow
                if not alreadyInvalidated and (ltf_main_low - label.get_y(engine.pivotA_LowLabel)) * (ltf_comp_low - str.tonumber(label.get_text(engine.pivotA_LowLabel))) < 0 and (na(engine.ltfWatchlineLowPrice) or ltf_main_low < engine.ltfWatchlineLowPrice) and isWithinTimeSession
                    string ltfBaseTextTemplate = "{0} vs {1}\nTimeframe: {2}\nStrength: {3}-{4}\nLTF Detection: {5}"
                    string ltfBaseInfoText = str.format(ltfBaseTextTemplate, syminfo.ticker, shortAssetName, formatTimeframe(engine.htfTimeframe), str.tostring(engine.leftStrength), str.tostring(engine.rightStrength), formatTimeframe(usedLtfTimeframe))
                    line.delete(engine.ltfLowWatchline), label.delete(engine.ltfLowLabel)
                    engine.ltfLowWatchline := line.new(label.get_x(engine.pivotA_LowLabel), label.get_y(engine.pivotA_LowLabel), ltf_main_low_time, ltf_main_low, xloc = xloc.bar_time, style=line.style_dashed, color=engine.lowColor, width=1)
                    engine.ltfLowLabel := label.new(ltf_main_low_time, ltf_main_low - y_offset, "SMT Bullish\n" + ltfBaseInfoText + "\nStatus: Unconfirmed", xloc = xloc.bar_time, color=color.new(engine.lowColor, 75), textcolor=color.white, style=label.style_label_up, textalign=text.align_left)
                    engine.ltfWatchlineLowPrice := ltf_main_low, engine.ltfMainAssetInvalidatedLow := false, engine.ltfCompAssetInvalidatedLow := false
                    if engine.enableAlerts
                        alert("Potential Bullish SMT on SMT TF" + str.tostring(engine.id), alert.freq_once_per_bar)

    // --- Pivot A Visibility ---
    if not na(engine.visualPivotA_HighLabel)
        label.set_color(engine.visualPivotA_HighLabel, engine.showPivotA ? color.new(engine.highColor, 25) : color.new(color.white, 100))
        label.set_textcolor(engine.visualPivotA_HighLabel, engine.showPivotA ? color.white : color.new(color.white, 100))
    if not na(engine.visualPivotA_LowLabel)
        label.set_color(engine.visualPivotA_LowLabel, engine.showPivotA ? color.new(engine.lowColor, 25) : color.new(color.white, 100))
        label.set_textcolor(engine.visualPivotA_LowLabel, engine.showPivotA ? color.white : color.new(color.white, 100))

// =============================================================================
// ENGINE CONSTRUCTOR
// =============================================================================

// Constructor function to initialize a new SmtEngine object.
newSmtEngine(int id, bool enabled, string htf, int left, int right, color highColor, color lowColor, bool enableLtf, string ltf, bool alerts, bool showA, bool showPivots) =>
    SmtEngine.new(
         id = id,
         enabled = enabled,
         htfTimeframe = htf,
         leftStrength = left,
         rightStrength = right,
         highColor = highColor,
         lowColor = lowColor,
         enableLtfDetection = enableLtf,
         ltfTimeframe = ltf,
         enableAlerts = alerts,
         showPivotA = showA,
         showPivots = showPivots,
         
         // Initialize state variables
         sessionHigh = high,
         sessionLow = low,
         sessionHighTime = time,
         sessionLowTime = time,
         historyHighs = array.new_float(),
         historyLows = array.new_float(),
         historyTimesHigh = array.new_int(),
         historyTimesLow = array.new_int(),
         compHistoryHighs = array.new_float(),
         compHistoryLows = array.new_float(),
         
         ltfSessionHigh = high,
         ltfSessionLow = low,
         ltfSessionHighTime = time,
         ltfSessionLowTime = time,
         ltfCompSessionHigh = na,
         ltfCompSessionLow = na,
         ltfMainAssetInvalidatedHigh = false,
         ltfCompAssetInvalidatedHigh = false,
         ltfMainAssetInvalidatedLow = false,
         ltfCompAssetInvalidatedLow = false,
         ltfWatchlineHighPrice = na,
         ltfWatchlineLowPrice = na,
         
         pivotA_HighLabel = na,
         pivotA_LowLabel = na,
         
         visualPivotA_HighLabel = na,
         visualPivotA_LowLabel = na,
         ltfHighWatchline = na,
         ltfHighLabel = na,
         ltfLowWatchline = na,
         ltfLowLabel = na,
         pivotLabels = array.new_label(),
         confirmedLines = array.new_line(),
         confirmedLabels = array.new_label()
     )

// =============================================================================
// MAIN LOGIC
// =============================================================================

// Initialize all 12 SMT engine instances in an array.
var SmtEngine[] smtEngines = array.from(
     newSmtEngine(1, enableTF1, timeframeTF1, leftBarsTF1, rightBarsTF1, phColorTF1, plColorTF1, enableLtfTF1, ltfTimeframeTF1, enableAlertsTF1, showPivotATF1, showPivotsTF1),
     newSmtEngine(2, enableTF2, timeframeTF2, leftBarsTF2, rightBarsTF2, phColorTF2, plColorTF2, enableLtfTF2, ltfTimeframeTF2, enableAlertsTF2, showPivotATF2, showPivotsTF2),
     newSmtEngine(3, enableTF3, timeframeTF3, leftBarsTF3, rightBarsTF3, phColorTF3, plColorTF3, enableLtfTF3, ltfTimeframeTF3, enableAlertsTF3, showPivotATF3, showPivotsTF3),
     newSmtEngine(4, enableTF4, timeframeTF4, leftBarsTF4, rightBarsTF4, phColorTF4, plColorTF4, enableLtfTF4, ltfTimeframeTF4, enableAlertsTF4, showPivotATF4, showPivotsTF4),
     newSmtEngine(5, enableTF5, timeframeTF5, leftBarsTF5, rightBarsTF5, phColorTF5, plColorTF5, enableLtfTF5, ltfTimeframeTF5, enableAlertsTF5, showPivotATF5, showPivotsTF5),
     newSmtEngine(6, enableTF6, timeframeTF6, leftBarsTF6, rightBarsTF6, phColorTF6, plColorTF6, enableLtfTF6, ltfTimeframeTF6, enableAlertsTF6, showPivotATF6, showPivotsTF6),
     newSmtEngine(7, enableTF7, timeframeTF7, leftBarsTF7, rightBarsTF7, phColorTF7, plColorTF7, enableLtfTF7, ltfTimeframeTF7, enableAlertsTF7, showPivotATF7, showPivotsTF7),
     newSmtEngine(8, enableTF8, timeframeTF8, leftBarsTF8, rightBarsTF8, phColorTF8, plColorTF8, enableLtfTF8, ltfTimeframeTF8, enableAlertsTF8, showPivotATF8, showPivotsTF8),
     newSmtEngine(9, enableTF9, timeframeTF9, leftBarsTF9, rightBarsTF9, phColorTF9, plColorTF9, enableLtfTF9, ltfTimeframeTF9, enableAlertsTF9, showPivotATF9, showPivotsTF9),
     newSmtEngine(10, enableTF10, timeframeTF10, leftBarsTF10, rightBarsTF10, phColorTF10, plColorTF10, enableLtfTF10, ltfTimeframeTF10, enableAlertsTF10, showPivotATF10, showPivotsTF10),
     newSmtEngine(11, enableTF11, timeframeTF11, leftBarsTF11, rightBarsTF11, phColorTF11, plColorTF11, enableLtfTF11, ltfTimeframeTF11, enableAlertsTF11, showPivotATF11, showPivotsTF11),
     newSmtEngine(12, enableTF12, timeframeTF12, leftBarsTF12, rightBarsTF12, phColorTF12, plColorTF12, enableLtfTF12, ltfTimeframeTF12, enableAlertsTF12, showPivotATF12, showPivotsTF12)
 )

// Main loop to process each enabled SMT engine.
for engine in smtEngines
    if engine.enabled and engine.htfTimeframe != ''
        is_new_htf_bar = collectHistory(engine)
        processSmtLogic(engine, is_new_htf_bar)
    else
        cleanupSmtDrawings(engine)
