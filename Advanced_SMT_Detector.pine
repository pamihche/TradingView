//@version=6
// -----------------------------------------------------------------------------
// Title:         Advanced SMT Detector (12 Timeframes)
// Author:        Nick (Architected by Jules)
// Version:       1.0.0
// Description:   A comprehensive, multi-timeframe SMT detector that tracks
//                divergences across 12 user-configurable timeframes, from
//                1 minute to weekly. Built with a reusable engine for
//                maximum efficiency and maintainability.
// -----------------------------------------------------------------------------

import TradingView/ta/6 as ta

indicator('Advanced SMT Detector', 'SMT Advanced', overlay = true, max_labels_count=500, max_lines_count=500)

// =============================================================================
// TYPE DEFINITIONS
// =============================================================================

// --- Custom Types for Hierarchical Swings ---
type ICTMS
    float   lastPrice
    float   midPrice
    float   prevPrice
    float   lastCompPrice
    float   midCompPrice
    float   prevCompPrice
    int     lastIndex
    int     midIndex
    int     prevIndex

// Holds all the configuration and state for a single SMT timeframe engine.
type SmtTimeframe
    // -- Configuration --
    int id
    bool enabled
    string timeframe
    color bullColor
    color bearColor

    // -- Swing State --
    ICTMS stHigh
    ICTMS stLow
    ICTMS itHigh
    ICTMS itLow
    ICTMS ltHigh
    ICTMS ltLow

    // -- Drawing Management --
    array<line> smtLines
    array<label> smtLabels
    array<label> debugLabels

// =============================================================================
// INPUTS
// =============================================================================
string GRP_TIME_FILTER = "Time Session Filter"
sessionTimezone = input.string("America/New_York", "Session Timezone", group = GRP_TIME_FILTER, tooltip = "Specify the timezone for the session filters. Examples: 'America/New_York', 'Europe/London', 'Etc/UTC'.")
enableTimeFilter1 = input.bool(false, "Enable Session Filter 1", group = GRP_TIME_FILTER, tooltip="If checked, the indicator will only plot SMT signals within this specified trading session.")
timeSession1 = input.session("0800-1200", "Trading Session 1", group = GRP_TIME_FILTER, tooltip="Define the time window for plotting SMTs. Format is HHMM-HHMM.")
enableTimeFilter2 = input.bool(false, "Enable Session Filter 2", group = GRP_TIME_FILTER, tooltip="If checked, the indicator will only plot SMT signals within this specified trading session.")
timeSession2 = input.session("1300-1700", "Trading Session 2", group = GRP_TIME_FILTER, tooltip="Define the time window for plotting SMTs. Format is HHMM-HHMM.")
enableTimeFilter3 = input.bool(false, "Enable Session Filter 3", group = GRP_TIME_FILTER, tooltip="If checked, the indicator will only plot SMT signals within this specified trading session.")
timeSession3 = input.session("0000-0700", "Trading Session 3", group = GRP_TIME_FILTER, tooltip="Define the time window for plotting SMTs. Format is HHMM-HHMM.")

string GRP_MASTER_ASSET = "Comparison Asset"
masterComparisonAsset = input.symbol("CME_MINI:ES1!", "Asset", group = GRP_MASTER_ASSET, tooltip = "Select the second asset to compare against the main chart's asset for detecting SMT.")

string GRP_DEBUG = "Debug Settings"
showPivotsDebug = input.bool(true, "Show Pivots (Debug)", group = GRP_DEBUG, tooltip = "Toggles the visibility of the underlying swing point markers. Useful for debugging the SMT logic.")

// --- Timeframe 1: Weekly ---
