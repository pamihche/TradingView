//@version=6
// -----------------------------------------------------------------------------
// Title:         Simple SMT Indicator (v6, Truly Final Version)
// Author:        Nick 
// Version:       1.6.0
// Description:   A simplified, single-engine version using Pine Script v6.
//                This version fixes all known syntax and runtime errors.
// -----------------------------------------------------------------------------
import TradingView/ta/6 as ta

indicator('Simple SMT (v6, Final)', 'SMT', overlay = true, max_labels_count=500, max_lines_count=500)

// =============================================================================
// INPUTS
// =============================================================================
string GRP_ASSET = "1. Comparison Asset"
masterComparisonAsset = input.symbol("CME_MINI_DL:ES1!", "Asset", group = GRP_ASSET)

string GRP_SMT = "2. SMT Settings"
enableSMT = input.bool(true, "Enable SMT Detection", group = GRP_SMT)
timeframeInput = input.timeframe('60', 'Higher Timeframe (HTF)', group = GRP_SMT)
leftBars = input.int(1, 'Pivot Left Strength', group = GRP_SMT, minval = 1)
rightBars = input.int(1, 'Pivot Right Strength', group = GRP_SMT, minval = 1)

string GRP_LTF = "3. Early Detection (LTF) Settings"
enableEarlySmtDetection = input.bool(true, "Enable LTF Detection", group = GRP_LTF)
intradayTimeframe = input.timeframe('5', "Lower Timeframe (LTF)", group = GRP_LTF)

string GRP_VISUALS = "4. Visual Settings"
showPivotALabel = input.bool(true, "Show Pivot 'A' Label", group = GRP_VISUALS)
showPivotCrosses = input.bool(true, 'Show All HTF Pivots', group = GRP_VISUALS)
phColor = input.color(color.red, "Bearish Color", group = GRP_VISUALS)
plColor = input.color(color.green, "Bullish Color", group = GRP_VISUALS)

string GRP_TIME_FILTER = "5. Time Session Filter (Optional)"
enableTimeFilter = input.bool(false, "Enable Session Filter", group = GRP_TIME_FILTER)
timeSession = input.session("0800-1700", "Trading Session", group = GRP_TIME_FILTER)
sessionTimezone = input.string("America/New_York", "Session Timezone", group = GRP_TIME_FILTER)


// =============================================================================
// FUNCTIONS
// =============================================================================
isWithinSession() =>
    not enableTimeFilter or (enableTimeFilter and not na(time(timeframe.period, timeSession, sessionTimezone)))

getTicker(symbolString) =>
    str.contains(symbolString, ":") ? str.substring(symbolString, str.pos(symbolString, ":") + 1, str.length(symbolString)) : symbolString

formatTimeframe(string tf) =>
    var result = tf
    float tf_minutes = str.tonumber(tf)
    if not na(tf_minutes)
        if tf_minutes >= 60 and tf_minutes % 60 == 0
            result := str.tostring(int(tf_minutes / 60)) + 'H'
        else
            result := str.tostring(int(tf_minutes)) + 'M'
    result

checkForPivot(array<float> history, int pivot_idx, int left_strength, int right_strength, bool is_high) =>
    is_pivot = true
    if array.size(history) < left_strength + right_strength + 1 or pivot_idx < left_strength or pivot_idx > array.size(history) - 1 - right_strength
        is_pivot := false
    else
        pivot_price = array.get(history, pivot_idx)
        for i = 0 to left_strength + right_strength
            if i != left_strength
                neighbor_price = array.get(history, pivot_idx - left_strength + i)
                if is_high and neighbor_price >= pivot_price
                    is_pivot := false
                    break
                if not is_high and neighbor_price <= pivot_price
                    is_pivot := false
                    break
    is_pivot

drawPivotCross(int bar_time, float price, color p_color) =>
    label.new(bar_time, price, xloc=xloc.bar_time, style=label.style_xcross, color=p_color, size=size.tiny)

// =============================================================================
// SMT LOGIC
// =============================================================================
bool isHistoryCollectionActive = enableSMT and timeframeInput != ''
bool is_new_htf_bar = isHistoryCollectionActive and (nz(ta.change(time(timeframeInput))) != 0)
bool isHtfChartTimeframeValid = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(timeframeInput)
bool isSmtLogicActive = isHtfChartTimeframeValid and isHistoryCollectionActive and enableSMT and masterComparisonAsset != ""

var float session_high = high, var float session_low = low
var int session_high_time = time, var int session_low_time = time
var array<float> history_highs = array.new_float(), var array<float> history_lows = array.new_float()
var array<int> history_times_high = array.new_int(), var array<int> history_times_low = array.new_int()
var array<float> comp_history_highs = array.new_float(), var array<float> comp_history_lows = array.new_float()

var label pivotA_HighLabel = na, var label visualPivotA_HighLabel = na
var label pivotA_LowLabel = na, var label visualPivotA_LowLabel = na
var line intraDayHighWatchline = na, var line intraDayLowWatchline = na
var bool ltfMainAssetInvalidatedHigh = false, var bool ltfCompAssetInvalidatedHigh = false
var bool ltfMainAssetInvalidatedLow = false, var bool ltfCompAssetInvalidatedLow = false

if isSmtLogicActive
    // History Collection
    if is_new_htf_bar
        session_high := high
        session_low := low
        session_high_time := time
        session_low_time := time
    else
        if high >= session_high
            session_high := high
            session_high_time := time
        if low <= session_low
            session_low := low
            session_low_time := time
    
    if is_new_htf_bar
        array.push(history_highs, session_high[1])
        array.push(history_times_high, session_high_time[1])
        array.push(history_lows, session_low[1])
        array.push(history_times_low, session_low_time[1])
        float comp_high = request.security(masterComparisonAsset, timeframeInput, high[1], lookahead=barmerge.lookahead_on)
        float comp_low = request.security(masterComparisonAsset, timeframeInput, low[1], lookahead=barmerge.lookahead_on)
        array.push(comp_history_highs, comp_high)
        array.push(comp_history_lows, comp_low)

        if showPivotCrosses
            int pivot_check_index = array.size(history_highs) - 1 - rightBars
            if pivot_check_index >= 0
                if checkForPivot(history_highs, pivot_check_index, leftBars, rightBars, true)
                    drawPivotCross(array.get(history_times_high, pivot_check_index), array.get(history_highs, pivot_check_index), phColor)
                if checkForPivot(history_lows, pivot_check_index, leftBars, rightBars, false)
                    drawPivotCross(array.get(history_times_low, pivot_check_index), array.get(history_lows, pivot_check_index), plColor)

    // SMT Detection Logic
    string shortAssetName = getTicker(masterComparisonAsset)
    float y_offset = ta.atr(14) * 0.1
    
    if is_new_htf_bar
        int pivot_idx = array.size(history_highs) - 1 - rightBars
        if pivot_idx >= 0
            // Bearish HTF SMT
            bool is_main_pivot_high = checkForPivot(history_highs, pivot_idx, leftBars, rightBars, true)
            bool is_comp_pivot_high = checkForPivot(comp_history_highs, pivot_idx, leftBars, rightBars, true)
            if is_main_pivot_high and is_comp_pivot_high
                float mainHtfPivotHigh = array.get(history_highs, pivot_idx)
                float compHtfPivotHigh = array.get(comp_history_highs, pivot_idx)
                int smt_main_pivot_time = array.get(history_times_high, pivot_idx)
                if not na(pivotA_HighLabel) and (mainHtfPivotHigh - label.get_y(pivotA_HighLabel)) * (compHtfPivotHigh - str.tonumber(label.get_text(pivotA_HighLabel))) < 0
                    if isWithinSession()
                        string baseInfoText = str.format("{0} vs {1}\nTF: {2} | Str: {3}-{4}", syminfo.ticker, shortAssetName, formatTimeframe(timeframeInput), str.tostring(leftBars), str.tostring(rightBars))
                        line.new(label.get_x(pivotA_HighLabel), label.get_y(pivotA_HighLabel), smt_main_pivot_time, mainHtfPivotHigh, xloc = xloc.bar_time, color=color.new(phColor, 40), width=2)
                        label.new(smt_main_pivot_time, mainHtfPivotHigh + y_offset, "SMT Bearish\n" + baseInfoText, xloc = xloc.bar_time, color=color.new(phColor, 75), textcolor=color.white, style=label.style_label_down, textalign=text.align_left)
                
                label.delete(pivotA_HighLabel)
                label.delete(visualPivotA_HighLabel)
                line.delete(intraDayHighWatchline)
                pivotA_HighLabel := label.new(smt_main_pivot_time, mainHtfPivotHigh, str.tostring(compHtfPivotHigh), xloc = xloc.bar_time, style=label.style_none, textcolor=color.new(color.white, 100))
                visualPivotA_HighLabel := label.new(smt_main_pivot_time, mainHtfPivotHigh + y_offset, "A", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(phColor, 25), textcolor=color.white, size=size.small)
                ltfMainAssetInvalidatedHigh := false
                ltfCompAssetInvalidatedHigh := false
            
            // Bullish HTF SMT
            bool is_main_pivot_low = checkForPivot(history_lows, pivot_idx, leftBars, rightBars, false)
            bool is_comp_pivot_low = checkForPivot(comp_history_lows, pivot_idx, leftBars, rightBars, false)
            if is_main_pivot_low and is_comp_pivot_low
                float mainHtfPivotLow = array.get(history_lows, pivot_idx)
                float compHtfPivotLow = array.get(comp_history_lows, pivot_idx)
                int smt_main_pivot_time = array.get(history_times_low, pivot_idx)
                if not na(pivotA_LowLabel) and (mainHtfPivotLow - label.get_y(pivotA_LowLabel)) * (compHtfPivotLow - str.tonumber(label.get_text(pivotA_LowLabel))) < 0
                    if isWithinSession()
                        string baseInfoText = str.format("{0} vs {1}\nTF: {2} | Str: {3}-{4}", syminfo.ticker, shortAssetName, formatTimeframe(timeframeInput), str.tostring(leftBars), str.tostring(rightBars))
                        line.new(label.get_x(pivotA_LowLabel), label.get_y(pivotA_LowLabel), smt_main_pivot_time, mainHtfPivotLow, xloc = xloc.bar_time, color=color.new(plColor, 40), width=2)
                        label.new(smt_main_pivot_time, mainHtfPivotLow - y_offset, "SMT Bullish\n" + baseInfoText, xloc = xloc.bar_time, color=color.new(plColor, 75), textcolor=color.white, style=label.style_label_up, textalign=text.align_left)

                label.delete(pivotA_LowLabel)
                label.delete(visualPivotA_LowLabel)
                line.delete(intraDayLowWatchline)
                pivotA_LowLabel := label.new(smt_main_pivot_time, mainHtfPivotLow, str.tostring(compHtfPivotLow), xloc = xloc.bar_time, style=label.style_none, textcolor=color.new(color.white, 100))
                visualPivotA_LowLabel := label.new(smt_main_pivot_time, mainHtfPivotLow - y_offset, "A", xloc=xloc.bar_time, style=label.style_label_up, color=color.new(plColor, 25), textcolor=color.white, size=size.small)
                ltfMainAssetInvalidatedLow := false
                ltfCompAssetInvalidatedLow := false


    // LTF (Unconfirmed) Logic
    if enableEarlySmtDetection and intradayTimeframe != '' and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(intradayTimeframe)
        if nz(ta.change(time(intradayTimeframe))) != 0
            float ltf_main_high = high[1]
            float ltf_main_low = low[1]
            [intra_comp_high, intra_comp_low] = request.security(masterComparisonAsset, intradayTimeframe, [high[1], low[1]], lookahead=barmerge.lookahead_off)
            int ltf_main_time = time[1]

            if not na(pivotA_HighLabel)
                if not ltfMainAssetInvalidatedHigh and ltf_main_high > label.get_y(pivotA_HighLabel)
                    ltfMainAssetInvalidatedHigh := true
                if not ltfCompAssetInvalidatedHigh and intra_comp_high > str.tonumber(label.get_text(pivotA_HighLabel))
                    ltfCompAssetInvalidatedHigh := true
                
                if ltfMainAssetInvalidatedHigh and ltfCompAssetInvalidatedHigh
                    label.delete(pivotA_HighLabel)
                    pivotA_HighLabel := na
                    label.delete(visualPivotA_HighLabel)
                    visualPivotA_HighLabel := na
                    line.delete(intraDayHighWatchline)
                    intraDayHighWatchline := na
                else if (ltf_main_high - label.get_y(pivotA_HighLabel)) * (intra_comp_high - str.tonumber(label.get_text(pivotA_HighLabel))) < 0
                    if isWithinSession()
                        line.delete(intraDayHighWatchline)
                        intraDayHighWatchline := line.new(label.get_x(pivotA_HighLabel), label.get_y(pivotA_HighLabel), ltf_main_time, ltf_main_high, xloc=xloc.bar_time, style=line.style_dashed, color=phColor)
            
            if not na(pivotA_LowLabel)
                if not ltfMainAssetInvalidatedLow and ltf_main_low < label.get_y(pivotA_LowLabel)
                    ltfMainAssetInvalidatedLow := true
                if not ltfCompAssetInvalidatedLow and intra_comp_low < str.tonumber(label.get_text(pivotA_LowLabel))
                    ltfCompAssetInvalidatedLow := true
                
                if ltfMainAssetInvalidatedLow and ltfCompAssetInvalidatedLow
                    label.delete(pivotA_LowLabel)
                    pivotA_LowLabel := na
                    label.delete(visualPivotA_LowLabel)
                    visualPivotA_LowLabel := na
                    line.delete(intraDayLowWatchline)
                    intraDayLowWatchline := na
                else if (ltf_main_low - label.get_y(pivotA_LowLabel)) * (intra_comp_low - str.tonumber(label.get_text(pivotA_LowLabel))) < 0
                    if isWithinSession()
                        line.delete(intraDayLowWatchline)
                        intraDayLowWatchline := line.new(label.get_x(pivotA_LowLabel), label.get_y(pivotA_LowLabel), ltf_main_time, ltf_main_low, xloc=xloc.bar_time, style=line.style_dashed, color=plColor)

    // Conditionally show/hide the 'A' labels
    if not na(visualPivotA_HighLabel)
        label.set_color(visualPivotA_HighLabel, showPivotALabel ? color.new(phColor, 25) : na)
        label.set_textcolor(visualPivotA_HighLabel, showPivotALabel ? color.white : na)
    if not na(visualPivotA_LowLabel)
        label.set_color(visualPivotA_LowLabel, showPivotALabel ? color.new(plColor, 25) : na)
        label.set_textcolor(visualPivotA_LowLabel, showPivotALabel ? color.white : na)
else
    // Cleanup if SMT logic is disabled
    label.delete(pivotA_HighLabel)
    pivotA_HighLabel := na
    label.delete(visualPivotA_HighLabel)
    visualPivotA_HighLabel := na
    label.delete(pivotA_LowLabel)
    pivotA_LowLabel := na
    label.delete(visualPivotA_LowLabel)
    visualPivotA_LowLabel := na
    line.delete(intraDayHighWatchline)
    intraDayHighWatchline := na
    line.delete(intraDayLowWatchline)
    intraDayLowWatchline := na
