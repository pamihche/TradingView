enableTF1 = input.bool(false, "Enable", group = GRP_TF1, inline="tf1")
bullColorTF1 = input.color(color.new(#2962FF, 40), "Bullish", group = GRP_TF1, inline="tf1")
bearColorTF1 = input.color(color.new(#E91E63, 40), "Bearish", group = GRP_TF1, inline="tf1")

