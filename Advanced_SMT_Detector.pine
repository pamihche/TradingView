bullColorTF12 = input.color(color.new(#2962FF, 40), "Bullish", group = GRP_TF12, inline="tf12")
bearColorTF12 = input.color(color.new(#E91E63, 40), "Bearish", group = GRP_TF12, inline="tf12")

// =============================================================================
// HIERARCHICAL SWING LOGIC
// =============================================================================

// @function_description Detects a 3-point swing pattern.
// @param price (float) The current price point.
// @param prevPrice (float) The previous price point.
// @param prevPrice2 (float) The price point before the previous one.
// @param isSwingHigh (bool) If true, checks for a swing high; otherwise, checks for a swing low.
// @returns (bool) True if a swing is detected, false otherwise.
queryPatterns(price, prevPrice, prevPrice2, isSwingHigh) =>
    if isSwingHigh
        prevPrice2 < prevPrice and prevPrice >= price
    else
        prevPrice2 > prevPrice and prevPrice <= price

// @function_description Method to query a swing pattern from an ICTMS object.
// @param _this (ICTMS) The ICTMS object instance.
// @param isSwingHigh (bool) If true, checks for a swing high.
// @returns (bool) True if a swing is detected, false otherwise.
method queryPatterns(ICTMS _this, isSwingHigh) =>
    if isSwingHigh
        _this.prevPrice < _this.midPrice and _this.midPrice >= _this.lastPrice
    else
        _this.prevPrice > _this.midPrice and _this.midPrice <= _this.lastPrice

// @function_description Method to update the state of an ICTMS object with a new swing point.
// @param _this (ICTMS) The ICTMS object instance.
// @param price (float) The price of the new swing point on the main asset.
// @param compPrice (float) The price of the new swing point on the comparison asset.
// @param index (int) The bar index of the new swing point.
method updatePattern(ICTMS _this, price, compPrice, index) =>
    _this.prevPrice := _this.midPrice
    _this.midPrice := _this.lastPrice
    _this.lastPrice := price
    _this.prevCompPrice := _this.midCompPrice
    _this.midCompPrice := _this.lastCompPrice
    _this.lastCompPrice := compPrice
    _this.prevIndex := _this.midIndex
    _this.midIndex := _this.lastIndex
    _this.lastIndex := index


// =============================================================================
// CONSTANTS & GENERAL FUNCTIONS
// =============================================================================
int MAX_DRAWING_OBJECTS = 500
int MAX_HISTORY_SIZE = 500

isWithinAnySession() =>
    anyFilterEnabled = enableTimeFilter1 or enableTimeFilter2 or enableTimeFilter3
    if not anyFilterEnabled
        true
    else
        inSession1 = enableTimeFilter1 and not na(time(timeframe.period, timeSession1, sessionTimezone))
        inSession2 = enableTimeFilter2 and not na(time(timeframe.period, timeSession2, sessionTimezone))
        inSession3 = enableTimeFilter3 and not na(time(timeframe.period, timeSession3, sessionTimezone))
        inSession1 or inSession2 or inSession3

getTicker(string symbolString) =>
    str.contains(symbolString, ":") ? str.substring(symbolString, str.pos(symbolString, ":") + 1, str.length(symbolString)) : symbolString

formatTimeframe(string tf) =>
    var result = tf
    float tf_minutes = str.tonumber(tf)
    if not na(tf_minutes)
        if tf_minutes >= 60 and tf_minutes % 60 == 0
            result := str.tostring(int(tf_minutes / 60)) + 'H'
        else
            result := str.tostring(int(tf_minutes)) + 'M'
    result

cleanupEngineDrawings(SmtTimeframe engine) =>
    for l in engine.smtLines
        line.delete(l)
    array.clear(engine.smtLines)
    for l in engine.smtLabels
        label.delete(l)
    array.clear(engine.smtLabels)

// =============================================================================
// DRAWING FUNCTIONS
// =============================================================================

// @function_description Draws the SMT lines and labels on the chart.
// @param engine (SmtTimeframe) The engine instance containing state and settings.
// @param p1_index (int) The bar index of the first pivot.
// @param p1_price (float) The price of the first pivot.
// @param p2_index (int) The bar index of the second pivot.
// @param p2_price (float) The price of the second pivot.
// @param smtType (string) The type of SMT ("Regular" or "Momentum").
// @param isBullish (bool) True for a bullish SMT, false for a bearish one.
drawSmt(SmtTimeframe engine, int p1_index, float p1_price, int p2_index, float p2_price, string smtType, bool isBullish) =>
    int MAX_SMT_DRAWINGS_PER_ENGINE = 50
    lineStyle = smtType == "Regular" ? line.style_solid : line.style_dashed
    lineWidth = smtType == "Regular" ? 2 : 1
    lineColor = isBullish ? engine.bullColor : engine.bearColor

    // Create the SMT line
    newLine = line.new(p1_index, p1_price, p2_index, p2_price, xloc=xloc.bar_index, color=lineColor, style=lineStyle, width=lineWidth)
    array.push(engine.smtLines, newLine)

    // Create the SMT label
    labelText = str.format("{0} {1} SMT", formatTimeframe(engine.timeframe), smtType)
    labelStyle = isBullish ? label.style_label_up : label.style_label_down
    newLabel = label.new(p2_index, p2_price, text=labelText, xloc=xloc.bar_index, yloc=yloc.price, color=lineColor, textcolor=color.white, style=labelStyle, size=size.small)
    array.push(engine.smtLabels, newLabel)

    // Garbage Collection
    if array.size(engine.smtLines) > MAX_SMT_DRAWINGS_PER_ENGINE
        line.delete(array.shift(engine.smtLines))

    if array.size(engine.smtLabels) > MAX_SMT_DRAWINGS_PER_ENGINE
        label.delete(array.shift(engine.smtLabels))

// =============================================================================
// CORE ENGINE FUNCTIONS
// =============================================================================

// This section will be rebuilt with the new data pipeline and SMT logic.

// =============================================================================
// ENGINE CONSTRUCTOR & INITIALIZATION
// =============================================================================

// Constructor function to initialize a new SmtTimeframe object.
newSmtTimeframe(int id, bool enabled, string timeframe, color bullColor, color bearColor) =>
    SmtTimeframe.new(
         id = id,
         enabled = enabled,
         timeframe = timeframe,
         bullColor = bullColor,
         bearColor = bearColor,
         
         // Initialize swing state
         stHigh = ICTMS.new(),
         stLow = ICTMS.new(),
         itHigh = ICTMS.new(),
         itLow = ICTMS.new(),
         ltHigh = ICTMS.new(),
         ltLow = ICTMS.new(),
         
         // Initialize drawing management arrays
         smtLines = array.new_line(),
         smtLabels = array.new_label(),
         debugLabels = array.new_label()
     )

// =============================================================================
// MAIN LOGIC
// =============================================================================

// Initialize all 12 SMT engine instances in an array.
var smtTimeframes = array.from(newSmtTimeframe(1, enableTF1, 'W', bullColorTF1, bearColorTF1), newSmtTimeframe(2, enableTF2, 'D', bullColorTF2, bearColorTF2), newSmtTimeframe(3, enableTF3, '240', bullColorTF3, bearColorTF3), newSmtTimeframe(4, enableTF4, '60', bullColorTF4, bearColorTF4), newSmtTimeframe(5, enableTF5, '90', bullColorTF5, bearColorTF5), newSmtTimeframe(6, enableTF6, '30', bullColorTF6, bearColorTF6), newSmtTimeframe(7, enableTF7, '15', bullColorTF7, bearColorTF7), newSmtTimeframe(8, enableTF8, '10', bullColorTF8, bearColorTF8), newSmtTimeframe(9, enableTF9, '5', bullColorTF9, bearColorTF9), newSmtTimeframe(10, enableTF10, '3', bullColorTF10, bearColorTF10), newSmtTimeframe(11, enableTF11, '1', bullColorTF11, bearColorTF11), newSmtTimeframe(12, enableTF12, '240', bullColorTF12, bearColorTF12))

// Main processing loop
for engine in smtTimeframes
    if engine.enabled
        // Fetch HTF data for both assets. This is the core of the accurate data pipeline.
        [htf_main_open, htf_main_high, htf_main_low, htf_main_close] = request.security(syminfo.tickerid, engine.timeframe, [open, high, low, close], lookahead=barmerge.lookahead_off)
        [htf_comp_open, htf_comp_high, htf_comp_low, htf_comp_close] = request.security(masterComparisonAsset, engine.timeframe, [open, high, low, close], lookahead=barmerge.lookahead_off)

        // Check for a new bar on the engine's timeframe
        is_new_htf_bar = ta.change(time(engine.timeframe)) != 0

        // --- Momentum SMT (1-candle divergence) ---
        if (htf_main_low - htf_main_low[1]) * (htf_comp_low - htf_comp_low[1]) < 0
            drawSmt(engine, bar_index[1], htf_main_low[1], bar_index, htf_main_low, "Momentum", true)
        if (htf_main_high - htf_main_high[1]) * (htf_comp_high - htf_comp_high[1]) < 0
            drawSmt(engine, bar_index[1], htf_main_high[1], bar_index, htf_main_high, "Momentum", false)

        if is_new_htf_bar
            // --- Hierarchical Swing Detection on HTF Data ---

            // Short-Term Swings
            if queryPatterns(htf_main_low, htf_main_low[1], htf_main_low[2], false)
                engine.stLow.updatePattern(htf_main_low[1], htf_comp_low[1], time[1])
                if showPivotsDebug
                    array.push(engine.debugLabels, label.new(engine.stLow.lastIndex, engine.stLow.lastPrice, 'S', yloc=yloc.belowbar, color=color(na), textcolor=engine.bearColor, style=label.style_label_up, size=size.tiny))
                // Momentum SMT Check (Short-Term)
                if not na(engine.stLow.prevPrice) and (engine.stLow.lastPrice - engine.stLow.prevPrice) * (engine.stLow.lastCompPrice - engine.stLow.prevCompPrice) < 0
                    drawSmt(engine, engine.stLow.prevIndex, engine.stLow.prevPrice, engine.stLow.lastIndex, engine.stLow.lastPrice, "Momentum", true)

            if queryPatterns(htf_main_high, htf_main_high[1], htf_main_high[2], true)
                engine.stHigh.updatePattern(htf_main_high[1], htf_comp_high[1], time[1])
                if showPivotsDebug
                    array.push(engine.debugLabels, label.new(engine.stHigh.lastIndex, engine.stHigh.lastPrice, 'S', yloc=yloc.abovebar, color=color(na), textcolor=engine.bullColor, style=label.style_label_down, size=size.tiny))
                // Momentum SMT Check (Short-Term)
                if not na(engine.stHigh.prevPrice) and (engine.stHigh.lastPrice - engine.stHigh.prevPrice) * (engine.stHigh.lastCompPrice - engine.stHigh.prevCompPrice) < 0
                    drawSmt(engine, engine.stHigh.prevIndex, engine.stHigh.prevPrice, engine.stHigh.lastIndex, engine.stHigh.lastPrice, "Momentum", false)

            // Intermediate-Term Swings & SMT Detection
            cITL = engine.stLow.queryPatterns(false)
            if cITL and cITL != cITL[1]
                engine.itLow.updatePattern(engine.stLow.midPrice, engine.stLow.midCompPrice, engine.stLow.midIndex)
                if showPivotsDebug
                    array.push(engine.debugLabels, label.new(engine.itLow.lastIndex, engine.itLow.lastPrice, 'I', yloc=yloc.belowbar, color=color(na), textcolor=engine.bearColor, style=label.style_label_up, size=size.small))

                // Regular SMT Check
                if not na(engine.itLow.prevPrice) and (engine.itLow.lastPrice - engine.itLow.prevPrice) * (engine.itLow.lastCompPrice - engine.itLow.prevCompPrice) < 0
                    drawSmt(engine, engine.itLow.prevIndex, engine.itLow.prevPrice, engine.itLow.lastIndex, engine.itLow.lastPrice, "Regular", true)


            cITH = engine.stHigh.queryPatterns(true)
            if cITH and cITH != cITH[1]
                engine.itHigh.updatePattern(engine.stHigh.midPrice, engine.stHigh.midCompPrice, engine.stHigh.midIndex)
                if showPivotsDebug
                    array.push(engine.debugLabels, label.new(engine.itHigh.lastIndex, engine.itHigh.lastPrice, 'I', yloc=yloc.abovebar, color=color(na), textcolor=engine.bullColor, style=label.style_label_down, size=size.small))

                // Regular SMT Check
                if not na(engine.itHigh.prevPrice) and (engine.itHigh.lastPrice - engine.itHigh.prevPrice) * (engine.itHigh.lastCompPrice - engine.itHigh.prevCompPrice) < 0
                    drawSmt(engine, engine.itHigh.prevIndex, engine.itHigh.prevPrice, engine.itHigh.lastIndex, engine.itHigh.lastPrice, "Regular", false)


            // Long-Term Swings & SMT Detection
            cLTL = engine.itLow.queryPatterns(false)
            if cLTL and cLTL != cLTL[1]
                engine.ltLow.updatePattern(engine.itLow.midPrice, engine.itLow.midCompPrice, engine.itLow.midIndex)
                if showPivotsDebug
                    array.push(engine.debugLabels, label.new(engine.ltLow.lastIndex, engine.ltLow.lastPrice, 'L', yloc=yloc.belowbar, color=color(na), textcolor=engine.bearColor, style=label.style_label_up, size=size.normal))

                // Regular SMT Check
                if not na(engine.ltLow.prevPrice) and (engine.ltLow.lastPrice - engine.ltLow.prevPrice) * (engine.ltLow.lastCompPrice - engine.ltLow.prevCompPrice) < 0
                    drawSmt(engine, engine.ltLow.prevIndex, engine.ltLow.prevPrice, engine.ltLow.lastIndex, engine.ltLow.lastPrice, "Regular", true)

            cLTH = engine.itHigh.queryPatterns(true)
            if cLTH and cLTH != cLTH[1]
                engine.ltHigh.updatePattern(engine.itHigh.midPrice, engine.itHigh.midCompPrice, engine.itHigh.midIndex)
                if showPivotsDebug
                    array.push(engine.debugLabels, label.new(engine.ltHigh.lastIndex, engine.ltHigh.lastPrice, 'L', yloc=yloc.abovebar, color=color(na), textcolor=engine.bullColor, style=label.style_label_down, size=size.normal))

                // Regular SMT Check
                if not na(engine.ltHigh.prevPrice) and (engine.ltHigh.lastPrice - engine.ltHigh.prevPrice) * (engine.ltHigh.lastCompPrice - engine.ltHigh.prevCompPrice) < 0
                    drawSmt(engine, engine.ltHigh.prevIndex, engine.ltHigh.prevPrice, engine.ltHigh.lastIndex, engine.ltHigh.lastPrice, "Regular", false)

            // --- Garbage Collection for Debug Labels ---
            int MAX_DEBUG_LABELS_PER_ENGINE = 100
            while array.size(engine.debugLabels) > MAX_DEBUG_LABELS_PER_ENGINE
                label.delete(array.shift(engine.debugLabels))
    else
        cleanupEngineDrawings(engine)
