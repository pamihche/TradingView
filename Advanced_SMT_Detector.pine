//@version=6
// -----------------------------------------------------------------------------
// Title:         Advanced SMT Detector (12 Timeframes)
// Author:        Nick (Architected by Jules)
// Version:       1.0.0
// Description:   A comprehensive, multi-timeframe SMT detector that tracks
//                divergences across 12 user-configurable timeframes, from
//                1 minute to weekly. Built with a reusable engine for
//                maximum efficiency and maintainability.
// -----------------------------------------------------------------------------

import TradingView/ta/6 as ta

indicator('Advanced SMT Detector', 'SMT Advanced', overlay = true, max_labels_count=500, max_lines_count=500)

// =============================================================================
// TYPE DEFINITIONS
// =============================================================================

// Holds all the configuration and state for a single SMT timeframe engine.
type SmtEngine
    // -- Configuration (from inputs) --
    int id
    bool enabled
    string htfTimeframe
    int leftStrength
    int rightStrength
    color highColor
    color lowColor
    bool enableLtfDetection
    string ltfTimeframe
    bool enableAlerts
    bool showPivotA
    bool showPivots

    // -- HTF History State --
    float sessionHigh
    float sessionLow
    int sessionHighTime
    int sessionLowTime
    array<float> historyHighs
    array<float> historyLows
    array<int> historyTimesHigh
    array<int> historyTimesLow
    array<float> compHistoryHighs
    array<float> compHistoryLows

    // -- LTF State --
    float ltfSessionHigh
    float ltfSessionLow
    int ltfSessionHighTime
    int ltfSessionLowTime
    float ltfCompSessionHigh
    float ltfCompSessionLow
    bool ltfMainAssetInvalidatedHigh
    bool ltfCompAssetInvalidatedHigh
    bool ltfMainAssetInvalidatedLow
    bool ltfCompAssetInvalidatedLow
    float ltfWatchlineHighPrice
    float ltfWatchlineLowPrice

    // -- SMT Logic State --
    label pivotA_HighLabel
    label pivotA_LowLabel

    // -- Drawing Management --
    label visualPivotA_HighLabel
    label visualPivotA_LowLabel
    line ltfHighWatchline
    label ltfHighLabel
    line ltfLowWatchline
    label ltfLowLabel
    array<label> pivotLabels
    array<line> confirmedLines
    array<label> confirmedLabels

