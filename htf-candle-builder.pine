            //mainAssetRegisteredCandles.last().logPrices()
            secondAssetRegisteredCandles.last().logPrices()    
        // else if (not na(mainAssetRegisteredCandles.last().TEST) )
        //     log.info('UPDATe ' + mainAssetRegisteredCandles.last().TEST )
        //     mainAssetRegisteredCandles.last().logPrices()
        //     secondAssetRegisteredCandles.last().logPrices() 
        // if(sizeMain != sizeSecond or sizeSecond != sizeThird or sizeMain != sizeThird)
        //     log.info('NU E.  -> ' + monitoredTimeFrame + "  " + str.tostring(sizeMain) + "  " + str.tostring(sizeSecond) + "  " + str.tostring(sizeThird))



        // if(na(mainAssetCandle))
        //     continue    
        // //mainAssetCandle.logPrices()

        // mainAssetCandle := arrRegisteredCandles.get(-1) //CandlesMapHolder.getLastRegisteredCandle(CandlesMapHolder.getSymbolKey(monitoredSymbol, "1D") ) 
        // mainAssetCandle.logPrices()

        //log.info("Sym -> " + monitoredSymbol + " timeframe -> " + monitoredTimeFrame + " size -> " + str.tostring(arrRegisteredCandles.size()))   

        //for monitoredSymbol in ARR_MONITORED_ASSETS


startDetectingTimeBasedSmt()






if(timeframe.isminutes and (timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds('30')) and isInRecentFuturesPeriod(2, 'W')) 
    startMonitoringDailySessions()


