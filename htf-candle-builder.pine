indicator("Advanced HTF Candle Builder", overlay=true, max_bars_back = 5000)

// -- CONSTANTS --
const string[] ARR_TIME_FRAMES_TO_MONITOR = array.from(
           '12M', 
         '3M',
         '1M',
           '1W',
           '1D',
          "240", 
           "90", 
           "60", 
          "30", 
           "15",
           "5", 
          "3", 
          "1"
         )

var string firstMonitoredAsset  = 'ES1!'
var string secondMonitoredAsset = 'YM1!'

var arrMonitoredSymbols  = array.new_string()
if(arrMonitoredSymbols.size() == 0)
    if not na(firstMonitoredAsset) and str.length(str.trim(firstMonitoredAsset)) != 0
        arrMonitoredSymbols.push(str.trim(firstMonitoredAsset))
    if not na(secondMonitoredAsset) and str.length(str.trim(secondMonitoredAsset)) != 0
        arrMonitoredSymbols.push(str.trim(secondMonitoredAsset))

