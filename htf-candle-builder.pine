//@version=6
indicator("Advanced HTF Candle Builder", overlay=true, max_bars_back = 5000, max_lines_count = 500)

// -- CONSTANTS --

const string TIMEZONE_NY = "America/New_York"
var int CURRENT_YEAR = year(timenow, TIMEZONE_NY)

const string SESSION_ASIA_KEY   = "AS"
const string SESSION_LONDON_KEY = "LON"
const string SESSION_NY_AM_KEY  = "NYAM"
const string SESSION_NY_PM_KEY  = "NYPM"

const string[] ARR_SESSIONS_KEYS = array.from(SESSION_ASIA_KEY, SESSION_LONDON_KEY, SESSION_NY_AM_KEY, SESSION_NY_PM_KEY)

const string[] ARR_TIME_FRAMES_TO_MONITOR = array.from(
             //'3M',
             '1M',
             '1W',
             '1D',
             "360",             
             "240", 
             "90", 
             "60", 
             "30", 
             "15",
             "5", 
             "3", 
             "1" 
          )

var string firstMonitoredAsset   = 'ES1!'
var string secondMonitoredAsset  = 'YM1!'

const string[] ARR_MONITORED_ASSETS = array.from(firstMonitoredAsset, secondMonitoredAsset) //, 
const string[] ARR_COMBINED_MONITORED_ASSETS  =  array.from(syminfo.ticker, firstMonitoredAsset, secondMonitoredAsset) //array.concat(array.from(syminfo.ticker), ARR_MONITORED_ASSETS)

isNewTradingDay() =>
    timeframe.change('1D')
    
compareTimeFrames(string timeFrame1, string timeFrame2) =>
    sec1   = timeframe.in_seconds(timeFrame1)
    sec2   = timeframe.in_seconds(timeFrame2)
    result = sec1 < sec2 ? -1 : sec1 > sec2 ? 1 : 0

getSymbolTickerId(string symbol) =>
    switch symbol
        "NQ1!" => "CME_MINI:NQ1"
        "ES1!" => "CME_MINI:ES1!" 
        "YM1!" => "CBOT_MINI:YM1!"
        => na

isInRecentFuturesPeriod(_count, unit) =>
    count = _count <= 0 ? 1 : _count

    const int dayMs = 86400000
    const int hourStart = 18
    
    hourNow = hour(timenow, TIMEZONE_NY)
    isBeforeSessionStart = hourNow < 18
    baseNow = timenow - (isBeforeSessionStart ? dayMs : 0)

    int sessionStart = na

    if unit == "D"
        offsetMs = (count - 1) * dayMs
        refTime = baseNow - offsetMs
        y = year(refTime, TIMEZONE_NY)
        m = month(refTime, TIMEZONE_NY)
        d = dayofmonth(refTime, TIMEZONE_NY)

        // if dayofweek(refTime, TIMEZONE_NY) == dayofweek.saturday
        //     d := d + 1  // Move to Sunday
        //     refTime := timestamp(TIMEZONE_NY, y, m, d, hourStart, 0)

        sessionStart := timestamp(TIMEZONE_NY, y, m, d, 18, 0)

    else if unit == "W"
        wd = dayofweek(timenow, TIMEZONE_NY)
        daysBack = wd - 1 + (isBeforeSessionStart ? 1 : 0)
        // if wd == dayofweek.sunday
        //     daysBack := daysBack + 1  // Skip to Sunday (the next valid trading day)
    
        totalDaysBack = (count - 1) * 7 + daysBack
        refTime = timenow - totalDaysBack * dayMs
        y = year(refTime, TIMEZONE_NY)
        m = month(refTime, TIMEZONE_NY)
        d = dayofmonth(refTime, TIMEZONE_NY)
        sessionStart := timestamp(TIMEZONE_NY, y, m, d, 18, 0)
        //log.info(str.format_time(sessionStart , "yyyy-MM-dd HH:mm:ss" , TIMEZONE_NY)  + " weekday -> " + str.tostring(daysBack) )

    else if unit == "M"
        curY = year(timenow, TIMEZONE_NY)
        curM = month(timenow, TIMEZONE_NY)
        shift = isBeforeSessionStart and dayofmonth(timenow, TIMEZONE_NY) == 1 ? 1 : 0
        newM = curM - (count - 1 + shift)
        newY = curY
        while newM < 1
            newM += 12
            newY -= 1
        sessionStart := timestamp(TIMEZONE_NY, newY, newM, 1, 18, 0)

    inPeriod = (time  >= sessionStart )

    // var int barCount = na
    // barCount := na(barCount) or not inPeriod ? 0 : barCount + 1
    // barsAgo = inPeriod ? barCount - 1 : na

    // [inPeriod, barsAgo]

higherTimeFrameHasChanged(string higherTimeFrame) => 
    switch higherTimeFrame
        "360" => timeframe.change('360')
        "240" => timeframe.change('240')
        "90"  => timeframe.change('90')
        "60"  => timeframe.change('60')
        "30"  => timeframe.change('30')
        "15"  => timeframe.change('15')
        "5"   => timeframe.change('5')
        "3"   => timeframe.change('3')
        "1"   => timeframe.change('1')

        "1D"  => timeframe.change('1D')
        "1W"  => timeframe.change('1W')
        "1M"  => timeframe.change('1M')
        "3M"  => timeframe.change('3M')
        "12M" => timeframe.change('12M')

        => false



// -- DATA STRUCTURES --

type Candle
    float openPrice   = 0
    float highPrice   = 0
    float lowPrice    = 0
    float closePrice  = 0
    int openTime      = 0
    int closeTime     = 0
    int barIndex      = 0

    int openBarIndex  = 0
    int highBarIndex  = 0
    int lowBarIndex   = 0
    int closeBarIndex = 0
    
    bool highTaken = false
    bool lowTaken  = false
    //string TEST = na

type SessionCycle
    string Key           = na
    string Name          = na
    string Period        = na
    int StartTimeStamp   = na
    int EndTimeStamp     = na
    Candle FirstCandle   = na
    Candle LastCandle    = na
    Candle HighestCandle = na
    Candle LowestCandle  = na

type Session
    string Name = na
    string Key  = na
    SessionCycle[] Cycles = na

enum SmtType
    TimeBasedBullish    = 'TBU'
    TimeBasedBearish    = 'TBE'
    SessionBasedBullish = 'SBU'
    SessionBasedBearish = 'SBE'
    CycleBasedBullish   = 'CBU'
    CycleBasedBearish   = 'CBE'

type Smt
    SmtType Type      = na
    int StartBarIndex = 0
    float StartPrice  = 0
    int EndBarIndex   = 0
    float EndPrice    = 0

    bool IsValid  = true
    line Line     = na
    label Label   = na
    string LabelText = na

    bool MainPointTaken = false
    bool CorrPointTaken = false
    int CorrAssetIndex  = -1
    int TimeFrame       = 0 // timeframe detection in seconds
    int TimeStamp       = 0
    float MainPointPrice = 0    
    float CorrPointPrice = 0

type CandlesList
    array<Candle> arrCandles

var map<string, CandlesList> CandlesMapHolder = map.new<string, CandlesList>()
var map<string, Session> SessionsMapHolder    = map.new<string, Session>()
var map<SmtType, string> SmtTypeToString      = map.new<SmtType, string>()
var map<string, Smt> SmtMapHolder             = map.new<string, Smt>()

var Candle MainAssetCandle    = Candle.new()  
var Candle SecondAssetCandle  = Candle.new()
var Candle ThirdAssetCandle   = Candle.new()




method getPeriod(Session this) =>
    first = this.Cycles.first()
    last  = this.Cycles.last()
    str.format("{0}-{1}",  array.get(str.split(first.Period, "-"), 0), array.get(str.split(last.Period, "-"), 1))

method isClosed(SessionCycle this) =>
    bool isClosed = (not na(this.LastCandle) ) and this.LastCandle.barIndex > 0 

method isActive(SessionCycle this) =>
    bool isInPeriod = (time >= this.StartTimeStamp and time_close <= this.EndTimeStamp)

method isClosed(Session this) =>
    bool isClosed = (na(this.Cycles) or this.Cycles.size() == 0) ? true : this.Cycles.last().LastCandle.barIndex != 0

method isActive(Session this) =>
    bool isOpen = (na(this.Cycles) or this.Cycles.size() == 0) ? false : time >= this.Cycles.first().StartTimeStamp  and time_close <= this.Cycles.last().EndTimeStamp


method setPrices(Candle this, float openPrice = open, float highPrice = high, float lowPrice = low, float closePrice = close) =>
    this.openPrice  := openPrice
    this.highPrice  := highPrice
    this.lowPrice   := lowPrice
    this.closePrice := closePrice

method setBarIndex(Candle this, int barIndex = bar_index) =>
    this.barIndex := barIndex

method setOpenCloseTime(Candle this, int openTime = time, int closeTime = time_close) =>
    this.openTime  := openTime
    this.closeTime := closeTime

method isBearish(Candle this) =>
    this.openPrice > this.closePrice
method isBullish(Candle this) => 
    this.openPrice < this.closePrice

method getSortingKey(Candle this, sortingOrder = order.ascending) =>
    string candleKey = na
    if not na(this.openTime) and not na(this.openPrice)
        timeKey    = sortingOrder == order.ascending  ? this.openTime  : -this.openTime
        priceKey   = sortingOrder == order.ascending  ? this.openPrice : -this.openPrice
        candleKey := str.tostring(timeKey, "#010") + "_"  + str.tostring(priceKey, "#010.4")
    candleKey

method isEqualTo(Candle this, Candle toCompare) =>
    switch
        nz(this.barIndex)   != nz(toCompare.barIndex)    => false
        nz(this.openTime)   != nz(toCompare.openTime)    => false
        nz(this.openPrice)  != nz(toCompare.openPrice)   => false
        nz(this.highPrice)  != nz(toCompare.highPrice)   => false
        nz(this.lowPrice)   != nz(toCompare.lowPrice)    => false
        nz(this.closePrice) != nz(toCompare.closePrice)  => false
        nz(this.closeTime)  != nz(toCompare.closeTime)   => false
        => true

method hasAllPrices(Candle this) =>
    switch
        nz(this.openPrice) == 0 => false
        nz(this.highPrice) == 0 => false
        nz(this.lowPrice)  == 0 => false
        nz(this.closePrice)== 0 => false
        => true

method logPrices(Candle this) =>
    log.info('O: ' + str.tostring(this.openPrice) + ' H: ' + str.tostring(this.highPrice)  + ' L: ' + str.tostring(this.lowPrice)  + ' C: ' + str.tostring(this.closePrice))

method getSymbolKey(map<string, CandlesList>this, string symbol, string timeFrame) =>
    na(this) ? '' : symbol + '-' + timeFrame

method getRegisteredCandles(map<string, CandlesList>CandlesMapHolder, symbolKey) => 
    CandlesList arrCandlesList = CandlesMapHolder.get(symbolKey)
    na(arrCandlesList) or na(arrCandlesList.arrCandles)?  array.new<Candle>() : arrCandlesList.arrCandles
    
method getLastRegisteredCandles(map<string, CandlesList>this, string symbolKey, int howMany) => 
    CandlesList arrCandlesList = this.get(symbolKey)
    arrLastCandles = array.new<Candle>()

    if not na(arrCandlesList) and not na ( arrCandlesList.arrCandles) and howMany > 0 and  arrCandlesList.arrCandles.size() > 0
        int arrSize     = arrCandlesList.arrCandles.size()
        int actualCount = arrSize - math.min(howMany,arrSize)
        for i =  arrSize -1 to actualCount 
            arrLastCandles.push( arrCandlesList.arrCandles.get(i).copy() )
    arrLastCandles

method getLastRegisteredCandle(map<string, CandlesList>this, string symbolKey) => 
    CandlesList arrCandlesList = this.get(symbolKey)
    Candle lastRegisteredCandle = not na(arrCandlesList) and not na( arrCandlesList.arrCandles) and arrCandlesList.arrCandles.size() > 0 ?  arrCandlesList.arrCandles.last().copy() : na
    //lastRegisteredCandle


method getDeepInstance(Session this) =>
    Session newSession = Session.new(this.Key, this.Name)
    newSession.Cycles := array.new<SessionCycle>()
    for [index, originalCycle] in this.Cycles
        newCycle = SessionCycle.new(Key = originalCycle.Key, Name = originalCycle.Name, Period = originalCycle.Period, FirstCandle = Candle.new(), LastCandle = Candle.new(), HighestCandle = Candle.new(), LowestCandle = Candle.new())

        y = year(time, TIMEZONE_NY)
        m = month(time, TIMEZONE_NY)
        d = dayofmonth(time, TIMEZONE_NY)
        h = hour(time, TIMEZONE_NY) 
        parts = str.split(newCycle.Period, "-")
        startStr = array.get(parts, 0)
        endStr   = array.get(parts, 1)
        sh = int(str.tonumber(str.substring(startStr, 0, 2)))
        sm = int(str.tonumber(str.substring(startStr, 2)))
        eh = int(str.tonumber(str.substring(endStr, 0, 2)))
        em = int(str.tonumber(str.substring(endStr, 2)))
        crossMidnight = (eh < sh) or (eh == sh and em < sm)
        anchorHour = 18    
        anchorTs = timestamp(TIMEZONE_NY, y, m, d, anchorHour, 0)
        anchorTs := time < anchorTs ? timestamp(TIMEZONE_NY, y, m, d - 1, anchorHour, 0) : anchorTs
        ay = year(anchorTs, TIMEZONE_NY)
        am = month(anchorTs, TIMEZONE_NY)
        ad = dayofmonth(anchorTs, TIMEZONE_NY)

        sessionStartsTomorrow = sh < anchorHour
        startDay = ad + (sessionStartsTomorrow ? 1 : 0)
        endDay   = startDay + (crossMidnight ? 1 : 0)

        newCycle.StartTimeStamp := timestamp(TIMEZONE_NY, ay, am, startDay, sh, sm) //timestamp(TIMEZONE_NY, ay, am, ad, sh, sm) //timestamp(TIMEZONE_NY, y, m, d, sh, sm)
        newCycle.EndTimeStamp   := timestamp(TIMEZONE_NY, ay, am, endDay, eh, em) //timestamp(TIMEZONE_NY, ay, am, ad + (crossMidnight ? 1 : 0), eh, em) //timestamp(TIMEZONE_NY, y, m, crossMidnight ? d + 1 : d, eh, em)

        newSession.Cycles.push(newCycle)
    newSession.copy()

method registerCandle(Session this, Candle newCandle, string monitoredSymbol) =>

    for i = this.Cycles.size() - 1 to 0
        SessionCycle sessionCycle =  this.Cycles.get(i)

        if( na(newCandle) or (newCandle.barIndex == 0) or (newCandle.barIndex == sessionCycle.FirstCandle.barIndex) or (newCandle.barIndex == sessionCycle.LastCandle.barIndex) or  (newCandle.barIndex == sessionCycle.HighestCandle.barIndex) or  (newCandle.barIndex == sessionCycle.LowestCandle.barIndex)  )
            break

        if(sessionCycle.isClosed())
            continue

        bool isInPeriod      = newCandle.openTime >= sessionCycle.StartTimeStamp and newCandle.closeTime <= sessionCycle.EndTimeStamp
        bool isFirstInPeriod = newCandle.openTime  == sessionCycle.StartTimeStamp
        bool isLastInPeriod  = newCandle.closeTime == sessionCycle.EndTimeStamp

        if( not isInPeriod )
            continue

        if( isFirstInPeriod )    //and newCandle.isFirstInPeriod(sessionCycle.Period)
            sessionCycle.FirstCandle   := newCandle.copy()
            sessionCycle.HighestCandle := newCandle.copy()
            sessionCycle.LowestCandle  := newCandle.copy()
            this.Cycles.set(i, sessionCycle)
            break

        if( isLastInPeriod )
            sessionCycle.LastCandle := newCandle.copy()

        if( sessionCycle.HighestCandle.highPrice <= newCandle.highPrice )
            sessionCycle.HighestCandle := newCandle.copy()

        if( sessionCycle.LowestCandle.lowPrice >= newCandle.lowPrice )
            sessionCycle.LowestCandle := newCandle.copy()

        this.Cycles.set(i, sessionCycle)               
        break



method getAssetSessionKey(map<string, Session> this, string monitoredSymbol, string sessionKey) =>
    not(na(this)) ? monitoredSymbol + '-'+ sessionKey : ''

method handleSessions(map<string, Session> this) =>
    
    var canProcessData = false

    if( isNewTradingDay() )

        this.clear()
        //canProcessData := isInRecentFuturesPeriod(1, 'W')
        canProcessData := true

        AsiaSession = Session.new(SESSION_ASIA_KEY, 'Asia', Cycles = array.from(
             SessionCycle.new("SESSION_ASIA_1", 'C1', "1800-1900"),
             SessionCycle.new("SESSION_ASIA_2", 'C1', "1900-2030"),
             SessionCycle.new("SESSION_ASIA_3", 'C1', "2030-2200"),
             SessionCycle.new("SESSION_ASIA_4", 'C1', "2200-2330"),
             SessionCycle.new("SESSION_ASIA_5", 'C1', "2330-0100"),
             SessionCycle.new("SESSION_ASIA_6", 'C1', "0100-0230")
         ))

        LondonSession = Session.new(SESSION_LONDON_KEY, 'London', array.from(
             SessionCycle.new("SESSION_LONDON_1", 'C1', "0230-0400"),
             SessionCycle.new("SESSION_LONDON_2", 'C1', "0400-0530"),
             SessionCycle.new("SESSION_LONDON_3", 'C1', "0530-0700")
         ))

        NYAMSession = Session.new(SESSION_NY_AM_KEY, 'NYAM', array.from(
             SessionCycle.new("SESSION_NY_AM_1", 'C1', "0700-0830"),
             SessionCycle.new("SESSION_NY_AM_2", 'C1', "0830-1000"),
             SessionCycle.new("SESSION_NY_AM_3", 'C1', "1000-1130")
         ))

        NYPMSession = Session.new(SESSION_NY_PM_KEY, 'NYPM', array.from(
             SessionCycle.new("SESSION_NY_PM_1", 'C1', "1130-1300"),
             SessionCycle.new("SESSION_NY_PM_2", 'C1', "1300-1430"),
             SessionCycle.new("SESSION_NY_PM_3", 'C1', "1430-1600")
         ))
      
        if canProcessData
            for monitoredSymbol in ARR_COMBINED_MONITORED_ASSETS
                this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_ASIA_KEY),   AsiaSession.getDeepInstance())
                this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_LONDON_KEY), LondonSession.getDeepInstance())
                this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_NY_AM_KEY),  NYAMSession.getDeepInstance())
                this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_NY_PM_KEY),  NYPMSession.getDeepInstance())


    for monitoredSymbol in ARR_COMBINED_MONITORED_ASSETS
        if not (canProcessData)
            break

        for sessionKey in ARR_SESSIONS_KEYS

            string assetSessionKey = this.getAssetSessionKey(monitoredSymbol, sessionKey)
            Session registeredSession = this.get(assetSessionKey)
            if(na(registeredSession) or registeredSession.isClosed())
                continue

            Candle lastRegisteredCandle = CandlesMapHolder.getLastRegisteredCandle(CandlesMapHolder.getSymbolKey(monitoredSymbol, timeframe.period))

            if(na(lastRegisteredCandle))
                continue

            registeredSession.registerCandle(lastRegisteredCandle, monitoredSymbol)
            this.put(assetSessionKey, registeredSession)


method getActiveSession(map<string, Session> this) =>
    Session activeSession = na
    for sessionKey in ARR_SESSIONS_KEYS
        Session registeredSession = this.get(this.getAssetSessionKey(syminfo.ticker, sessionKey))
        if(not na(registeredSession) and registeredSession.isActive())
            activeSession := registeredSession
            break
    activeSession


method getAllSessionsCyclesKeys(map<string, Session> this, bool reversed = false) =>
    var arrAllCycles = array.new_string()
    if(arrAllCycles.size() == 0)
        for sessionKey in ARR_SESSIONS_KEYS
            Session registeredSession = this.get(this.getAssetSessionKey(syminfo.ticker, sessionKey))
            if(na(registeredSession))
                continue
            for cycle in registeredSession.Cycles
                arrAllCycles.push(cycle.Key)
        //arrAllCycles.reverse()

    if( reversed )
        var reversedArray = array.new_string()
        if( reversedArray.size() == 0 )
            reversedArray := arrAllCycles.copy()
            reversedArray.reverse()
        reversedArray
    else
        arrAllCycles


method getSessionHighestCandle(map<string, Session> this, string monitoredSymbol, string sessionKey) =>
    var map<string, Candle> cacheMap = map.new<string, Candle>()
    if(isNewTradingDay())
        cacheMap.clear()

    string sessionAssetKey    = this.getAssetSessionKey(monitoredSymbol, sessionKey)
    Candle highestCandle      = cacheMap.get(sessionAssetKey) // I am using same key here
    if( na(highestCandle) )
        Session registeredSession = this.get(sessionAssetKey)
        if not na(registeredSession) and not na(registeredSession.Cycles) and registeredSession.Cycles.size() > 0
            for sessionCycle in registeredSession.Cycles
                if na(highestCandle) or sessionCycle.HighestCandle.highPrice >= highestCandle.highPrice
                    highestCandle := sessionCycle.HighestCandle

        if( not na(highestCandle)  and  highestCandle.barIndex != 0  and registeredSession.isClosed())
            cacheMap.put(sessionAssetKey, highestCandle.copy())

    highestCandle

method getSessionLowestCandle(map<string, Session> this, string monitoredSymbol, string sessionKey) =>
    
    var map<string, Candle> cacheMap = map.new<string, Candle>()
    if(isNewTradingDay())
        cacheMap.clear()

    string sessionAssetKey =  this.getAssetSessionKey(monitoredSymbol, sessionKey)
    Candle lowestCandle    = cacheMap.get(sessionAssetKey) // I am using same key here

    if (na(lowestCandle))
        Session registeredSession = this.get(sessionAssetKey)
        if not na(registeredSession) and not na(registeredSession.Cycles)// and registeredSession.Cycles.size() > 0 
            for sessionCycle in registeredSession.Cycles
                if(sessionCycle.LowestCandle.barIndex == 0)
                    continue

                if na(lowestCandle)  or (sessionCycle.LowestCandle.lowPrice <= lowestCandle.lowPrice)
                    lowestCandle := sessionCycle.LowestCandle

        if(not na(lowestCandle) and lowestCandle.barIndex != 0 and registeredSession.isClosed())
            cacheMap.put(sessionAssetKey, lowestCandle.copy())
    
    lowestCandle


method sortMapByCandlePrice(map<string, Candle>this, string priceField, orderType) =>
    if(this.size() > 0)
        keys   = this.keys()
        values = this.values()
        size   = values.size()
        criteria = array.new<float>(size, na)
        for [i, c] in values
            criteria.set( i, ( 'l' == priceField ? c.lowPrice : c.highPrice) )
        arrSortedIndices = criteria.sort_indices(orderType)
        this.clear()
        for index in arrSortedIndices
            this.put(keys.get(index), values.get(index))


method registerCandle(map<string, CandlesList>this, string symbolKey, Candle candleToRegister) => 
    
    const int maxCandlesToKeep  = 50
    
    CandlesList arrCandlesList  =  this.get(symbolKey) //this.contains(symbolKey) ? : CandlesList.new(array.new<Candle>())
    if (na(arrCandlesList))
        arrCandlesList := CandlesList.new(array.new<Candle>())
    
    Candle lastRegisteredCandle   = arrCandlesList.arrCandles.size() > 0 ?  arrCandlesList.arrCandles.last() : na

    bool canRegisterNewCandle  =  (candleToRegister.barIndex > 0)
    if ( not na(lastRegisteredCandle)  )
        if (lastRegisteredCandle.isEqualTo(candleToRegister))
            canRegisterNewCandle := false

        lastRegisteredCandle.highTaken := lastRegisteredCandle.highTaken or lastRegisteredCandle.highPrice < candleToRegister.highPrice
        lastRegisteredCandle.lowTaken  := lastRegisteredCandle.lowTaken  or lastRegisteredCandle.lowPrice  < candleToRegister.lowPrice
    
    if ( canRegisterNewCandle )
        arrCandlesList.arrCandles.push(candleToRegister)
        if(arrCandlesList.arrCandles.size() > maxCandlesToKeep)
            arrCandlesList.arrCandles.shift()
        if(arrCandlesList.arrCandles.size() == 1)    
            this.put(symbolKey, arrCandlesList)



registerCandlesHistory() =>

    var map<string, Candle> tempCandlesMapHolder = map.new<string, Candle>()

    Candle lastConfirmedCandle = barstate.isconfirmed ?  Candle.new(open, high, low, close, time, time_close, bar_index, bar_index, bar_index, bar_index, bar_index) : na
    // if(not na(lastConfirmedCandle) )
    //     CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(syminfo.ticker, timeframe.period), lastConfirmedCandle)

    for monitoredTimeFrame in ARR_TIME_FRAMES_TO_MONITOR
        if ( (year >= CURRENT_YEAR - 1) and (not tempCandlesMapHolder.contains(monitoredTimeFrame)) and compareTimeFrames(timeframe.period, monitoredTimeFrame) < 0 ) 
            tempCandlesMapHolder.put(monitoredTimeFrame, Candle.new())
        
    for monitoredTimeFrame in tempCandlesMapHolder.keys()
        Candle monitoredCandle = tempCandlesMapHolder.get(monitoredTimeFrame)
        if(na(monitoredCandle))
            continue 

        if ( higherTimeFrameHasChanged(monitoredTimeFrame) )  //or ( session.islastbar and barstate.isconfirmed ) 
            if(monitoredCandle.hasAllPrices())
                CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(syminfo.ticker, monitoredTimeFrame), monitoredCandle.copy())
                
            monitoredCandle := Candle.new(open, na, na, na, time, na, bar_index, bar_index, na, na, na)                    
            tempCandlesMapHolder.put(monitoredTimeFrame, monitoredCandle)

        if( na(lastConfirmedCandle) )
            continue
        
        monitoredCandle.closePrice    := lastConfirmedCandle.closePrice
        monitoredCandle.closeTime     := lastConfirmedCandle.closeTime
        monitoredCandle.closeBarIndex := lastConfirmedCandle.closeBarIndex

        monitoredCandle.highPrice  := na(monitoredCandle.highPrice) ? lastConfirmedCandle.highPrice : math.max(monitoredCandle.highPrice, lastConfirmedCandle.highPrice)
        monitoredCandle.lowPrice   := na(monitoredCandle.lowPrice)  ? lastConfirmedCandle.lowPrice  : math.min(monitoredCandle.lowPrice, lastConfirmedCandle.lowPrice)

        if(monitoredCandle.highPrice == lastConfirmedCandle.highPrice)
            monitoredCandle.highBarIndex := lastConfirmedCandle.highBarIndex             

        if(monitoredCandle.lowPrice == lastConfirmedCandle.lowPrice)
            monitoredCandle.lowBarIndex := lastConfirmedCandle.lowBarIndex             

        //tempCandlesMapHolder.put(monitoredTimeFrame, monitoredCandle)

registerCandlesHistory()



MainAssetCandle.setBarIndex()
MainAssetCandle.setPrices()
MainAssetCandle.setOpenCloseTime()

initializeRealTimeCandles() =>

    bool canRequestData  =  (year >= CURRENT_YEAR - 1)

    if canRequestData
        [o, h, l, c, ot, ct, bi] = request.security(getSymbolTickerId(ARR_MONITORED_ASSETS.get(0)), timeframe.period, [open, high, low, close, time, time_close, bar_index], lookahead = barmerge.lookahead_off)           
        // if(not na (bi) and bi != SecondAssetCandle.barIndex and ot != SecondAssetCandle.openTime)
        //     CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(ARR_MONITORED_ASSETS.get(0), timeframe.period), SecondAssetCandle.copy())
        SecondAssetCandle.setBarIndex(nz(bi))
        SecondAssetCandle.setOpenCloseTime(nz(ot), nz(ct))
        SecondAssetCandle.setPrices(nz(o), nz(h), nz(l), nz(c))
        
    if canRequestData
        [o, h, l, c, ot, ct, bi] = request.security(getSymbolTickerId(ARR_MONITORED_ASSETS.get(1)), timeframe.period, [open, high, low, close, time, time_close, bar_index], lookahead = barmerge.lookahead_off)           
        // if(not na (bi) and bi != ThirdAssetCandle.barIndex and ot != ThirdAssetCandle.openTime)
        //     CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(ARR_MONITORED_ASSETS.get(1), timeframe.period), ThirdAssetCandle.copy())
        ThirdAssetCandle.setBarIndex(nz(bi))
        ThirdAssetCandle.setOpenCloseTime(nz(ot), nz(ct))
        ThirdAssetCandle.setPrices(nz(o), nz(h), nz(l), nz(c))


    if(canRequestData and barstate.isconfirmed and (MainAssetCandle.openTime == SecondAssetCandle.openTime and SecondAssetCandle.openTime == ThirdAssetCandle.openTime) )
        CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(ARR_COMBINED_MONITORED_ASSETS.get(0), timeframe.period), Candle.new(open, high, low, close, time, time_close, bar_index, bar_index, bar_index, bar_index, bar_index))
        CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(ARR_COMBINED_MONITORED_ASSETS.get(1), timeframe.period), SecondAssetCandle.copy())
        CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(ARR_COMBINED_MONITORED_ASSETS.get(2), timeframe.period), ThirdAssetCandle.copy())

initializeRealTimeCandles()


registerOtherAssetsCandlesHistory() => 


    var int currentTimeFrameInSeconds   = timeframe.in_seconds(timeframe.period)
    var int monitoredTimeFrameInSeconds = 0

    for monitoredTimeFrame in ARR_TIME_FRAMES_TO_MONITOR

        if( not higherTimeFrameHasChanged(monitoredTimeFrame) )
            continue

        monitoredTimeFrameInSeconds :=  timeframe.in_seconds(monitoredTimeFrame)
    
        if( (year < CURRENT_YEAR - 1) or (currentTimeFrameInSeconds >= monitoredTimeFrameInSeconds ) ) // or ( monitoredTimeFrameInSeconds % currentTimeFrameInSeconds != 0)
            continue

        //log.info(monitoredTimeFrame)

        Candle otherAssetCandle = na

        for [symbolIndex, monitoredSymbol] in ARR_MONITORED_ASSETS//ARR_COMBINED_MONITORED_ASSETS
            //[o, h, l, c, ot, ct, bi] = request.security(monitoredSymbol, monitoredTimeFrame, [open, high, low, close, time, time_close, bar_index], lookahead = barmerge.lookahead_off)
            //[o, h, l, c, ot, ct, bi] = request.security(monitoredSymbol, monitoredTimeFrame,[open[1], high[1], low[1], close[1], time[1], time_close[1], bar_index[1]], lookahead = barmerge.lookahead_on)

            // if( currentTimeFrameInSeconds == monitoredTimeFrameInSeconds ) //monitoredTimeFrame == timeframe.period
            //     [o, h, l, c, ot, ct, bi] = request.security(monitoredSymbol, monitoredTimeFrame,[open, high, low, close, time, time_close, bar_index], lookahead = barmerge.lookahead_off)
            //     //[o, h, l, c, ot, ct, bi] = request.security(monitoredSymbol, monitoredTimeFrame,[open[1], high[1], low[1], close[1], time[1], time_close[1], bar_index[1]], lookahead = barmerge.lookahead_on)
                
            //     if(0 == symbolIndex)
            //         if(bi != SecondAssetCandle.barIndex and ot != SecondAssetCandle.openTime)
            //             otherAssetCandle := SecondAssetCandle.copy()

            //         SecondAssetCandle.setBarIndex(nz(bi))
            //         SecondAssetCandle.setOpenCloseTime(nz(ot), nz(ct))
            //         SecondAssetCandle.setPrices(nz(o), nz(h), nz(l), nz(c))

            //     else
            //         if(bi != ThirdAssetCandle.barIndex and ot != ThirdAssetCandle.openTime)
            //             otherAssetCandle := ThirdAssetCandle.copy()

            //         ThirdAssetCandle.setBarIndex(nz(bi))
            //         ThirdAssetCandle.setOpenCloseTime(nz(ot), nz(ct))
            //         ThirdAssetCandle.setPrices(nz(o), nz(h), nz(l), nz(c))
            // else
            [o, h, l, c, ot, ct, bi] = request.security(monitoredSymbol, monitoredTimeFrame,[open[1], high[1], low[1], close[1], time[1], time_close[1], bar_index[1]], lookahead = barmerge.lookahead_on)
            otherAssetCandle := Candle.new(nz(o), nz(h), nz(l), nz(c),nz(ot), nz(ct), nz(bi))

            if(not na (otherAssetCandle) and otherAssetCandle.barIndex > 0)
                CandlesMapHolder.registerCandle(CandlesMapHolder.getSymbolKey(monitoredSymbol, monitoredTimeFrame), otherAssetCandle) //.copy()
                
            otherAssetCandle := na    

registerOtherAssetsCandlesHistory()

initSmtTypeMap() => // Initialize map in function. Only way to avoid The function str.tostring should be called on each calculation for consistency
    SmtTypeToString.put(SmtType.TimeBasedBullish,    str.tostring(SmtType.TimeBasedBullish))
    SmtTypeToString.put(SmtType.TimeBasedBearish,    str.tostring(SmtType.TimeBasedBearish))
    SmtTypeToString.put(SmtType.SessionBasedBullish, str.tostring(SmtType.SessionBasedBullish))
    SmtTypeToString.put(SmtType.SessionBasedBearish, str.tostring(SmtType.SessionBasedBearish))
    SmtTypeToString.put(SmtType.CycleBasedBullish,   str.tostring(SmtType.CycleBasedBullish))
    SmtTypeToString.put(SmtType.CycleBasedBearish,   str.tostring(SmtType.CycleBasedBearish))

var bool _mapSmtTypeToStringInitialized = false
if not _mapSmtTypeToStringInitialized
    initSmtTypeMap()
    _mapSmtTypeToStringInitialized := true


method isBullish(Smt this) =>
    (this.Type == SmtType.CycleBasedBullish) or (this.Type == SmtType.SessionBasedBullish) or  (this.Type == SmtType.TimeBasedBullish)
method isBerrish(Smt this) =>
    not this.isBullish()

method invalidate(Smt this) =>
    this.IsValid := false
    if(not na(this.Label) )
        this.Label.delete()
    if(not na(this.Line) )
        this.Line.delete()

method draw(Smt this) =>

    lineWidth  = 1
    lineSlope  = (this.EndBarIndex != this.StartBarIndex) ? (this.EndPrice - this.StartPrice) / (this.EndBarIndex - this.StartBarIndex) : 0
    labelX     = this.StartBarIndex //+ math.round( (this.EndBarIndex - this.StartBarIndex) * 0.0 )
    labelY     = this.StartPrice + lineSlope * ( labelX -  this.StartBarIndex)    
    
    labelColor = color.red
    lineColor  = color.red
    labelStyle = label.style_label_lower_right

    if this.isBullish()
        labelColor := color.green
        lineColor  := color.green
        labelStyle := label.style_label_upper_right    

    if(na(this.Line))
        this.Line := line.new(x1= this.StartBarIndex, y1 = this.StartPrice, x2 = this.EndBarIndex, y2 = this.EndPrice, xloc = xloc.bar_index, width = 1,  extend = extend.none)
        this.Line.set_width(lineWidth)
        this.Line.set_color(lineColor)

    else
        if(this.StartBarIndex != this.Line.get_x1() or this.StartPrice != this.Line.get_y1())
            this.Line.set_xy1(this.StartBarIndex, this.StartPrice)

        if(this.EndBarIndex != this.Line.get_x2() or this.EndPrice != this.Line.get_y2() )
            this.Line.set_xy2(this.EndBarIndex, this.EndPrice)


    if( na(this.Label) )
        this.Label := label.new( x = labelX, y = labelY, text = na(this.LabelText) ? '' : this.LabelText, style = labelStyle, color = labelColor , textcolor = color.white, size = size.small)
        
    if( this.Label.get_y() != labelY or this.Label.get_x() != labelX)
        this.Label.set_xy(labelX, labelY)



startMonitoringDailySessions() => 

    SessionsMapHolder.handleSessions()

    map<string, Candle> ClosedSessionsCandlesMap = map.new<string, Candle>()

    if ( isNewTradingDay() )
        for [key, detectedSmt] in SmtMapHolder
            detectedSmt.invalidate()
        SmtMapHolder.clear()

    Session currentSession = SessionsMapHolder.getActiveSession()
    int currentSessionKeyIndex = na(currentSession) ? -1 : ARR_SESSIONS_KEYS.indexof(currentSession.Key)


    for [sessionKeyIndex, sessionKey] in ARR_SESSIONS_KEYS
        if(currentSessionKeyIndex < 0 or sessionKeyIndex == currentSessionKeyIndex) // includ Asia aici. daca e prima nu avem SMT pana nu se inchide
            break
        lowestCandle = SessionsMapHolder.getSessionLowestCandle(syminfo.ticker, sessionKey)
        if not na(lowestCandle)     
            ClosedSessionsCandlesMap.put(sessionKey, lowestCandle)

    ClosedSessionsCandlesMap.sortMapByCandlePrice('l', order.descending)   

    string[] arrSortedSessionKeys = ClosedSessionsCandlesMap.keys()

    string lowestSessionKey   = (arrSortedSessionKeys.size() == 0) ? na : arrSortedSessionKeys.last()
    int lowestSessionKeyIndex = (arrSortedSessionKeys.size() == 0) ? -1 : ARR_SESSIONS_KEYS.indexof(lowestSessionKey)
     
    for [index, sessionKey] in arrSortedSessionKeys
        if(currentSessionKeyIndex <= 0 or lowestSessionKeyIndex < 0  ) // includ Asia aici. daca e prima nu avem SMT pana nu se inchide
            break

        // bool currentPriceIsBelowLowest = MainAssetCandle.lowPrice < ClosedSessionsCandlesMap.get(lowestSessionKey).lowPrice
        // if( not currentPriceIsBelowLowest and ARR_SESSIONS_KEYS.indexof(sessionKey) < lowestSessionKeyIndex)
        //     continue

        Candle mainAssetSessionLowestCandle = SessionsMapHolder.getSessionLowestCandle(syminfo.ticker, sessionKey) //ClosedSessionsCandlesMap.get(sessionKey)

        bool validSmtExists = false
        for [ assetIndex, monitoredSymbol] in ARR_MONITORED_ASSETS

            Candle CompAssetCandle =  (0 == assetIndex) ? SecondAssetCandle : ThirdAssetCandle    
            Candle compAssetSessionLowestCandle  = SessionsMapHolder.getSessionLowestCandle(monitoredSymbol, sessionKey)

            string sessionBullishSmtKey = sessionKey + '-' + monitoredSymbol + SmtTypeToString.get(SmtType.SessionBasedBullish)
            Smt detectedBullishSmt = SmtMapHolder.get(sessionBullishSmtKey)

            if( na(compAssetSessionLowestCandle) or na(mainAssetSessionLowestCandle) or ( not na(detectedBullishSmt) and not detectedBullishSmt.IsValid ) )
                continue 

            float mainAssetMove = MainAssetCandle.lowPrice - mainAssetSessionLowestCandle.lowPrice //ClosedSessionsCandlesMap.get(sessionKey).lowPrice
            float compAssetMove = CompAssetCandle.lowPrice - compAssetSessionLowestCandle.lowPrice

            if( 0 == mainAssetMove and 0 == compAssetMove)
                continue

            if( (not validSmtExists) and na(detectedBullishSmt) and (mainAssetMove * compAssetMove) <= 0 )           
                detectedBullishSmt := Smt.new(Type = SmtType.SessionBasedBullish, 
                                                             StartBarIndex = mainAssetSessionLowestCandle.barIndex, StartPrice = mainAssetSessionLowestCandle.lowPrice,
                                                             EndBarIndex = MainAssetCandle.barIndex, EndPrice =  MainAssetCandle.lowPrice, IsValid = true)

                mainAssetActiveSessionLowestCandle = SessionsMapHolder.getSessionLowestCandle(syminfo.ticker, currentSession.Key)

                detectedBullishSmt.MainPointPrice := mainAssetSessionLowestCandle.lowPrice
                detectedBullishSmt.CorrPointPrice := compAssetSessionLowestCandle.lowPrice
                SmtMapHolder.put(sessionBullishSmtKey, detectedBullishSmt)

            if( not na(detectedBullishSmt) and  detectedBullishSmt.IsValid ) 

                if (MainAssetCandle.lowPrice < detectedBullishSmt.EndPrice)
                    detectedBullishSmt.EndBarIndex := MainAssetCandle.barIndex
                    detectedBullishSmt.EndPrice    := MainAssetCandle.lowPrice 

                mainAssetActiveSessionLowestCandle = SessionsMapHolder.getSessionLowestCandle(syminfo.ticker, currentSession.Key)
                compAssetActiveSessionLowestCandle = SessionsMapHolder.getSessionLowestCandle(monitoredSymbol, currentSession.Key)

                if(not na(mainAssetActiveSessionLowestCandle) and not na(compAssetActiveSessionLowestCandle))

                    detectedBullishSmt.MainPointTaken        := detectedBullishSmt.MainPointTaken or detectedBullishSmt.MainPointPrice > math.min(MainAssetCandle.lowPrice, mainAssetActiveSessionLowestCandle.lowPrice, mainAssetSessionLowestCandle.lowPrice)
                    detectedBullishSmt.CorrPointTaken  := detectedBullishSmt.CorrPointTaken or detectedBullishSmt.CorrPointPrice > math.min(CompAssetCandle.lowPrice, compAssetActiveSessionLowestCandle.lowPrice, compAssetSessionLowestCandle.lowPrice)

                detectedBullishSmt.IsValid := not (detectedBullishSmt.MainPointTaken  and detectedBullishSmt.CorrPointTaken)

            if(na(detectedBullishSmt))
                continue

            if(not detectedBullishSmt.IsValid)
                detectedBullishSmt.invalidate()
            else 
                detectedBullishSmt.LabelText := sessionKey + ' - ' + monitoredSymbol
                detectedBullishSmt.draw()

            validSmtExists := detectedBullishSmt.IsValid    
            

    ClosedSessionsCandlesMap.clear()
    for [sessionKeyIndex, sessionKey] in ARR_SESSIONS_KEYS
        if(currentSessionKeyIndex < 0 or sessionKeyIndex == currentSessionKeyIndex) // includ Asia aici. daca e prima nu avem SMT pana nu se inchide
            break
        sessionHighestCandle =  SessionsMapHolder.getSessionHighestCandle(syminfo.ticker, sessionKey)
        if(not na(sessionHighestCandle))    
            ClosedSessionsCandlesMap.put(sessionKey, SessionsMapHolder.getSessionHighestCandle(syminfo.ticker, sessionKey))

    ClosedSessionsCandlesMap.sortMapByCandlePrice('h', order.descending)   
    arrSortedSessionKeys := ClosedSessionsCandlesMap.keys()

    string highestSessionKey   = (arrSortedSessionKeys.size() == 0) ? na : arrSortedSessionKeys.first()
    int highestSessionKeyIndex = (arrSortedSessionKeys.size() == 0) ? -1 : ARR_SESSIONS_KEYS.indexof(highestSessionKey)

    for [sessionKeyIndex, sessionKey] in arrSortedSessionKeys
        if(currentSessionKeyIndex <= 0 or highestSessionKeyIndex < 0  ) // includ Asia aici. daca e prima nu avem SMT pana nu se inchide
            break
        
        // bool currentPriceIsAboveHighest = MainAssetCandle.highPrice > ClosedSessionsCandlesMap.get(highestSessionKey).highPrice
        // if(  currentPriceIsAboveHighest and ARR_SESSIONS_KEYS.indexof(sessionKey) < highestSessionKeyIndex )
        //     continue

        Candle mainAssetSessionHighestCandle = SessionsMapHolder.getSessionHighestCandle(syminfo.ticker, sessionKey)

        bool validSmtExists = false
        for [ assetIndex, monitoredSymbol] in ARR_MONITORED_ASSETS

            // if (assetIndex == 1)
            //     continue

            Candle CompAssetCandle =  (0 == assetIndex) ? SecondAssetCandle : ThirdAssetCandle    
            Candle compAssetSessionHighestCandle  = SessionsMapHolder.getSessionHighestCandle(monitoredSymbol, sessionKey)

            string sessionBearishSmtKey = sessionKey + '-' + monitoredSymbol + SmtTypeToString.get(SmtType.SessionBasedBearish)
            Smt detectedBearishSmt      = SmtMapHolder.get(sessionBearishSmtKey)

            if(na(compAssetSessionHighestCandle) or na(mainAssetSessionHighestCandle) or ( not na(detectedBearishSmt) and not detectedBearishSmt.IsValid) )
                continue //log.info('E NA')

            float mainAssetMove = MainAssetCandle.highPrice - mainAssetSessionHighestCandle.highPrice //ClosedSessionsCandlesMap.get(sessionKey).lowPrice
            float compAssetMove = CompAssetCandle.highPrice - compAssetSessionHighestCandle.highPrice

            if( 0 == mainAssetMove and 0 == compAssetMove)
                continue

            if( (not validSmtExists) and na(detectedBearishSmt) and (mainAssetMove * compAssetMove) <= 0 )           
                detectedBearishSmt := Smt.new(Type = SmtType.SessionBasedBearish, 
                                                             StartBarIndex = mainAssetSessionHighestCandle.barIndex, StartPrice = mainAssetSessionHighestCandle.highPrice,
                                                             EndBarIndex = MainAssetCandle.barIndex, EndPrice =  MainAssetCandle.highPrice, IsValid = true)

                detectedBearishSmt.MainPointPrice := mainAssetSessionHighestCandle.highPrice
                detectedBearishSmt.CorrPointPrice := compAssetSessionHighestCandle.highPrice

                SmtMapHolder.put(sessionBearishSmtKey, detectedBearishSmt)


            if( not na(detectedBearishSmt) and  detectedBearishSmt.IsValid ) 

                if (MainAssetCandle.highPrice > detectedBearishSmt.EndPrice)
                    detectedBearishSmt.EndBarIndex := MainAssetCandle.barIndex
                    detectedBearishSmt.EndPrice    := MainAssetCandle.highPrice 

                mainAssetActiveSessionHighestCandle = SessionsMapHolder.getSessionHighestCandle(syminfo.ticker, currentSession.Key)
                compAssetActiveSessionHighestCandle = SessionsMapHolder.getSessionHighestCandle(monitoredSymbol, currentSession.Key)

                if(not na(mainAssetActiveSessionHighestCandle) and not na(compAssetActiveSessionHighestCandle))

                    detectedBearishSmt.MainPointTaken        := detectedBearishSmt.MainPointTaken or detectedBearishSmt.MainPointPrice       < math.max(MainAssetCandle.highPrice, mainAssetActiveSessionHighestCandle.highPrice, mainAssetSessionHighestCandle.highPrice)
                    detectedBearishSmt.CorrPointTaken  := detectedBearishSmt.CorrPointTaken or detectedBearishSmt.CorrPointPrice < math.max(CompAssetCandle.highPrice, compAssetActiveSessionHighestCandle.highPrice, compAssetSessionHighestCandle.highPrice)

                detectedBearishSmt.IsValid := not (detectedBearishSmt.MainPointTaken  and detectedBearishSmt.CorrPointTaken)


            if(na(detectedBearishSmt))
                continue

            if(not detectedBearishSmt.IsValid)
                detectedBearishSmt.invalidate()
            else 
                detectedBearishSmt.LabelText := sessionKey + ' - ' + monitoredSymbol
                detectedBearishSmt.draw()

            validSmtExists := detectedBearishSmt.IsValid

            //SmtMapHolder.put(sessionBearishSmtKey, detectedBearishSmt)

// //--------------------------------------------- 90 MINS CYCLES -----------------------

    //currentSessionKeyIndex := -1
    SessionCycle lastClosedCycle    = na
    SessionCycle activeCycle        = na
    
    if (currentSessionKeyIndex != -1)
        for [cycleIndex, sessionCycle] in currentSession.Cycles
            if sessionCycle.isActive()
                activeCycle := sessionCycle
                break
            else 
                lastClosedCycle := sessionCycle


    int activeCycleIndex    =  na(activeCycle)        ? -1 : SessionsMapHolder.getAllSessionsCyclesKeys().indexof(activeCycle.Key)
    string lookBackCycleKey =  (activeCycleIndex < 3) ? '' : SessionsMapHolder.getAllSessionsCyclesKeys().get(activeCycleIndex - 3)
    for [ assetIndex, monitoredSymbol ] in ARR_MONITORED_ASSETS
        string bearishSmtKey   = lookBackCycleKey + '-' + monitoredSymbol + SmtTypeToString.get(SmtType.CycleBasedBearish)
        string bullishSmtKey   = lookBackCycleKey + '-' + monitoredSymbol + SmtTypeToString.get(SmtType.CycleBasedBullish)
        bearishSmt = SmtMapHolder.get(bearishSmtKey)
        bullishSmt = SmtMapHolder.get(bullishSmtKey)
        if( not na (bearishSmt) )            
            bearishSmt.invalidate()
        if( not na (bullishSmt) )            
            bullishSmt.invalidate()


    for [smtKey, registeredSmt] in SmtMapHolder

        if (not registeredSmt.IsValid) // or (registeredSmt.Type != SmtType.CycleBasedBearish and registeredSmt.Type != SmtType.CycleBasedBullish)
            continue

        Candle CompAssetCandle = str.contains(smtKey, ARR_MONITORED_ASSETS.get(0)) ? SecondAssetCandle : ThirdAssetCandle
        if( not registeredSmt.MainPointTaken )    
            registeredSmt.MainPointTaken := (registeredSmt.isBerrish())
                                                 ? registeredSmt.MainPointPrice < MainAssetCandle.highPrice
                                                 : registeredSmt.MainPointPrice > MainAssetCandle.lowPrice
        if( not registeredSmt.CorrPointTaken )  
            registeredSmt.CorrPointTaken := (registeredSmt.isBerrish())
                                                 ? registeredSmt.CorrPointPrice < CompAssetCandle.highPrice
                                                 : registeredSmt.CorrPointPrice > CompAssetCandle.lowPrice

        registeredSmt.IsValid := not ( registeredSmt.MainPointTaken and registeredSmt.CorrPointTaken)

        if(not registeredSmt.IsValid)
            registeredSmt.invalidate()

    for [sessionKeyIndex, sessionKey] in ARR_SESSIONS_KEYS
        if( currentSessionKeyIndex < 0  or not na(lastClosedCycle) )
            break

        if(sessionKeyIndex != currentSessionKeyIndex - 1)
            continue

        Session registeredSession = SessionsMapHolder.get(SessionsMapHolder.getAssetSessionKey(syminfo.ticker, sessionKey))
        for i = registeredSession.Cycles.size() - 1 to 0
            sessionCycle = registeredSession.Cycles.get(i)
            if(sessionCycle.isClosed())
                lastClosedCycle := sessionCycle
                break

    for [sessionKeyIndex, sessionKey] in ARR_SESSIONS_KEYS
        if(currentSessionKeyIndex < 0)
            break
        if(sessionKeyIndex > currentSessionKeyIndex or na(lastClosedCycle))
            continue

        bool validBearishSmtExists    = false
        bool validBullishSmtExists    = false
        for [ assetIndex, monitoredSymbol ] in ARR_MONITORED_ASSETS    
            

            Candle CompAssetCandle =  (0 == assetIndex) ? SecondAssetCandle : ThirdAssetCandle    
            Session compAssetRegisteredSession    = SessionsMapHolder.get(SessionsMapHolder.getAssetSessionKey(monitoredSymbol, sessionKey))

            SessionCycle compAssetLastClosedCycle = na    
            for [ _, sessionCycle] in compAssetRegisteredSession.Cycles
                compAssetLastClosedCycle := (sessionCycle.Key != lastClosedCycle.Key) ? na : sessionCycle
                if ( not na(compAssetLastClosedCycle) )
                    break
            if ( na(compAssetLastClosedCycle) )
                continue

            //log.info('Last closed cycle -> ' + compAssetLastClosedCycle.Key + " -> " + compAssetLastClosedCycle.Period)

            string bearishSmtKey   = lastClosedCycle.Key + '-' + monitoredSymbol + SmtTypeToString.get(SmtType.CycleBasedBearish)
            string bullishSmtKey   = lastClosedCycle.Key + '-' + monitoredSymbol + SmtTypeToString.get(SmtType.CycleBasedBullish)

            Smt detectedBearishSmt = SmtMapHolder.get(bearishSmtKey)
            Smt detectedBullishSmt = SmtMapHolder.get(bullishSmtKey)


            for iteration = 1 to 2   
                SmtType checkSmtType = (iteration == 1) ? SmtType.CycleBasedBearish : SmtType.CycleBasedBullish

                float mainAssetMove = (checkSmtType == SmtType.CycleBasedBearish) ? MainAssetCandle.highPrice - lastClosedCycle.HighestCandle.highPrice          : MainAssetCandle.lowPrice - lastClosedCycle.LowestCandle.lowPrice
                float compAssetMove = (checkSmtType == SmtType.CycleBasedBearish) ? CompAssetCandle.highPrice - compAssetLastClosedCycle.HighestCandle.highPrice : CompAssetCandle.lowPrice - compAssetLastClosedCycle.LowestCandle.lowPrice

                if( 0 == mainAssetMove and 0 == compAssetMove)
                    continue
                    
                if( (checkSmtType == SmtType.CycleBasedBearish) and ( not na(detectedBearishSmt) and not detectedBearishSmt.IsValid) )
                    continue

                if( (checkSmtType == SmtType.CycleBasedBullish) and ( not na(detectedBullishSmt) and not detectedBullishSmt.IsValid) )
                    continue

                if( (checkSmtType == SmtType.CycleBasedBearish) )
                    if( (not validBearishSmtExists) and na(detectedBearishSmt) and (mainAssetMove * compAssetMove) <= 0 )           
                        detectedBearishSmt := Smt.new(Type = SmtType.CycleBasedBearish, 
                                                                         StartBarIndex = lastClosedCycle.HighestCandle.barIndex, StartPrice = lastClosedCycle.HighestCandle.highPrice,
                                                                         EndBarIndex = MainAssetCandle.barIndex, EndPrice =  MainAssetCandle.highPrice, IsValid = true)

                        if(activeCycle.HighestCandle.highPrice > detectedBearishSmt.EndPrice)
                            detectedBearishSmt.EndBarIndex := activeCycle.HighestCandle.barIndex
                            detectedBearishSmt.EndPrice    := activeCycle.HighestCandle.highPrice 

                        detectedBearishSmt.MainPointPrice := lastClosedCycle.HighestCandle.highPrice
                        detectedBearishSmt.CorrPointPrice := compAssetLastClosedCycle.HighestCandle.highPrice

                    if( not na(detectedBearishSmt) and  detectedBearishSmt.IsValid ) 

                        if (MainAssetCandle.highPrice > detectedBearishSmt.EndPrice)
                            detectedBearishSmt.EndBarIndex := MainAssetCandle.barIndex
                            detectedBearishSmt.EndPrice    := MainAssetCandle.highPrice 

                        if(not detectedBearishSmt.MainPointTaken)
                            detectedBearishSmt.MainPointTaken := detectedBearishSmt.MainPointPrice < math.max( MainAssetCandle.highPrice, activeCycle.HighestCandle.highPrice) 

                        if(not detectedBearishSmt.CorrPointTaken)
                            Session compAssetActiveSession    = SessionsMapHolder.get(SessionsMapHolder.getAssetSessionKey(monitoredSymbol, currentSession.Key))
                            for [index, compAssetCycle] in compAssetActiveSession.Cycles
                                if compAssetCycle.isActive()
                                    detectedBearishSmt.CorrPointTaken := detectedBearishSmt.CorrPointPrice < math.max(CompAssetCandle.highPrice, compAssetCycle.HighestCandle.highPrice)
                                    break

                        detectedBearishSmt.IsValid := not (detectedBearishSmt.MainPointTaken  and detectedBearishSmt.CorrPointTaken)

                if( (checkSmtType == SmtType.CycleBasedBullish) )
                    if( (not validBullishSmtExists) and na(detectedBullishSmt) and (mainAssetMove * compAssetMove) <= 0 )           
                        detectedBullishSmt := Smt.new(Type = SmtType.CycleBasedBullish, 
                                                                         StartBarIndex = lastClosedCycle.LowestCandle.barIndex, StartPrice = lastClosedCycle.LowestCandle.lowPrice,
                                                                         EndBarIndex = MainAssetCandle.barIndex, EndPrice =  MainAssetCandle.lowPrice, IsValid = true)

                        if(activeCycle.LowestCandle.lowPrice < detectedBullishSmt.EndPrice)
                            detectedBullishSmt.EndBarIndex := activeCycle.LowestCandle.barIndex
                            detectedBullishSmt.EndPrice    := activeCycle.LowestCandle.lowPrice 

                        detectedBullishSmt.MainPointPrice := lastClosedCycle.LowestCandle.lowPrice
                        detectedBullishSmt.CorrPointPrice := compAssetLastClosedCycle.LowestCandle.lowPrice

                    if( not na(detectedBullishSmt) and  detectedBullishSmt.IsValid ) 

                        if (MainAssetCandle.lowPrice < detectedBullishSmt.EndPrice)
                            detectedBullishSmt.EndBarIndex := MainAssetCandle.barIndex
                            detectedBullishSmt.EndPrice    := MainAssetCandle.lowPrice 

                        if(not detectedBullishSmt.MainPointTaken)
                            detectedBullishSmt.MainPointTaken := detectedBullishSmt.MainPointPrice > math.min( MainAssetCandle.lowPrice, activeCycle.LowestCandle.lowPrice) 

                        if(not detectedBullishSmt.CorrPointTaken)
                            Session compAssetActiveSession    = SessionsMapHolder.get(SessionsMapHolder.getAssetSessionKey(monitoredSymbol, currentSession.Key))
                            for [index, compAssetCycle] in compAssetActiveSession.Cycles
                                if compAssetCycle.isActive()
                                    detectedBullishSmt.CorrPointTaken := detectedBullishSmt.CorrPointPrice > math.min(CompAssetCandle.lowPrice, compAssetCycle.LowestCandle.lowPrice)
                                    break

                        detectedBullishSmt.IsValid := not (detectedBullishSmt.MainPointTaken  and detectedBullishSmt.CorrPointTaken)


            if( not na(detectedBearishSmt) )
                if(not detectedBearishSmt.IsValid)
                    detectedBearishSmt.invalidate()
                else
                    detectedBearishSmt.LabelText := '90MIN - ' + monitoredSymbol 
                    detectedBearishSmt.draw()

                validBearishSmtExists  := detectedBearishSmt.IsValid
                SmtMapHolder.put(bearishSmtKey, detectedBearishSmt)

            if( not na(detectedBullishSmt) )
                if(not detectedBullishSmt .IsValid)
                    detectedBullishSmt .invalidate()
                else 
                    detectedBullishSmt.LabelText := '90MIN - ' + monitoredSymbol 
                    detectedBullishSmt .draw()

                validBullishSmtExists := detectedBullishSmt.IsValid
                SmtMapHolder.put(bullishSmtKey, detectedBullishSmt)




if(timeframe.isminutes and (timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds('30'))  )   // and ( barstate.isrealtime ) or isInRecentFuturesPeriod(2, 'W')
    startMonitoringDailySessions()



type PrecisionSwingPoint
    int BarIndex = 0
    bool IsTpd   = false
    label Label  = na


var map<string, PrecisionSwingPoint> PspMapHolder = map.new<string, PrecisionSwingPoint>()


startDetectingTimeBasedSmt() => 

    int timeframeInSeconds  = timeframe.in_seconds(timeframe.period) // not (barstate.isconfirmed) or

    for monitoredTimeFrame in ARR_TIME_FRAMES_TO_MONITOR

        int monitoredTimeFrameInSeconds = timeframe.in_seconds(monitoredTimeFrame)

        //log.info(monitoredTimeFrame + ' -> ' + str.tostring(timeframe.in_seconds(monitoredTimeFrame)))   

        if( ( monitoredTimeFrameInSeconds < timeframeInSeconds ) )    or (monitoredTimeFrameInSeconds % timeframeInSeconds != 0 )   // //or ( not higherTimeFrameHasChanged(monitoredTimeFrame) )  compareTimeFrames(monitoredTimeFrame, timeframe.period) < 0)
            continue


        if(monitoredTimeFrame != timeframe.period ) //and monitoredTimeFrameInSeconds != 1800
            continue

        mainAssetRegisteredCandles   =  CandlesMapHolder.getRegisteredCandles( CandlesMapHolder.getSymbolKey( syminfo.ticker      , monitoredTimeFrame) )
        secondAssetRegisteredCandles =  CandlesMapHolder.getRegisteredCandles( CandlesMapHolder.getSymbolKey( firstMonitoredAsset , monitoredTimeFrame) )
        thirdAssetRegisteredCandles  =  CandlesMapHolder.getRegisteredCandles( CandlesMapHolder.getSymbolKey( secondMonitoredAsset, monitoredTimeFrame) )

        int sizeMain   = mainAssetRegisteredCandles.size()
        int sizeSecond = secondAssetRegisteredCandles.size()
        int sizeThird  = thirdAssetRegisteredCandles.size()
      
        int maxIterations = math.min(sizeMain, sizeSecond, sizeThird)    

        if( sizeMain < 3  or sizeSecond < 3 or sizeThird < 3 )
            continue

        Candle mainAssetCandle   = mainAssetRegisteredCandles.get( -1 )
        Candle secondAssetCandle = secondAssetRegisteredCandles.get( -1 )
        Candle thirdAssetCandle  = thirdAssetRegisteredCandles.get( -1 )


        if not (mainAssetCandle.openTime == secondAssetCandle.openTime and secondAssetCandle.openTime == thirdAssetCandle.openTime)
            continue

        bool mainIsBullish   = mainAssetCandle.isBullish()  
        bool secondIsBullish = secondAssetCandle.isBullish()
        bool thirdIsBullish  = thirdAssetCandle.isBullish()
        
        if( barstate.isconfirmed and ( (not (mainIsBullish and secondIsBullish and thirdIsBullish)) and   not( not(mainIsBullish) and not(secondIsBullish) and not(thirdIsBullish) )     ) )  
            PrecisionSwingPoint psp = PspMapHolder.get(monitoredTimeFrame)
            if(not na(psp) and not na(psp.Label))
                psp.Label.delete()
            else 
                psp := PrecisionSwingPoint.new()
                PspMapHolder.put(monitoredTimeFrame, psp)    

            psp.BarIndex := mainAssetCandle.barIndex    
            // psp.Label := label.new( mainAssetCandle.lowBarIndex, mainAssetCandle.lowPrice, text = 'PSP ' + monitoredTimeFrame, style = label.style_label_up,
            //                              color = color.navy,
            //                              textcolor = color.white,
            //                              size = size.small
            //                          )


        for[assetIndex, monitoredAsset] in ARR_MONITORED_ASSETS
            string bearishSmtKey  = SmtTypeToString.get(SmtType.TimeBasedBearish) + '-' + monitoredTimeFrame + '-' + monitoredAsset
            string bullishSmtKey  = SmtTypeToString.get(SmtType.TimeBasedBullish) + '-' + monitoredTimeFrame + '-' + monitoredAsset
            Smt detectedBearishSmt    = SmtMapHolder.get(bearishSmtKey) 
            Smt detectedBullishSmt    = SmtMapHolder.get(bullishSmtKey)   

            if (not na(detectedBearishSmt) and detectedBearishSmt.IsValid)

                if (MainAssetCandle.highPrice > detectedBearishSmt.EndPrice)
                    detectedBearishSmt.EndBarIndex := MainAssetCandle.barIndex
                    detectedBearishSmt.EndPrice    := MainAssetCandle.highPrice 


                detectedBearishSmt.MainPointTaken := detectedBearishSmt.MainPointTaken or (detectedBearishSmt.MainPointPrice < MainAssetCandle.highPrice)
                detectedBearishSmt.CorrPointTaken := detectedBearishSmt.CorrPointTaken or (detectedBearishSmt.CorrPointPrice < ( (assetIndex == 0) ? SecondAssetCandle.highPrice : ThirdAssetCandle.highPrice) )
                detectedBearishSmt.IsValid        := not(detectedBearishSmt.MainPointTaken and detectedBearishSmt.CorrPointTaken)
                //bearishSmtDetected                := bearishSmtDetected or detectedBearishSmt.IsValid
                detectedBearishSmt.draw()
               

            if( not na(detectedBullishSmt) and detectedBullishSmt.IsValid) 

                if (MainAssetCandle.lowPrice < detectedBullishSmt.EndPrice)
                    detectedBullishSmt.EndBarIndex := MainAssetCandle.barIndex
                    detectedBullishSmt.EndPrice    := MainAssetCandle.lowPrice 

                detectedBullishSmt.MainPointTaken := detectedBullishSmt.MainPointTaken or (detectedBullishSmt.MainPointPrice > MainAssetCandle.lowPrice)
                detectedBullishSmt.CorrPointTaken := detectedBullishSmt.CorrPointTaken or (detectedBullishSmt.CorrPointPrice > ( (assetIndex == 0) ? SecondAssetCandle.lowPrice : ThirdAssetCandle.lowPrice) )
                detectedBullishSmt.IsValid        := not(detectedBullishSmt.MainPointTaken and detectedBullishSmt.CorrPointTaken)
                //bullishSmtDetected                := bullishSmtDetected or detectedBullishSmt.IsValid
                detectedBullishSmt.draw()

            if (not na(detectedBearishSmt) and not detectedBearishSmt.IsValid)
                detectedBearishSmt.invalidate()
                detectedBearishSmt:= na    
                SmtMapHolder.remove(bearishSmtKey)  

            if (not na(detectedBullishSmt) and not detectedBullishSmt.IsValid)
                detectedBullishSmt.invalidate()
                detectedBullishSmt := na    
                SmtMapHolder.remove(bullishSmtKey)  
               
        if not (barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed))
            break



        float[] arrMainHighs = array.new_float(sizeMain, 0.0)
        float[] arrMainLows  = array.new_float(sizeMain, 0.0)        

        //sizeMain := 1
        for i = 1 to sizeMain
            mainAssetCandle   := mainAssetRegisteredCandles.get( -i )
            arrMainHighs.set( -i, mainAssetCandle.highPrice)
            arrMainLows.set( -i, mainAssetCandle.lowPrice)

        arrSortedHighsIndices = arrMainHighs.sort_indices(order.ascending)
        arrSortedLowsIndices  = arrMainLows.sort_indices(order.descending)

        int[] arrMainAssetHighs = array.new_int()
        int[] arrMainAssetLows  = array.new_int()
        
        // int processedHighIndex = -1 
        // for [index, highCandleIndex] in arrSortedHighsIndices 
        //     if (highCandleIndex < processedHighIndex) 
        //         continue 
        //     arrMainAssetHighs.push(highCandleIndex) 
        //     processedHighIndex := highCandleIndex

        int leftMost  = 1000000
        int rightMost = -1
        // for [_, highCandleIndex] in arrSortedHighsIndices
        //     if (highCandleIndex < leftMost or highCandleIndex > rightMost)
        //         array.push(arrMainAssetHighs, highCandleIndex)
        //         if (highCandleIndex < leftMost)
        //             leftMost := highCandleIndex
        //         if (highCandleIndex > rightMost)
        //             rightMost := highCandleIndex

        for [_, highCandleIndex] in arrSortedHighsIndices
            // Skip if not extending our known range
            if not (highCandleIndex < leftMost or highCandleIndex > rightMost )
                continue

            bool isLeftExpansion  = highCandleIndex < leftMost
            bool isRightExpansion = highCandleIndex > rightMost

            array.push(arrMainAssetHighs, highCandleIndex)

            // Example: you might handle them differently
            if isLeftExpansion
                leftMost := highCandleIndex
            if isRightExpansion
                rightMost := highCandleIndex

        // leftMost  := 1000000
        // rightMost := -1
        // //for [_, lowCandleIndex] in arrSortedLowsIndices // A low is relevant if it's outside the range already covered by lower lows if (lowCandleIndex < leftMost or lowCandleIndex > rightMost) array.push(arrMainAssetLows, lowCandleIndex) if (lowCandleIndex < leftMost) leftMost := lowCandleIndex if (lowCandleIndex > rightMost) rightMost := lowCandleIndex        
        
        // for [_, lowCandleIndex] in arrSortedLowsIndices
        //     // Skip if this low is inside the range already covered by lower lows
        //     if not (lowCandleIndex < leftMost or lowCandleIndex > rightMost)
        //         continue
        //     bool isLeftExpansion  = lowCandleIndex < leftMost
        //     bool isRightExpansion = lowCandleIndex > rightMost
        //     array.push(arrMainAssetLows, lowCandleIndex)
        //     if isLeftExpansion
        //         leftMost := lowCandleIndex
        //     if isRightExpansion
        //         rightMost := lowCandleIndex


        Candle mainRegisteredCandle    = na
        Candle compareRegisteredCandle = na
        Candle CompareAssetCandle      = na

        Smt FirtsAssetBearishSmt = na
        Smt SecondAssetBearishSmt = na


        // log.info('------------------')
        // for [index, highCandleIndex] in arrMainAssetHighs 
        //     log.info("--->>>" + str.tostring(highCandleIndex))
        // log.info('------------------')

        Candle ProcessedHigh = na
        
        // leftMost  := 1000000
        // rightMost := -1

        var label[] arrHighLabels = array.new<label>()
        for j = 0 to (arrHighLabels.size() == 0 ? na : array.size(arrHighLabels) - 1)
            label.delete(array.get(arrHighLabels, j))
        array.clear(arrHighLabels)


        leftMost  := -1
        rightMost := -1
        bool leftHighAdded = false

        for i = 1 to arrSortedHighsIndices.size()
            continue
            highCandleIndex = arrSortedHighsIndices.get(-i)
            bool isHighestHigh = (i == 1)  // first in reverse = highest high

            // Initialize bounds for the first (highest) high
            if isHighestHigh
                leftMost  := highCandleIndex
                rightMost := highCandleIndex

            bool isLeftExpansion  = highCandleIndex < leftMost
            bool isRightExpansion = highCandleIndex > rightMost

            // Skip if not expanding left/right, unless it's the highest high
            if (isLeftExpansion and leftHighAdded) or not (isHighestHigh or isLeftExpansion or isRightExpansion)
                continue

            if isRightExpansion
                rightMost := highCandleIndex
            else if isLeftExpansion
                leftMost := highCandleIndex
                leftHighAdded := true                             

            // Label text
            string textLabel = isHighestHigh ? 'HH' : isLeftExpansion ? 'L' : 'R'
            mainRegisteredCandle := mainAssetRegisteredCandles.get( highCandleIndex )
            newLabel = label.new( mainRegisteredCandle.highBarIndex, mainRegisteredCandle.highPrice, text = textLabel + ' - ' +str.tostring(i), style = label.style_label_down,
                                         color = color.maroon,
                                         textcolor = color.white,
                                         size = size.small
                                     )
            array.push(arrHighLabels, newLabel)




        leftMost  := -1
        rightMost := -1
        bool leftLowAdded = false  // Track if we already added the left low

        for i = 1 to arrSortedLowsIndices.size()
            lowCandleIndex = arrSortedLowsIndices.get(-i)
            bool isLowestLow = (i == 1)  // first in reverse = absolute lowest low

            // Initialize bounds for the lowest low
            if isLowestLow
                leftMost  := lowCandleIndex
                rightMost := lowCandleIndex

            bool isLeftExpansion  = lowCandleIndex < leftMost
            bool isRightExpansion = lowCandleIndex > rightMost

            // Skip irrelevant lows:
            // - skip left expansions if we already added one
            // - skip anything that is not left/right expansion or the lowest low
            // if (isLeftExpansion and leftLowAdded) or not (isLowestLow or isLeftExpansion or isRightExpansion)
            //     continue
            // if (isLeftExpansion or isRightExpansion)
            //     continue
            // leftLowAdded := true
            // if (isLeftExpansion and leftLowAdded) or not (isLeftExpansion or isRightExpansion)
            //     continue
            if not(isRightExpansion)
                continue
            // Update bounds
            if isLeftExpansion
                leftMost := lowCandleIndex
                leftLowAdded := true  // Only one left low allowed
            else if isRightExpansion
                rightMost := lowCandleIndex  // Keep all right-side expansions

            // Label text
            string textLabel = isLowestLow ? 'LL' : isLeftExpansion ? 'L' : 'R'

            mainRegisteredCandle := mainAssetRegisteredCandles.get(lowCandleIndex)
            newLabel =label.new(
                 mainRegisteredCandle.lowBarIndex,
                 mainRegisteredCandle.lowPrice,
                 text = textLabel,
                 style = label.style_label_up,
                 color = color.new(color.teal, 0),
                 textcolor = color.white,
                 size = size.small
             )
            array.push(arrHighLabels, newLabel)


        for i = 0 to  arrMainAssetHighs.size() -1
            break
            // if(i > 3)
            //     break
            //break
            highCandleIndex = arrMainAssetHighs.get( i )
            // if not (highCandleIndex < leftMost or highCandleIndex > rightMost)
            //     continue
    
            // bool isLeftExpansion  = highCandleIndex < leftMost
            // bool isRightExpansion = highCandleIndex > rightMost

            mainRegisteredCandle := mainAssetRegisteredCandles.get( highCandleIndex )

            // log.info(str.tostring(highCandleIndex) )
            newLabel = label.new( mainRegisteredCandle.highBarIndex, mainRegisteredCandle.highPrice, text = str.tostring(highCandleIndex), style = label.style_label_down,
                                         color = color.maroon,
                                         textcolor = color.white,
                                         size = size.small
                                     )
            array.push(arrHighLabels, newLabel)
            continue

            for [symbolIndex, monitoredSymbol] in ARR_MONITORED_ASSETS

                if (symbolIndex == 0)
                    if not na(FirtsAssetBearishSmt)
                        continue
                    CompareAssetCandle      := SecondAssetCandle  
                    compareRegisteredCandle := secondAssetRegisteredCandles.get( highCandleIndex )
                else
                    //if not na(SecondAssetBearishSmt)
                    continue
                    CompareAssetCandle      := ThirdAssetCandle  
                    compareRegisteredCandle := thirdAssetRegisteredCandles.get( highCandleIndex )

                float mainAssetMove = MainAssetCandle.highPrice    - mainRegisteredCandle.highPrice 
                float compAssetMove = CompareAssetCandle.highPrice - compareRegisteredCandle.highPrice 


                if( (0 == mainAssetMove and 0 == compAssetMove) or ( (mainAssetMove * compAssetMove) > 0 ) )
                    continue

                Smt detectedBearishSmt = Smt.new(Type = SmtType.TimeBasedBearish, 
                                                     StartBarIndex = mainRegisteredCandle.highBarIndex , StartPrice = mainRegisteredCandle.highPrice,
                                                     EndBarIndex = MainAssetCandle.barIndex, EndPrice =  MainAssetCandle.highPrice, IsValid = true)

                if (not na (ProcessedHigh)) and ProcessedHigh.highPrice > MainAssetCandle.highPrice
                    detectedBearishSmt.EndPrice := ProcessedHigh.highPrice
                    detectedBearishSmt.EndBarIndex := ProcessedHigh.highBarIndex

                detectedBearishSmt.CorrAssetIndex := symbolIndex
                detectedBearishSmt.TimeFrame      := monitoredTimeFrameInSeconds
                detectedBearishSmt.TimeStamp      := time

                detectedBearishSmt.MainPointPrice := mainRegisteredCandle.highPrice
                detectedBearishSmt.CorrPointPrice := compareRegisteredCandle.highPrice
                
                detectedBearishSmt.MainPointTaken := detectedBearishSmt.MainPointTaken or (detectedBearishSmt.MainPointPrice < MainAssetCandle.highPrice)
                detectedBearishSmt.CorrPointTaken := detectedBearishSmt.CorrPointTaken or (detectedBearishSmt.CorrPointPrice < ( (symbolIndex == 0) ? SecondAssetCandle.highPrice : ThirdAssetCandle.highPrice) )

                detectedBearishSmt.LabelText      := monitoredSymbol + ' - ' + monitoredTimeFrame

                //ProcessedHigh := mainRegisteredCandle  
                if(symbolIndex == 0)
                    FirtsAssetBearishSmt  := detectedBearishSmt
                else    
                    SecondAssetBearishSmt := detectedBearishSmt

                  


        SecondAssetBearishSmt := na
        //arrBerishDetectedSmt.set(symbolIndex, detectedBearishSmt)

        string bearishSmtKeyPrefix   = SmtTypeToString.get(SmtType.TimeBasedBearish) + '-' + monitoredTimeFrame + '-' //+ ARR_MONITORED_ASSETS.get(detectedBearishSmt.CorrAssetIndex)
        if( not na(FirtsAssetBearishSmt) )    
            string bearishSmtKey = bearishSmtKeyPrefix + ARR_MONITORED_ASSETS.get(0)
            Smt existingBearishSmt = SmtMapHolder.get(bearishSmtKey)

            if( (not na(existingBearishSmt)) and (not existingBearishSmt.IsValid) )    
                existingBearishSmt.invalidate()
                SmtMapHolder.remove(bearishSmtKey)

            if( (not na(existingBearishSmt)) and (existingBearishSmt.IsValid) )    
                if(existingBearishSmt.MainPointPrice != FirtsAssetBearishSmt.MainPointPrice)
                    existingBearishSmt.invalidate()
                    SmtMapHolder.remove(bearishSmtKey)
                    SmtMapHolder.put(bearishSmtKey, FirtsAssetBearishSmt)
                    FirtsAssetBearishSmt.draw()

            if (na(existingBearishSmt))    
                SmtMapHolder.put(bearishSmtKey, FirtsAssetBearishSmt)
                FirtsAssetBearishSmt.draw()


        if( not na(SecondAssetBearishSmt) )    
            string bearishSmtKey = bearishSmtKeyPrefix + ARR_MONITORED_ASSETS.get(0)
            Smt existingBearishSmt = SmtMapHolder.get(bearishSmtKey) // vad daca pentru primul exists
            if( (not na(existingBearishSmt)) and (existingBearishSmt.IsValid) )
                if(existingBearishSmt.MainPointPrice == SecondAssetBearishSmt.MainPointPrice)
                    SecondAssetBearishSmt.IsValid := false

            bearishSmtKey := bearishSmtKeyPrefix + ARR_MONITORED_ASSETS.get(1)
            Smt secondExistingSmt = SmtMapHolder.get(bearishSmtKey)
            if( (not na(secondExistingSmt)) and (not secondExistingSmt.IsValid) )    
                secondExistingSmt.invalidate()
                SmtMapHolder.remove(bearishSmtKey)

            if( ((not na(secondExistingSmt)) and (secondExistingSmt.IsValid)) and  ( not na(existingBearishSmt)) and (existingBearishSmt.IsValid) )      
                if(existingBearishSmt.MainPointPrice == secondExistingSmt.MainPointPrice)
                    secondExistingSmt.invalidate()
                    SmtMapHolder.remove(bearishSmtKey)

            if( SecondAssetBearishSmt.IsValid and  (not na(secondExistingSmt)) and ( secondExistingSmt.IsValid) )    
                if(secondExistingSmt.MainPointPrice != SecondAssetBearishSmt.MainPointPrice)
                    secondExistingSmt.invalidate()
                    SmtMapHolder.remove(bearishSmtKey)
                    SmtMapHolder.put(bearishSmtKey, SecondAssetBearishSmt)
                    SecondAssetBearishSmt.draw()

            if( SecondAssetBearishSmt.IsValid and na(secondExistingSmt))
                SmtMapHolder.put(bearishSmtKey, SecondAssetBearishSmt)
                SecondAssetBearishSmt.draw()


//         if( (not na(detectedBearishSmt)) and detectedBearishSmt.IsValid )
            

//             string bearishSmtKey   = SmtTypeToString.get(SmtType.TimeBasedBearish) + '-' + monitoredTimeFrame + '-' + ARR_MONITORED_ASSETS.get(detectedBearishSmt.CorrAssetIndex)
//             Smt existingBearishSmt = SmtMapHolder.get(bearishSmtKey)
//             if( (not na(existingBearishSmt))  and existingBearishSmt.IsValid)
//                 existingBearishSmt.invalidate()
//                 SmtMapHolder.remove(bearishSmtKey)

//             if(detectedBearishSmt.CorrAssetIndex == 0) // First Priority
//                 existingBearishSmt := SmtMapHolder.get(SmtTypeToString.get(SmtType.TimeBasedBearish) + '-' + monitoredTimeFrame + '-' + str.tostring(1))
//                 if(not na(existingBearishSmt))
//                     existingBearishSmt.invalidate()

// //            string bullishSmtKey  = SmtTypeToString.get(SmtType.TimeBasedBullish) + '-' + monitoredTimeFrame + '-' + monitoredAsset
//             SmtMapHolder.put(bearishSmtKey, detectedBearishSmt)
//             detectedBearishSmt.draw()







                    // if (MainAssetCandle.highPrice > existingBearishSmt.EndPrice)
                    //     existingBearishSmt.EndBarIndex := MainAssetCandle.barIndex
                    //     existingBearishSmt.EndPrice    := MainAssetCandle.highPrice 





            //log.info(str.tostring(mainAssetCandle.openPrice) + ' ' + str.tostring(secondAssetCandle.openPrice) + ' ' + str.tostring(thirdAssetCandle.openPrice) + ' ' )        
            //log.info('----------------------------------')    
            // log.info(str.tostring(mainAssetCandle.openPrice) + ' ' + str.tostring(secondAssetCandle.openPrice) + ' ' + str.tostring(thirdAssetCandle.openPrice) + ' ' )        
            // log.info(str.format_time(mainAssetRegisteredCandles.last().openTime , "yyyy-MM-dd HH:mm:ss" , TIMEZONE_NY) +  "  !=   "  +str.format_time(secondAssetRegisteredCandles.last().openTime , "yyyy-MM-dd HH:mm:ss", TIMEZONE_NY) )
            // log.info(str.format_time(secondAssetRegisteredCandles.last().openTime , "yyyy-MM-dd HH:mm:ss" , TIMEZONE_NY) +  "  !=   "  +str.format_time(secondAssetRegisteredCandles.last().openTime , "yyyy-MM-dd HH:mm:ss", TIMEZONE_NY) )
