compareTimeFrames(string timeFrame1, string timeFrame2) =>
    sec1 = timeframe.in_seconds(timeFrame1)
    sec2 = timeframe.in_seconds(timeFrame2)
    result = sec1 < sec2 ? -1 : sec1 > sec2 ? 1 : 0
    result


// -- DATA STRUCTURES --
enum SwingType
    SwingHigh = 'SH'
    SwingLow  = 'SL'

type Candle
    float open        = na
    float high        = na
    float low         = na
    float close       = na
    int openTime      = na
    int closeTime     = na
    int barIndex      = na

    int openBarIndex  = na
    int highBarIndex  = na
    int lowBarIndex   = na
    int closeBarIndex = na

type Swing
    Candle swingCandle  = na
    SwingType swingType = na
//    label swingLabel    = na   


method isEqualTo(Candle this, Candle toCompare) =>
    switch
        nz(this.open)  != nz(toCompare.open)          => false
        nz(this.high)  != nz(toCompare.high)          => false
        nz(this.low)   != nz(toCompare.low)           => false
        nz(this.close) != nz(toCompare.close)         => false
        nz(this.openTime)  != nz(toCompare.openTime)  => false
        nz(this.closeTime) != nz(toCompare.closeTime) => false
        => true

method hasAllPrices(Candle this) =>
    switch
        na(this.open)  => false
        na(this.high)  => false
        na(this.low)   => false
        na(this.close) => false
        => true

type CandlesList
    array<Candle> arrCandles

type SwingsList
    array<Swing> arrSwings

var map<string, CandlesList> candlesMapHolder = map.new<string, CandlesList>()
var map<string, SwingsList>  swingsMapHolder  = map.new<string, SwingsList>()


getSymbolTickerId(string symbol) =>
    switch symbol
        "NQ1!" => "CME_MINI:NQ1"
        "ES1!" => "CME_MINI:ES1!" 
        "YM1!" => "CBOT_MINI:YM1!"
        => na

getSymbolMapKey(string symbol, string timeFrame) =>
    symbol + '-' + timeFrame

method registerSwing(map<string, SwingsList> this , string symbol, string timeFrame, Swing swingToRegister) => 
    int maxSwingsToKeep  = timeframe.in_seconds(timeFrame) < 86400 ? 150 : 25 
    string swingMapKey  = getSymbolMapKey( symbol, timeFrame) + '-' + str.tostring( swingToRegister.swingType )
    SwingsList arrSwingsList  = this.contains(swingMapKey) ? this.get(swingMapKey) : SwingsList.new(array.new<Swing>())
    Swing lastRegisteredSwing = arrSwingsList.arrSwings.size() > 0 ?  arrSwingsList.arrSwings.last() : na

    bool canRegisterNewSwing = true
    if( not na(lastRegisteredSwing) and lastRegisteredSwing.swingCandle.barIndex == swingToRegister.swingCandle.barIndex)    
        canRegisterNewSwing := lastRegisteredSwing.swingType != swingToRegister.swingType

    if( canRegisterNewSwing )
        arrSwingsList.arrSwings.push(swingToRegister)

    if(arrSwingsList.arrSwings.size() > maxSwingsToKeep)
        arrSwingsList.arrSwings.shift()
        
    this.put(swingMapKey, arrSwingsList)
    //log.info("Registered Swing" + str.tostring(swingToRegister.swingType))

method getRegisteredSwings(map<string, SwingsList> this,  string symbol, string timeFrame, SwingType swingType) => 
    string swingMapKey  = getSymbolMapKey( symbol, timeFrame) + '-' + str.tostring( swingType)
    SwingsList arrSwingsList = this.get(swingMapKey)
    na(arrSwingsList) ?  array.new<Swing>() : arrSwingsList.arrSwings



method registerCandle(map<string, CandlesList>candlesMapHolder, string symbolKey, Candle candle) => 
    
    const int maxCandlesToKeep  = 24
    
    CandlesList arrCandlesList  = candlesMapHolder.contains(symbolKey) ? candlesMapHolder.get(symbolKey) : CandlesList.new(array.new<Candle>())
    Candle lastRegisteredCandle = arrCandlesList.arrCandles.size() > 0 ?  arrCandlesList.arrCandles.last() : na

    bool canRegisterNewCandle   = (not na(lastRegisteredCandle)) ? (candle.openTime != lastRegisteredCandle.openTime and candle.closeTime != lastRegisteredCandle.closeTime) : true

    if ( canRegisterNewCandle )
        arrCandlesList.arrCandles.push(candle)

    if(arrCandlesList.arrCandles.size() > maxCandlesToKeep)
        arrCandlesList.arrCandles.shift()
        
    candlesMapHolder.put(symbolKey, arrCandlesList)


method getRegisteredCandles(map<string, CandlesList>candlesMapHolder, symbolKey) => 
    CandlesList arrCandlesList = candlesMapHolder.get(symbolKey)
    na(arrCandlesList) ?  array.new<Candle>() : arrCandlesList.arrCandles

higherTimeFrameHasChanged(string higherTimeFrame) => 
    switch higherTimeFrame
        "240" => timeframe.change('240')
        "90"  => timeframe.change('90')
        "60"  => timeframe.change('60')
        "30"  => timeframe.change('30')
        "15"  => timeframe.change('15')
        "5"   => timeframe.change('5')
        "3"   => timeframe.change('3')
        "1"   => timeframe.change('1')

        "1D"  => timeframe.change('1D')
        "1W"  => timeframe.change('1W')
        "1M"  => timeframe.change('1M')
        "3M"  => timeframe.change('3M')
        "12M" => timeframe.change('12M')
        => false



registerCandlesHistory() =>

    var map<string, Candle> tempCandlesMapHolder = map.new<string, Candle>()

    Candle lastConfirmedCandle = barstate.isconfirmed ?  Candle.new(open, high, low, close, time, time_close, bar_index, bar_index, bar_index, bar_index, bar_index) : na

    if(not na(lastConfirmedCandle) )
        candlesMapHolder.registerCandle(getSymbolMapKey(syminfo.ticker, timeframe.period), lastConfirmedCandle)
        //log.info("Registering candle => " + syminfo.ticker + "   " +  timeframe.period)
    for monitoredTimeFrame in ARR_TIME_FRAMES_TO_MONITOR
        if ( not tempCandlesMapHolder.contains(monitoredTimeFrame) and compareTimeFrames(timeframe.period, monitoredTimeFrame) < 0 ) 
            tempCandlesMapHolder.put(monitoredTimeFrame, Candle.new())
        
    // for monitoredTimeFrame in tempCandlesMapHolder.keys()
    //     log.info("Key->>" + monitoredTimeFrame)

    for monitoredTimeFrame in tempCandlesMapHolder.keys()
        Candle monitoredCandle = tempCandlesMapHolder.get(monitoredTimeFrame)
        if(na(monitoredCandle))
            continue 

        if ( barstate.isnew and higherTimeFrameHasChanged(monitoredTimeFrame) ) 
            if(monitoredCandle.hasAllPrices())
                candlesMapHolder.registerCandle(getSymbolMapKey(syminfo.ticker, monitoredTimeFrame), monitoredCandle.copy())
                //log.info("Register candle timeframe -> " + monitoredTimeFrame)
                
            monitoredCandle := Candle.new(open, na, na, na, time, na, bar_index, bar_index, na, na, na)                    
            tempCandlesMapHolder.put(monitoredTimeFrame, monitoredCandle)


        if( na(lastConfirmedCandle) )
            continue
        
        monitoredCandle.close         := lastConfirmedCandle.close
        monitoredCandle.closeTime     := lastConfirmedCandle.closeTime
        monitoredCandle.closeBarIndex := lastConfirmedCandle.closeBarIndex

        monitoredCandle.high  := na(monitoredCandle.high) ? lastConfirmedCandle.high : math.max(monitoredCandle.high, lastConfirmedCandle.high)
        monitoredCandle.low   := na(monitoredCandle.low)  ? lastConfirmedCandle.low  : math.min(monitoredCandle.low, lastConfirmedCandle.low)

        if(monitoredCandle.high == lastConfirmedCandle.high)
            monitoredCandle.highBarIndex := lastConfirmedCandle.highBarIndex             

        if(monitoredCandle.low == lastConfirmedCandle.low)
            monitoredCandle.lowBarIndex := lastConfirmedCandle.lowBarIndex             

        tempCandlesMapHolder.put(monitoredTimeFrame, monitoredCandle)

        //if(session.)    

        // session.islastbar and barstate.isconfirmed - pune ultimull candle asa


registerCandlesHistory()


registerOtherAssetsCandlesHistory() => 

    for monitoredTimeFrame in ARR_TIME_FRAMES_TO_MONITOR

        if( (compareTimeFrames(monitoredTimeFrame, timeframe.period) < 0) ) //or ( not higherTimeFrameHasChanged(monitoredTimeFrame) ) 
            continue

        Candle otherAssetCandle = na    
        if not na(firstMonitoredAsset) and str.length(str.trim(firstMonitoredAsset)) != 0
            [o, h, l, c, ot, ct, bi] = request.security(firstMonitoredAsset, monitoredTimeFrame, [open[1], high[1], low[1], close[1], time[1], time_close[1], bar_index[1]], lookahead = barmerge.lookahead_off)
                         //[open[1], high[1], low[1], close[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
                    
            otherAssetCandle := Candle.new(o, h, l, c, ot, ct, bi)

            if otherAssetCandle.hasAllPrices()
                candlesMapHolder.registerCandle(getSymbolMapKey(firstMonitoredAsset, monitoredTimeFrame), otherAssetCandle.copy())
                // if monitoredTimeFrame == '1'
                //     log.info(  " TimeFrane -> "+ monitoredTimeFrame + "   Candle | O: " + str.tostring(otherAssetCandle.open) + " H: " + str.tostring(otherAssetCandle.high) + " L: " + str.tostring(otherAssetCandle.low) + " C: " + str.tostring(otherAssetCandle.close, '#.##########'))

        if not na(secondMonitoredAsset) and str.length(str.trim(secondMonitoredAsset)) != 0
            [o, h, l, c, ot, ct, bi] = request.security(secondMonitoredAsset, monitoredTimeFrame,[open[1], high[1], low[1], close[1], time[1], time_close[1], bar_index[1]], lookahead = barmerge.lookahead_off)
                         //[open[1], high[1], low[1], close[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
                    
            otherAssetCandle := Candle.new(o, h, l, c, ot, ct, bi)

            if otherAssetCandle.hasAllPrices()
                candlesMapHolder.registerCandle(getSymbolMapKey(secondMonitoredAsset, monitoredTimeFrame), otherAssetCandle.copy())
            //log.info(  " TimeFrane -> "+ monitoredTimeFrame + "   Candle | O: " + str.tostring(otherAssetCandle.open) + " H: " + str.tostring(otherAssetCandle.high) + " L: " + str.tostring(otherAssetCandle.low) + " C: " + str.tostring(otherAssetCandle.close, '#.##########'))

registerOtherAssetsCandlesHistory()


processRegisteredCandles() =>
   
    var arrRegisteredCandles =  array.new<Candle>() 

    for monitoredSymbol in array.concat(array.from(syminfo.ticker), arrMonitoredSymbols)
        for monitoredTimeFrame in ARR_TIME_FRAMES_TO_MONITOR
            if( (not barstate.isconfirmed) or (compareTimeFrames(monitoredTimeFrame, timeframe.period) < 0) )
                continue

            arrRegisteredCandles :=  candlesMapHolder.getRegisteredCandles(getSymbolMapKey(monitoredSymbol, monitoredTimeFrame))
            //log.info("Sym -> " + monitoredSymbol + " timeframe -> " + monitoredTimeFrame + " size -> " + str.tostring(arrRegisteredCandles.size()))    

            if(arrRegisteredCandles.size() < 3)
                continue
            
            Candle prevCandle = arrRegisteredCandles.get(arrRegisteredCandles.size() - 3)
            Candle midCandle  = arrRegisteredCandles.get(arrRegisteredCandles.size() - 2)
            Candle nextCandle = arrRegisteredCandles.get(arrRegisteredCandles.size() - 1)


            // Swing High
            if ( (midCandle.high >= prevCandle.high)  and  (midCandle.high >= nextCandle.high)  and  (  midCandle.high > prevCandle.high  or  midCandle.high > nextCandle.high  )  ) 
                swingsMapHolder.registerSwing(monitoredSymbol, monitoredTimeFrame, Swing.new(midCandle, SwingType.SwingHigh))    
                //log.info("register swing H here -> " + str.tostring(SwingType.SwingHigh))     
                // swHigh = createSwing(midBar.high, midBar.index, SwingType.SwingHigh)
                // addOrReplaceSwing(swHigh, maxSwingsStored)

            if ( (midCandle.high <= prevCandle.high)  and  (midCandle.high <= nextCandle.high)  and  (  midCandle.high < prevCandle.high  or  midCandle.high < nextCandle.high  )  ) 
                swingsMapHolder.registerSwing(monitoredSymbol, monitoredTimeFrame, Swing.new(midCandle, SwingType.SwingLow)) 
                //log.info("register swing L here")     

            // swLow = createSwing(midBar.low, midBar.index, SwingType.SwingLow)
            // addOrReplaceSwing(swLow, maxSwingsStored)

processRegisteredCandles()

enum SmtType
    Bullish = 'Asset A breaks a lower low, B does not → Bullish SMT'
    Bearish = 'Another Long String Here'

type SMT
    SmtType Type
    Candle StartCandle
    Candle EndCandle
    bool IsSwingBased    
    bool IsValid
    line LineId


var map<string, SMT> detectedSmtMapHolder = map.new<string, SMT>()

detectSmt(SmtType smtType) =>

    arrPrimarySwings   = swingsMapHolder.getRegisteredSwings(syminfo.ticker, '1', SwingType.SwingHigh)
    arrMonitoredSwings = swingsMapHolder.getRegisteredSwings('ES1!', '1', SwingType.SwingHigh)

    int indexA = array.size(arrPrimarySwings) - 1
    int indexB = array.size(arrMonitoredSwings) - 1

    bool checkBullishSmt = (smtType == SmtType.Bullish)

    int allowableBarsDifference = 2

    int timeThreshold = allowableBarsDifference * timeframe.in_seconds('1') * 1000
    SMT detectedSmt = na

    while indexA > 0 and indexB > 0 and na(detectedSmt)
        primaryCurrentSwing    = arrPrimarySwings.get(indexA)
        primaryPreviousSwing   = arrPrimarySwings.get(indexA - 1)
        monitoredCurrentSwing  = arrMonitoredSwings.get(indexB)
        monitoredPreviousSwing = arrMonitoredSwings.get(indexB - 1)

        timeDifference = math.abs(primaryCurrentSwing.swingCandle.openTime - monitoredCurrentSwing.swingCandle.openTime)

        aBreaksLow = primaryCurrentSwing.swingCandle.low   < primaryPreviousSwing.swingCandle.low
        bHoldsLow  = monitoredCurrentSwing.swingCandle.low >= monitoredPreviousSwing.swingCandle.low    //currB.price >= prevB.price  // Divergence or equal low

        aBreaksHigh = primaryCurrentSwing.swingCandle.high  > primaryPreviousSwing.swingCandle.high
        bHoldsHigh  = monitoredCurrentSwing.swingCandle.high <= monitoredPreviousSwing.swingCandle.high

        if timeDifference <= timeThreshold

            if (checkBullishSmt  and  (aBreaksLow and bHoldsLow) ) // bullish SMT detected here
                detectedSmt := SMT.new(SmtType.Bullish, primaryPreviousSwing.swingCandle, primaryCurrentSwing.swingCandle, true, true, na)
            else if(aBreaksHigh and bHoldsHigh) // berrish SMT detected here 
                detectedSmt := SMT.new(SmtType.Bearish, primaryPreviousSwing.swingCandle, primaryCurrentSwing.swingCandle, true, true, na)

            if not na (detectedSmt)
                detectedSmtMapHolder.put('TEST', detectedSmt)

            indexA -= 1
            indexB -= 1        
        else if ( primaryCurrentSwing.swingCandle.openTime > monitoredCurrentSwing.swingCandle.openTime )
            indexA -= 1
        else
            indexB -= 1

    //log.info('---------------------------------------------------------------------')


