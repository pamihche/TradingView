//@version=6
indicator("Advanced HTF Candle Builder", overlay=true)

// -- CONSTANTS --
const string[] ARR_MONITOR_TIME_FRAMES = array.from("240", "90", "60", "30", "15", "5", "3", "1")

// -- DATA STRUCTURES --
type Candle
    float open
    float high
    float low
    float close

// -- HELPERS --
canRequestNewData(string checkTimeFrame) =>
    bool canRequest = false
    if barstate.isnew
        int currentSeconds = timeframe.in_seconds(timeframe.period)
        int checkSeconds = timeframe.in_seconds(checkTimeFrame)

        if not na(checkSeconds) and checkSeconds > 86400
            and checkSeconds >= currentSeconds
            and timeframe.change(checkTimeFrame)
            canRequest := true
        else if not na(checkSeconds) and checkSeconds > 0
            and (
                (checkSeconds == currentSeconds) or
                (
                    checkSeconds > currentSeconds and
                    checkSeconds % currentSeconds == 0 and
                    timeframe.change(checkTimeFrame)
                )
            )
            canRequest := true
    canRequest

// -- STORAGE --
var map<string, Candle> candlesMapHolder = map.new<string, Candle>()
var map<string, Candle> tempCandlesMapHolder = map.new<string, Candle>()

// -- MAIN EXECUTION --
update_htf_data() =>
    string tf = timeframe.period

    // Create confirmed candle from previous bar of current TF
    confirmedCandle = Candle.new(open[1], high[1], low[1], close[1])

    // Store it as the most recently closed candle for this TF
    candlesMapHolder.put(tf, confirmedCandle)

    // Initialize temp HTF candles (only once), skipping the current TF
    if tempCandlesMapHolder.size() == 0
        for tf_string in ARR_MONITOR_TIME_FRAMES
            if tf_string != tf
                tempCandlesMapHolder.put(tf_string, Candle.new(confirmedCandle.open, na, na, na))

    // Update temp HTF candles and confirm if their bar is complete
    for [tf_string, tempCandle] in tempCandlesMapHolder
        tempCandle.high := math.max(tempCandle.high, confirmedCandle.high)
        tempCandle.low  := math.min(tempCandle.low, confirmedCandle.low)
        tempCandle.close := canRequestNewData(tf_string) ? confirmedCandle.close : na

        if na(tempCandle.close)
            continue

        // Confirm the candle by copying the confirmedCandle into candlesMapHolder
        candlesMapHolder.put(tf_string, confirmedCandle.copy())

        // Reset the temp candle for the next HTF bar
        tempCandle.open := confirmedCandle.open
        tempCandle.high := na
        tempCandle.low  := na
        tempCandle.close := na

// -- CALL MAIN --
if canRequestNewData(timeframe.period)
    update_htf_data()
