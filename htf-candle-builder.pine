isNewTradingDay() =>
    timeframe.change('1D')
    
compareTimeFrames(string timeFrame1, string timeFrame2) =>
    sec1   = timeframe.in_seconds(timeFrame1)
    sec2   = timeframe.in_seconds(timeFrame2)
    result = sec1 < sec2 ? -1 : sec1 > sec2 ? 1 : 0

getSymbolTickerId(string symbol) =>
    switch symbol
        "NQ1!" => "CME_MINI:NQ1"
        "ES1!" => "CME_MINI:ES1!" 
        "YM1!" => "CBOT_MINI:YM1!"
        => na

isInRecentFuturesPeriod(_count, unit) =>
    count = _count <= 0 ? 1 : _count

    const int dayMs = 86400000
    const int hourStart = 18

    hourNow = hour(timenow, TIMEZONE_NY)
    isBeforeSessionStart = hourNow < 18
    baseNow = timenow - (isBeforeSessionStart ? dayMs : 0)

    int sessionStart = na

    if unit == "D"
        offsetMs = (count - 1) * dayMs
        refTime = baseNow - offsetMs
        y = year(refTime, TIMEZONE_NY)
        m = month(refTime, TIMEZONE_NY)
        d = dayofmonth(refTime, TIMEZONE_NY)
        sessionStart := timestamp(TIMEZONE_NY, y, m, d, 18, 0)

    else if unit == "W"
        wd = dayofweek(timenow, TIMEZONE_NY)
        daysBack = wd - 1 + (isBeforeSessionStart ? 1 : 0)
        totalDaysBack = (count - 1) * 7 + daysBack
        refTime = timenow - totalDaysBack * dayMs
        y = year(refTime, TIMEZONE_NY)
        m = month(refTime, TIMEZONE_NY)
        d = dayofmonth(refTime, TIMEZONE_NY)
        sessionStart := timestamp(TIMEZONE_NY, y, m, d, 18, 0)

    else if unit == "M"
        curY = year(timenow, TIMEZONE_NY)
        curM = month(timenow, TIMEZONE_NY)
        shift = isBeforeSessionStart and dayofmonth(timenow, TIMEZONE_NY) == 1 ? 1 : 0
        newM = curM - (count - 1 + shift)
        newY = curY
        while newM < 1
            newM += 12
            newY -= 1
        sessionStart := timestamp(TIMEZONE_NY, newY, newM, 1, 18, 0)

    inPeriod = (time  >= sessionStart )

    // var int barCount = na
    // barCount := na(barCount) or not inPeriod ? 0 : barCount + 1
    // barsAgo = inPeriod ? barCount - 1 : na

    // [inPeriod, barsAgo]

higherTimeFrameHasChanged(string higherTimeFrame) => 
    switch higherTimeFrame
        "360" => timeframe.change('360')
        "240" => timeframe.change('240')
        "90"  => timeframe.change('90')
        "60"  => timeframe.change('60')
        "30"  => timeframe.change('30')
        "15"  => timeframe.change('15')
        "5"   => timeframe.change('5')
        "3"   => timeframe.change('3')
        "1"   => timeframe.change('1')

        "1D"  => timeframe.change('1D')
        "1W"  => timeframe.change('1W')
        "1M"  => timeframe.change('1M')
        "3M"  => timeframe.change('3M')
        "12M" => timeframe.change('12M')

        => false

// -- DATA STRUCTURES --

type Candle
    float openPrice   = 0
    float highPrice   = 0
    float lowPrice    = 0
    float closePrice  = 0
    int openTime      = 0
    int closeTime     = 0
    int barIndex      = 0

    int openBarIndex  = 0
    int highBarIndex  = 0
    int lowBarIndex   = 0
    int closeBarIndex = 0
    
    string TEST = na

type SessionCycle
    string Key  = na
    string Name = na
    string Period = na
    int StartTimeStamp = na
    int EndTimeStamp = na
    Candle FirstCandle = na
    Candle LastCandle = na
    Candle HighestCandle = na
    Candle LowestCandle = na

type Session
    string Name = na
    string Key = na
    SessionCycle[] Cycles = na

enum SmtType
    TimeBasedBullish    = 'TBU'
    TimeBasedBearish    = 'TBE'
    SessionBasedBullish = 'SBU'
    SessionBasedBearish = 'SBE'
    CycleBasedBullish   = 'CBU'
    CycleBasedBearish   = 'CBE'

type Smt
    SmtType Type = na
    int StartBarIndex = 0
    float StartPrice  = 0
    int EndBarIndex   = 0
    float EndPrice    = 0

    bool IsValid  = true
    line Line     = na
    label Label   = na

    bool MainPointTaken       = false
    bool CorrelatedPointTaken = false

    float MainPointPrice = 0    
    float CorrPointPrice = 0

type CandlesList
    array<Candle> arrCandles

var map<string, CandlesList> CandlesMapHolder = map.new<string, CandlesList>()
var map<string, Session> SessionsMapHolder    = map.new<string, Session>()
var map<SmtType, string> SmtTypeToString      = map.new<SmtType, string>()
var map<string, Smt> SmtMapHolder             = map.new<string, Smt>()

var Candle MainAssetCandle    = Candle.new()  
var Candle SecondAssetCandle  = Candle.new()
var Candle ThirdAssetCandle   = Candle.new()


method getPeriod(Session this) =>
    first = this.Cycles.first()
    last  = this.Cycles.last()
    str.format("{0}-{1}",  array.get(str.split(first.Period, "-"), 0), array.get(str.split(last.Period, "-"), 1))

method isClosed(SessionCycle this) =>
    bool isClosed = (not na(this.LastCandle) ) and this.LastCandle.barIndex > 0 

method isActive(SessionCycle this) =>
    bool isInPeriod = (time >= this.StartTimeStamp and time_close <= this.EndTimeStamp)

method isClosed(Session this) =>
    bool isClosed = (na(this.Cycles) or this.Cycles.size() == 0) ? true : this.Cycles.last().LastCandle.barIndex != 0

method isActive(Session this) =>
    bool isOpen = (na(this.Cycles) or this.Cycles.size() == 0) ? false : time >= this.Cycles.first().StartTimeStamp  and time_close <= this.Cycles.last().EndTimeStamp



method setPrices(Candle this, float openPrice = open, float highPrice = high, float lowPrice = low, float closePrice = close) =>
    this.openPrice  := openPrice
    this.highPrice  := highPrice
    this.lowPrice   := lowPrice
    this.closePrice := closePrice

method setBarIndex(Candle this, int barIndex = bar_index) =>
    this.barIndex := barIndex

method setOpenCloseTime(Candle this, int openTime = time, int closeTime = time_close) =>
    this.openTime  := openTime
    this.closeTime := closeTime

method isBearish(Candle this) =>
    this.openPrice > this.closePrice
method isBullish(Candle this) => 
    this.openPrice < this.closePrice

method getSortingKey(Candle this, sortingOrder = order.ascending) =>
    string candleKey = na
    if not na(this.openTime) and not na(this.openPrice)
        timeKey    = sortingOrder == order.ascending  ? this.openTime  : -this.openTime
        priceKey   = sortingOrder == order.ascending  ? this.openPrice : -this.openPrice
        candleKey := str.tostring(timeKey, "#010") + "_"  + str.tostring(priceKey, "#010.4")
    candleKey

method isEqualTo(Candle this, Candle toCompare) =>
    switch
        nz(this.barIndex)   != nz(toCompare.barIndex)    => false
        nz(this.openPrice)  != nz(toCompare.openPrice)   => false
        nz(this.highPrice)  != nz(toCompare.highPrice)   => false
        nz(this.lowPrice)   != nz(toCompare.lowPrice)    => false
        nz(this.closePrice) != nz(toCompare.closePrice)  => false
        nz(this.openTime)   != nz(toCompare.openTime)    => false
        nz(this.closeTime)  != nz(toCompare.closeTime)   => false
        => true

method hasAllPrices(Candle this) =>
    switch
        nz(this.openPrice) == 0 => false
        nz(this.highPrice) == 0 => false
        nz(this.lowPrice)  == 0 => false
        nz(this.closePrice)== 0 => false
        => true

method logPrices(Candle this) =>
    log.info('O: ' + str.tostring(this.openPrice) + ' H: ' + str.tostring(this.highPrice)  + ' L: ' + str.tostring(this.lowPrice)  + ' C: ' + str.tostring(this.closePrice))

method getSymbolKey(map<string, CandlesList>this, string symbol, string timeFrame) =>
    na(this) ? '' : symbol + '-' + timeFrame

method getRegisteredCandles(map<string, CandlesList>CandlesMapHolder, symbolKey) => 
    CandlesList arrCandlesList = CandlesMapHolder.get(symbolKey)
    na(arrCandlesList) or na(arrCandlesList.arrCandles)?  array.new<Candle>() : arrCandlesList.arrCandles
    
method getLastRegisteredCandles(map<string, CandlesList>this, string symbolKey, int howMany) => 
    CandlesList arrCandlesList = this.get(symbolKey)
    arrLastCandles = array.new<Candle>()

    if not na(arrCandlesList) and not na ( arrCandlesList.arrCandles) and howMany > 0 and  arrCandlesList.arrCandles.size() > 0
        int arrSize     = arrCandlesList.arrCandles.size()
        int actualCount = arrSize - math.min(howMany,arrSize)
        for i =  arrSize -1 to actualCount 
            arrLastCandles.push( arrCandlesList.arrCandles.get(i).copy() )
    arrLastCandles

method getLastRegisteredCandle(map<string, CandlesList>this, string symbolKey) => 
    CandlesList arrCandlesList = this.get(symbolKey)
    Candle lastRegisteredCandle = not na(arrCandlesList) and not na( arrCandlesList.arrCandles) and arrCandlesList.arrCandles.size() > 0 ?  arrCandlesList.arrCandles.last().copy() : na
    //lastRegisteredCandle


method getDeepInstance(Session this) =>
    Session newSession = Session.new(this.Key, this.Name)
    newSession.Cycles := array.new<SessionCycle>()
    for [index, originalCycle] in this.Cycles
        newCycle = SessionCycle.new(Key = originalCycle.Key, Name = originalCycle.Name, Period = originalCycle.Period, FirstCandle = Candle.new(), LastCandle = Candle.new(), HighestCandle = Candle.new(), LowestCandle = Candle.new())

        y = year(time, TIMEZONE_NY)
        m = month(time, TIMEZONE_NY)
        d = dayofmonth(time, TIMEZONE_NY)
        h = hour(time, TIMEZONE_NY) 
        parts = str.split(newCycle.Period, "-")
        startStr = array.get(parts, 0)
        endStr   = array.get(parts, 1)
        sh = int(str.tonumber(str.substring(startStr, 0, 2)))
        sm = int(str.tonumber(str.substring(startStr, 2)))
        eh = int(str.tonumber(str.substring(endStr, 0, 2)))
        em = int(str.tonumber(str.substring(endStr, 2)))
        crossMidnight = (eh < sh) or (eh == sh and em < sm)
        anchorHour = 18    
        anchorTs = timestamp(TIMEZONE_NY, y, m, d, anchorHour, 0)
        anchorTs := time < anchorTs ? timestamp(TIMEZONE_NY, y, m, d - 1, anchorHour, 0) : anchorTs
        ay = year(anchorTs, TIMEZONE_NY)
        am = month(anchorTs, TIMEZONE_NY)
        ad = dayofmonth(anchorTs, TIMEZONE_NY)

        sessionStartsTomorrow = sh < anchorHour
        startDay = ad + (sessionStartsTomorrow ? 1 : 0)
        endDay   = startDay + (crossMidnight ? 1 : 0)

        newCycle.StartTimeStamp := timestamp(TIMEZONE_NY, ay, am, startDay, sh, sm) //timestamp(TIMEZONE_NY, ay, am, ad, sh, sm) //timestamp(TIMEZONE_NY, y, m, d, sh, sm)
        newCycle.EndTimeStamp   := timestamp(TIMEZONE_NY, ay, am, endDay, eh, em) //timestamp(TIMEZONE_NY, ay, am, ad + (crossMidnight ? 1 : 0), eh, em) //timestamp(TIMEZONE_NY, y, m, crossMidnight ? d + 1 : d, eh, em)

        newSession.Cycles.push(newCycle)
    newSession.copy()

method registerCandle(Session this, Candle newCandle, string monitoredSymbol) =>

    for i = this.Cycles.size() - 1 to 0
        SessionCycle sessionCycle =  this.Cycles.get(i)

        if( na(newCandle) or (newCandle.barIndex == 0) or (newCandle.barIndex == sessionCycle.FirstCandle.barIndex) or (newCandle.barIndex == sessionCycle.LastCandle.barIndex) or  (newCandle.barIndex == sessionCycle.HighestCandle.barIndex) or  (newCandle.barIndex == sessionCycle.LowestCandle.barIndex)  )
            break

        if(sessionCycle.isClosed())
            continue

        bool isInPeriod      = newCandle.openTime >= sessionCycle.StartTimeStamp and newCandle.closeTime <= sessionCycle.EndTimeStamp
        bool isFirstInPeriod = newCandle.openTime  == sessionCycle.StartTimeStamp
        bool isLastInPeriod  = newCandle.closeTime == sessionCycle.EndTimeStamp

        if( not isInPeriod )
            continue

        if( isFirstInPeriod )    //and newCandle.isFirstInPeriod(sessionCycle.Period)
            sessionCycle.FirstCandle   := newCandle.copy()
            sessionCycle.HighestCandle := newCandle.copy()
            sessionCycle.LowestCandle  := newCandle.copy()
            this.Cycles.set(i, sessionCycle)
            break

        if( isLastInPeriod )
            sessionCycle.LastCandle := newCandle.copy()

        if( sessionCycle.HighestCandle.highPrice <= newCandle.highPrice )
            sessionCycle.HighestCandle := newCandle.copy()

        if( sessionCycle.LowestCandle.lowPrice >= newCandle.lowPrice )
            sessionCycle.LowestCandle := newCandle.copy()

        this.Cycles.set(i, sessionCycle)               
        break



method getAssetSessionKey(map<string, Session> this, string monitoredSymbol, string sessionKey) =>
    not(na(this)) ? monitoredSymbol + '-'+ sessionKey : ''

method handleSessions(map<string, Session> this) =>
    
    if( isNewTradingDay() )

        this.clear()

        AsiaSession = Session.new(SESSION_ASIA_KEY, 'Asia', Cycles = array.from(
             SessionCycle.new("SESSION_ASIA_1", 'C1', "1800-1900"),
             SessionCycle.new("SESSION_ASIA_2", 'C1', "1900-2030"),
             SessionCycle.new("SESSION_ASIA_3", 'C1', "2030-2200"),
             SessionCycle.new("SESSION_ASIA_4", 'C1', "2200-2330"),
             SessionCycle.new("SESSION_ASIA_5", 'C1', "2330-0100"),
             SessionCycle.new("SESSION_ASIA_6", 'C1', "0100-0230")
         ))

        LondonSession = Session.new(SESSION_LONDON_KEY, 'London', array.from(
             SessionCycle.new("SESSION_LONDON_1", 'C1', "0230-0400"),
             SessionCycle.new("SESSION_LONDON_2", 'C1', "0400-0530"),
             SessionCycle.new("SESSION_LONDON_3", 'C1', "0530-0700")
         ))

        NYAMSession = Session.new(SESSION_NY_AM_KEY, 'NYAM', array.from(
             SessionCycle.new("SESSION_NY_AM_1", 'C1', "0700-0830"),
             SessionCycle.new("SESSION_NY_AM_2", 'C1', "0830-1000"),
             SessionCycle.new("SESSION_NY_AM_3", 'C1', "1000-1130")
         ))

        NYPMSession = Session.new(SESSION_NY_PM_KEY, 'NYPM', array.from(
             SessionCycle.new("SESSION_NY_PM_1", 'C1', "1130-1300"),
             SessionCycle.new("SESSION_NY_PM_2", 'C1', "1300-1430"),
             SessionCycle.new("SESSION_NY_PM_3", 'C1', "1430-1600")
         ))
      
        //Session test = LondonSession.getDeepInstance()
        for monitoredSymbol in ARR_COMBINED_MONITORED_ASSETS
            this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_ASIA_KEY),   AsiaSession.getDeepInstance())
            this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_LONDON_KEY), LondonSession.getDeepInstance())
            this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_NY_AM_KEY),  NYAMSession.getDeepInstance())
            this.put(this.getAssetSessionKey(monitoredSymbol, SESSION_NY_PM_KEY),  NYPMSession.getDeepInstance())

    for monitoredSymbol in ARR_COMBINED_MONITORED_ASSETS
        for sessionKey in ARR_SESSIONS_KEYS
            string assetSessionKey = this.getAssetSessionKey(monitoredSymbol, sessionKey)
            Session registeredSession = this.get(assetSessionKey)
            if(na(registeredSession) or registeredSession.isClosed())
                continue

            Candle lastRegisteredCandle = CandlesMapHolder.getLastRegisteredCandle(CandlesMapHolder.getSymbolKey(monitoredSymbol, timeframe.period))

            if(na(lastRegisteredCandle))
                continue

            registeredSession.registerCandle(lastRegisteredCandle, monitoredSymbol)
            this.put(assetSessionKey, registeredSession)


method getActiveSession(map<string, Session> this) =>
    Session activeSession = na
    for sessionKey in ARR_SESSIONS_KEYS
        Session registeredSession = this.get(this.getAssetSessionKey(syminfo.ticker, sessionKey))
        if(not na(registeredSession) and registeredSession.isActive())
            activeSession := registeredSession
            break
    activeSession


method getAllSessionsCyclesKeys(map<string, Session> this, bool reversed = false) =>
    var arrAllCycles = array.new_string()
    if(arrAllCycles.size() == 0)
        for sessionKey in ARR_SESSIONS_KEYS
            Session registeredSession = this.get(this.getAssetSessionKey(syminfo.ticker, sessionKey))
            if(na(registeredSession))
                continue
            for cycle in registeredSession.Cycles
                arrAllCycles.push(cycle.Key)
        //arrAllCycles.reverse()

    if( reversed )
        var reversedArray = array.new_string()
        if( reversedArray.size() == 0 )
            reversedArray := arrAllCycles.copy()
            reversedArray.reverse()
        reversedArray
    else
        arrAllCycles


method getSessionHighestCandle(map<string, Session> this, string monitoredSymbol, string sessionKey) =>
    var map<string, Candle> cacheMap = map.new<string, Candle>()
    if(isNewTradingDay())
        cacheMap.clear()

    string sessionAssetKey    = this.getAssetSessionKey(monitoredSymbol, sessionKey)
    Candle highestCandle      = cacheMap.get(sessionAssetKey) // I am using same key here
    if( na(highestCandle) )
        Session registeredSession = this.get(sessionAssetKey)
        if not na(registeredSession) and not na(registeredSession.Cycles) and registeredSession.Cycles.size() > 0
            for sessionCycle in registeredSession.Cycles
                if na(highestCandle) or sessionCycle.HighestCandle.highPrice >= highestCandle.highPrice
                    highestCandle := sessionCycle.HighestCandle

        if( not na(highestCandle)  and  highestCandle.barIndex != 0  and registeredSession.isClosed())
            cacheMap.put(sessionAssetKey, highestCandle.copy())

    highestCandle

method getSessionLowestCandle(map<string, Session> this, string monitoredSymbol, string sessionKey) =>
    
    var map<string, Candle> cacheMap = map.new<string, Candle>()
    if(isNewTradingDay())
        cacheMap.clear()

    string sessionAssetKey =  this.getAssetSessionKey(monitoredSymbol, sessionKey)
    Candle lowestCandle    = cacheMap.get(sessionAssetKey) // I am using same key here

    if (na(lowestCandle))
        Session registeredSession = this.get(sessionAssetKey)
        if not na(registeredSession) and not na(registeredSession.Cycles)// and registeredSession.Cycles.size() > 0 
            for sessionCycle in registeredSession.Cycles
                if(sessionCycle.LowestCandle.barIndex == 0)
                    continue

                if na(lowestCandle)  or (sessionCycle.LowestCandle.lowPrice <= lowestCandle.lowPrice)
                    lowestCandle := sessionCycle.LowestCandle

        if(not na(lowestCandle) and lowestCandle.barIndex != 0 and registeredSession.isClosed())
            cacheMap.put(sessionAssetKey, lowestCandle.copy())
    
    lowestCandle

