//@version=6
indicator("Precise Swing Detector", overlay=true, max_labels_count=500)

// === Types ===
type BAR
    float open
    float high
    float low
    float close
    int index

enum SwingType
    SwingHigh
    SwingLow

type Swing
    float price
    int barIndex
    SwingType type
    label lbl

// === Parameters ===
maxBars         = 500                          // Max bars stored for swing detection
maxSwingsStored = 100                          // Max swings to store in memory
maxSwingLabels  = input.int(20, "Labels to Plot", minval=1, maxval=100)

// === Arrays ===
var bars   = array.new<BAR>()         // Stores recent bars
var swings = array.new<Swing>()       // Stores swings

// === Create bar and swing ===
createBar() =>
    BAR.new(open, high, low, close, bar_index)

createSwing(price, barIndex, type) =>
    Swing.new(price, barIndex, type, na)

// === Detect 3-bar swing patterns ===
isSwingHigh(prev, mid, next) =>
    mid >= prev and mid >= next and (mid > prev or mid > next)

isSwingLow(prev, mid, next) =>
    mid <= prev and mid <= next and (mid < prev or mid < next)

// === Label plotting ===
plotSwingLabel(sw) =>
    if not na(sw.lbl)
        label.delete(sw.lbl)
    txt = sw.type == SwingType.SwingHigh ? "SH" : "SL"
    col = sw.type == SwingType.SwingHigh ? color.green : color.red
    sw.lbl := label.new(
         sw.barIndex, sw.price, txt,
         style = sw.type == SwingType.SwingHigh ? label.style_label_down : label.style_label_up,
         color = color.new(col, 0),
         textcolor = color.white,
         size = size.tiny
     )

// === Single Entry Point: Add or Replace Swing ===
addOrReplaceSwing(newSwing, maxSwings) =>

    int existingIdx = na
    int size = array.size(swings)
    
    for [index, existingSwing] in swings
        if existingSwing.barIndex == newSwing.barIndex and existingSwing.type == newSwing.type
            existingIdx := index
            break

    if not na(existingIdx) and size > 0 and existingIdx >= 0 and existingIdx < size
        Swing oldSwing = array.get(swings, existingIdx)
        if not na(oldSwing.lbl)
            label.delete(oldSwing.lbl)
        array.set(swings, existingIdx, newSwing)
    else
        array.push(swings, newSwing)
        if array.size(swings) > maxSwings
            oldest = array.shift(swings)
            if not na(oldest.lbl)
                label.delete(oldest.lbl)
    // array.push(swings, newSwing)
    // if array.size(swings) > maxSwings
    //     array.shift(swings)


   // log.info("" + str.tostring(swings.size()))    

// === Main Logic ===
if barstate.isconfirmed
    // Save new bar
    array.push(bars, createBar())
    if array.size(bars) > maxBars
        array.shift(bars)

    // Detect swings (3-bar pattern)
    if array.size(bars) >= 3
        prevBar = array.get(bars, array.size(bars) - 3)
        midBar  = array.get(bars, array.size(bars) - 2)
        nextBar = array.get(bars, array.size(bars) - 1)
        
        // Swing High
        if isSwingHigh(prevBar.high, midBar.high, nextBar.high)
            swHigh = createSwing(midBar.high, midBar.index, SwingType.SwingHigh)
            addOrReplaceSwing(swHigh, maxSwingsStored)

        // Swing Low
        if isSwingLow(prevBar.low, midBar.low, nextBar.low)
            swLow = createSwing(midBar.low, midBar.index, SwingType.SwingLow)
            addOrReplaceSwing(swLow, maxSwingsStored)

// === Plot Swings ===
if barstate.islast
    total = array.size(swings)
    from = math.max(total - maxSwingLabels, 0)
    for i = from to total - 1
        sw = array.get(swings, i)
        if na(sw.lbl)
            plotSwingLabel(sw)
